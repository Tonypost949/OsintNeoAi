# core/web3/.env.template

# The RPC URL to connect to the Sepolia Testnet (Get a free one from Alchemy or Infura)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# The Private Key of the wallet deploying the contracts (MUST have Sepolia ETH)
# NEVER use a private key associated with real mainnet funds.
PRIVATE_KEY="your_wallet_private_key_without_0x_prefix"

# Optional: Etherscan API key to automatically verify the smart contract code publicly
ETHERSCAN_API_KEY="your_etherscan_api_key"

# Post-Deployment Contract Addresses for Etherscan Verification
STAKING_GATE_ADDRESS=""
MULTI_POOL_ESCROW_ADDRESS=""
OSINT_TOKEN_ADDRESS=""
TFT_TOKEN_ADDRESS=""
USDC_ADDRESS=""
