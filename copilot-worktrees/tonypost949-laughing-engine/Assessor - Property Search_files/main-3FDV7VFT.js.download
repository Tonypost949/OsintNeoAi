    <li>\r
      <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'RealEstateFraud.SearchTitle'|translate}}" routerLink="real-estate-fraud">{{'RealEstateFraud.SearchTitle'|translate}}</a>\r
