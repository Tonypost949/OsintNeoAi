(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(DataSalesGeneralComponent, [{
    type: Component,
    args: [{ selector: "app-DataSalesGeneral", standalone: false, template: `<app-leveltwo [pageName]="'Data Sales'">\r
<div class="General">\r
  <h3>{{'DataSales.SearchTitle'|translate}}</h3>\r
\r
  <h4>{{'DataSales.GeneralSingle'|translate}}</h4>\r
  <!--<p>{{'DataSales.Limitedinformation'|translate}}:</p>-->\r
\r
  <div class="info-bar">\r
    <p class="">{{'PropertySearch.AdditionalInfo' | translate}}</p>\r
    <p><a target="_blank" href="https://portal.assessor.lacounty.gov">{{'PropertySearch.AssessorPortal' | translate}}:</a> {{'PropertySearch.AssessorPortalDescription' | translate}}</p>\r
    <!-- <p><a target="_blank" href="https://maps.assessor.lacounty.gov">{{'PropertySearch.PIAS' | translate}}:</a> {{'PropertySearch.PIASDescription' | translate}}</p> -->\r
    <p><a target="_blank" href="https://propertytax.lacounty.gov">{{'PropertySearch.PropertyTaxPortal' | translate}}:</a> {{'PropertySearch.PropertyTaxPortalDescription' | translate}}</p>\r
\r
  </div>\r
\r
  <p [innerHTML]="'DataSales.Ifyouwould'|translate"></p>\r
\r
  <h4>{{'DataSales.InformationonMulti'|translate}}</h4>\r
  <p>{{'DataSales.TheOfficeof'|translate}}</p>\r
  {{'DataSales.Phone'|translate}} | <b>(213) 974-3363</b><br>\r
  {{'DataSales.Days'|translate}} | {{'DataSales.Monday'|translate}}<br>\r
  {{'DataSales.Hours'|translate}} | 8:00 am - 5:00 pm PST<br>\r
  {{'DataSales.Email'|translate}} | <a href="mailto:datasales@assessor.lacounty.gov">datasales&#64;assessor.lacounty.gov</a><br><br>\r
\r
  <p>{{'DataSales.Whensending'|translate}}</p>\r
\r
  <h4>{{'DataSales.AvailableData'|translate}}</h4>\r
  <p>{{'DataSales.PleaseSelect'|translate}}</p>\r
\r
  <div class="accordion">\r
    <accordion [isAnimated]="true">\r
      <accordion-group #drop>\r
        <div accordion-heading >\r
          <span class="dropdown-item clearfix">\r
            {{'DataSales.Labels'|translate}} <i class="mt-1 float-end" [ngClass]="!drop.isOpen ? 'fas fa-plus' : 'fas fa-minus'"></i>\r
          </span>\r
        </div>\r
        <p>{{'DataSales.Thisitem'|translate}}</p>\r
        <p>{{'DataSales.Itemsrequested'|translate}}</p>\r
        <ul>\r
          <li>{{'DataSales.Ain'|translate}}</li>\r
          <li>{{'DataSales.Ownername'|translate}}</li>\r
          <li>{{'DataSales.Ownermailing'|translate}}</li>\r
        </ul>\r
\r
      </accordion-group>\r
      <!--\r
      <accordion-group #drop2>\r
        <div accordion-heading >\r
          <span class="dropdown-item clearfix">\r
            {{'DataSales.PriceList'|translate}} <i class="mt-1 float-end" [ngClass]="!drop2.isOpen ? 'fas fa-plus' : 'fas fa-minus'"></i>\r
          </span>\r
        </div>\r
\r
\r
      </accordion-group>\r
      -->\r
\r
      <accordion-group #drop3>\r
        <div accordion-heading >\r
          <span class="dropdown-item clearfix">\r
            {{'DataSales.ApartmentBuilding'|translate}} <i class="mt-1 float-end" [ngClass]="!drop3.isOpen ? 'fas fa-plus' : 'fas fa-minus'"></i>\r
          </span>\r
        </div>\r
        <p>{{'DataSales.Thisitemresidential'|translate}}</p>\r
        <h5>{{'DataSales.DataFields'|translate}}</h5>\r
        <ul>\r
