(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(GeneralFormComponent, [{
    type: Component,
    args: [{ selector: "app-generalForm", standalone: false, template: `<div class="container my-4 contactContent" id="">\r
  <h3 class="page-title" *ngIf="!hideAddressHeader">{{'ContactAssessor.TitleGeneral'|translate}}</h3>\r
  <p style="font-style: italic"><strong>{{'ContactAssessor.Number'|translate}} </strong></p>\r
  <hr>\r
    <form [formGroup]="contactForm" (ngSubmit)="submit()">\r
      <p class="form-label">{{'ContactAssessor.Name'|translate}} <span class="color-red">*</span></p>\r
      <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px; margin-bottom: 20px;">\r
        <div class="form-group col-md-6" style="display: flex; flex-direction: column; align-items: center; width: 49%;">\r
\r
          <input type="text" formControlName="firstName" class="form-control" id="inputFirst-General" placeholder="First">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('firstName', 'required')) {\r
              {{'ContactAssessor.Required'|translate}}\r
            }\r
          </div>\r
        </div>\r
        <div class="form-group col-md-6">\r
          <input type="text" formControlName="lastName" class="form-control" id="inputLast-General" placeholder="Last">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('lastName', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
      <div class="form-group">\r
        <p class="form-label">{{ 'ContactAssessor.Email' | translate}} <span class="color-red">*</span></p>\r
        <input type="email" class="form-control" formControlName="email" placeholder="Email">\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('email', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Phone' | translate}}  <span class="color-red">*</span></p>\r
      <div class="form-row">\r
        <div class="form-group col-12">\r
          <input class="form-control"  type="text" appPhoneMask  formControlName="phone" id="inputPhone-General" placeholder="{{'ContactAssessor.Phone' | translate}}" >\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('phone', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Description' | translate}}</p>\r
      <div class="form-group">\r
\r
        <textarea class="form-control" formControlName="description"  id="inputDescription-General" rows="4" placeholder="Type here"></textarea>\r
      </div>\r
      <p class="form-label" style="margin-top: 15px;">{{ 'ContactAssessor.Attachment' | translate}} (PDF or Docx)</p>\r
      <div class="form-group" style="margin-top: 15px;">\r
        <app-file-upload formControlName="file" [progress]="progress"></app-file-upload>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('file', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
          @if (hasError('file', 'requiredFileType')) {\r
            Only PDF, Docx\r
          }\r
          @if (hasError('file', 'requiredFileSize')) {\r
            Size to exceeds 10 MB\r
          }\r
        </div>\r
      </div>\r
      <div class="form-group" style="margin-top: 15px;">\r
        <app-captcha [form]="contactForm" captchaFieldName="recaptchaReactive"></app-captcha>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('recaptchaReactive', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
\r
      <button type="submit" class="btn btn-primary mr-4" style="margin-top: 15px;">Submit</button>@if (success) {\r
      <span>Successfully Submitted</span>\r
    }\r
\r
  </form>\r
\r
</div>\r
` }]
  }], () => [{ type: HttpClient }, { type: UntypedFormBuilder }, { type: ApiService }], { hideAddressHeader: [{
    type: Input
  }] });
})();
