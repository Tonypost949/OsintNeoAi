(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(ChangelogComponent, [{
    type: Component,
    args: [{ selector: "app-changelog", standalone: false, template: `<div id="change-log" class="changelog-container">\r
  <header class="page-header">\r
    <h1 class="page-title">{{ pageTitle }}</h1>\r
  </header>\r
\r
  <main class="release-list">\r
    @for (release of pagedReleases; track release) {\r
      <section class="release-card">\r
        <div class="release-header">\r
          <h2 class="release-version">v{{ release.version }}</h2>\r
          <span class="release-date">{{ release.date | date:'mediumDate' }}</span>\r
        </div>\r
        <ul class="change-list">\r
          @for (changeDescription of release.description; track changeDescription) {\r
            <li>\r
              <p class="change-description">\r
                {{ changeDescription }}\r
              </p>\r
            </li>\r
          }\r
        </ul>\r
      </section>\r
    }\r
  </main>\r
\r
  <div class="changelog-pagination-controls">\r
    <select class="form-select" style="width: auto; display: inline-block; margin-right: 10px;"\r
      [(ngModel)]="pageSize" (ngModelChange)="refreshReleases()">\r
      <option [ngValue]="5">5 items per page</option>\r
      <option [ngValue]="10">10 items per page</option>\r
      <option [ngValue]="20">20 items per page</option>\r
    </select>\r
    <ngb-pagination [collectionSize]="collectionSize"\r
      [(page)]="page"\r
      [pageSize]="pageSize"\r
      (pageChange)="refreshReleases()"\r
      [rotate]="true"\r
      [ellipses]="false"\r
      [boundaryLinks]="true"\r
      [maxSize]="3">\r
    </ngb-pagination>\r
  </div>\r
</div>\r
