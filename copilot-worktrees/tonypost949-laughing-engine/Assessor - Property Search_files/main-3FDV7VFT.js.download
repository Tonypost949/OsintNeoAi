        </div>\r
        <div class="col-md">\r
          <h5 id="NoUpper">{{'ADU.generalJaduv2'|translate}}</h5>\r
          <ul>\r
            <li>{{'ADU.generalJadu1'|translate}}</li>\r
            <li>{{'ADU.generalJadu2'|translate}}</li>\r
            <li>{{'ADU.generalJadu3'|translate}}</li>\r
            <li>{{'ADU.generalJadu4'|translate}}</li>\r
