    type: Component,
    args: [{ selector: "app-contact", standalone: false, template: `<div class="wrapper w-100">\r
  <!-- Sidebar -->\r
\r
  <nav id="sidebar" [ngClass]="status ? 'active' : ''">\r
    <div class="close-button" type="button" id="sidebarCollapse" (click)="status=!status">\r
      @if (status) {\r
        <span><i class="fas fa-angle-right"></i></span>\r
      }\r
\r
      @if (!status) {\r
        <span><i class="fas fa-angle-left"></i></span>\r
      }\r
    </div>\r
    <div class="sidebar-header">\r
      <h3>{{ 'NavMenu.Contact' | translate}}</h3>\r
    </div>\r
\r
    <ul class="list-unstyled components">\r
\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="assessor">{{ 'ContactAssessor.ContactAssessor' | translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="calamity-disaster">{{'NavMenu.DisasterRelief'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="appointment">{{ 'ContactAssessor.Bookingsv2' | translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="district-office">{{ 'ContactAssessor.District' | translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="officelocations">{{ 'ContactAssessor.OfficeLocations' | translate}}</a>\r
