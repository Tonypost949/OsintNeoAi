  <p style="font-style: italic"><strong>{{'ContactAssessor.Number'|translate}} </strong></p>\r
  <p [innerHTML]="'ContactAssessor.ExclusionsDescription' | translate" ></p>\r
  <hr>\r
    <form [formGroup]="contactForm" (ngSubmit)="submit()">\r
      <p class="form-label">{{'ContactAssessor.Name'|translate}} <span class="color-red">*</span></p>\r
      <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px; margin-bottom: 20px;">\r
        <div class="form-group col-md-6" style="display: flex; flex-direction: column; align-items: center; width: 49%;">\r
\r
          <input type="text" formControlName="firstName" class="form-control" id="inputFirst-General" placeholder="{{'ContactAssessor.FirstName' | translate}}">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('firstName', 'required')) {\r
              {{'ContactAssessor.Required'|translate}}\r
            }\r
          </div>\r
        </div>\r
        <div class="form-group col-md-6">\r
          <input type="text" formControlName="lastName" class="form-control" id="inputLast-General" placeholder="{{'ContactAssessor.LastName' | translate}}">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('lastName', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
      <div class="form-group" style="margin-bottom: 20px;">\r
        <p class="form-label">{{ 'ContactAssessor.Email' | translate}} <span class="color-red">*</span></p>\r
        <input type="email" class="form-control" formControlName="email" placeholder="{{'ContactAssessor.Email' | translate}}">\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('email', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
      <p class="form-label">{{ 'ContactAssessor.Phone' | translate}}  <span class="color-red">*</span></p>\r
      <div class="form-row" style="margin-bottom: 20px;">\r
        <div class="form-group col-12">\r
          <input class="form-control"  type="text" appPhoneMask placeholder="{{'ContactAssessor.Phone' | translate}}"  formControlName="phone" id="inputPhone-General"  >\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('phone', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
\r
      <div class="form-group" style="margin-bottom: 20px;">\r
        <p class="form-label" style="margin-bottom: 20px;">AIN ({{ 'ContactAssessor.Ain' | translate}})</p>\r
        <input type="text" class="form-control" appAinMask formControlName="ain" placeholder="XXXX-XXX-XXX">\r
\r
      </div>\r
\r
      <p class="form-label">{{'ContactAssessor.Address'| translate}} <span class="color-red">*</span></p>\r
      <app-certificate-address\r
        [parentFormGroup]="contactForm"\r
        streetNumber="number"\r
        streetDirection="direction"\r
        streetName="street"\r
        streetType="type"\r
        unitNumber="unit"\r
        city="city"\r
        zipCode="zipCode"\r
\r
        >\r
      </app-certificate-address>\r
\r
      <p class="form-label" style="margin-top: 20px;">\r
        {{'ContactAssessor.RadioClaim' | translate}} <span class="color-red">*</span>\r
      </p>\r
      <div class="form-group d-flex align-items-center gap-3">\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="checkStatus" value="Yes" name="checkStatus" type="radio" id="checkStatusYes">\r
          <label class="form-check-label" for="checkStatusYes">Yes</label>\r
        </div>\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="checkStatus" value="No" name="checkStatus" type="radio" id="checkStatusNo">\r
          <label class="form-check-label" for="checkStatusNo">No</label>\r
        </div>\r
      </div>\r
      <div class="invalid-feedback d-block">\r
        @if (hasError('checkStatus', 'required')) {\r
          {{ 'ContactAssessor.Required' | translate}}\r
        }\r
      </div>\r
\r
      <p class="form-label">\r
        {{'ContactAssessor.ParentChildRadio' | translate}} <span class="color-red">*</span>\r
      </p>\r
      <div class="form-group d-flex align-items-center gap-3">\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="parentToChild" value="Yes" name="parentToChild" type="radio" id="parentToChildYes">\r
          <label class="form-check-label" for="parentToChildYes">Yes</label>\r
        </div>\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="parentToChild" value="No" name="parentToChild" type="radio" id="parentToChildNo">\r
          <label class="form-check-label" for="parentToChildNo">No</label>\r
        </div>\r
      </div>\r
      <div class="invalid-feedback d-block">\r
        @if (hasError('parentToChild', 'required')) {\r
          {{ 'ContactAssessor.Required' | translate}}\r
        }\r
      </div>\r
\r
      <p class="form-label">\r
        {{'ContactAssessor.TransferRadio' | translate}} <span class="color-red">*</span>\r
      </p>\r
      <div class="form-group d-flex align-items-center gap-3">\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="over55" value="Yes" name="over55" type="radio" id="over55Yes">\r
          <label class="form-check-label" for="over55Yes">Yes</label>\r
        </div>\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="over55" value="No" name="over55" type="radio" id="over55No">\r
          <label class="form-check-label" for="over55No">No</label>\r
        </div>\r
      </div>\r
      <div class="invalid-feedback d-block">\r
        @if (hasError('over55', 'required')) {\r
          {{ 'ContactAssessor.Required' | translate}}\r
        }\r
      </div>\r
\r
      <p class="form-label">\r
        {{'ContactAssessor.TransferRelated' | translate}} <span class="color-red">*</span>\r
      </p>\r
      <div class="form-group d-flex align-items-center gap-3">\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="naturalDisaster" value="Yes" name="naturalDisaster" type="radio" id="naturalDisasterYes">\r
          <label class="form-check-label" for="naturalDisasterYes">Yes</label>\r
        </div>\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="naturalDisaster" value="No" name="naturalDisaster" type="radio" id="naturalDisasterNo">\r
          <label class="form-check-label" for="naturalDisasterNo">No</label>\r
        </div>\r
      </div>\r
      <div class="invalid-feedback d-block">\r
        @if (hasError('naturalDisaster', 'required')) {\r
          {{ 'ContactAssessor.Required' | translate}}\r
        }\r
      </div>\r
\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Description' | translate}}</p>\r
      <div class="form-group">\r
\r
        <textarea class="form-control" formControlName="description"  id="inputDescription-General" rows="4" placeholder="Type here"></textarea>\r
      </div>\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Attachment' | translate}} (PDF or Docx)</p>\r
      <div class="form-group">\r
        <app-file-upload formControlName="file" [progress]="progress"></app-file-upload>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('file', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
          @if (hasError('file', 'requiredFileType')) {\r
            Only PDF, Docx\r
          }\r
          @if (hasError('file', 'requiredFileSize')) {\r
            Size to exceeds 10 MB\r
          }\r
        </div>\r
      </div>\r
\r
      <div class="form-group" style="margin-top: 15px;">\r
        <app-captcha [form]="contactForm" captchaFieldName="recaptchaReactive"></app-captcha>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('recaptchaReactive', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
\r
      <button type="submit" class="btn btn-primary mr-4" style="margin-top: 15px;">Submit</button>@if (success) {\r
      <span>Successfully Submitted</span>\r
    }\r
\r
  </form>\r
\r
</div>\r
`, styles: ["/* src/app/contact/contactTheAssessor/exclusionsForm/exclusionsForm.component.scss */\n.form-check-label {\n  color: #666666;\n}\n/*# sourceMappingURL=exclusionsForm.component-N5UYW6BA.css.map */\n"] }]
