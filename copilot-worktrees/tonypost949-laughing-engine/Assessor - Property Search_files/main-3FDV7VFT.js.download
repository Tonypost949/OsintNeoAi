(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(SpecificFormComponent, [{
    type: Component,
    args: [{ selector: "app-specificForm", standalone: false, template: `\r
<div class="container my-4 contactContent" id="">\r
  <h3 class="page-title">{{'ContactAssessor.TitleSpecific'|translate}}</h3>\r
  <p style="font-style: italic"><strong>{{'ContactAssessor.Number'|translate}} </strong></p>\r
  <hr>\r
    <form [formGroup]="contactForm" (ngSubmit)="submit()">\r
      <p class="form-label">{{'ContactAssessor.Name'|translate}} <span class="color-red">*</span></p>\r
      <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px; margin-bottom: 20px;">\r
        <div class="form-group col-md-6" style="display: flex; flex-direction: column; align-items: center; width: 49%;">\r
\r
          <input type="text" formControlName="firstName" class="form-control" id="inputFirst-General" placeholder="{{'ContactAssessor.FirstName' | translate}}">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('firstName', 'required')) {\r
              {{'ContactAssessor.Required'|translate}}\r
            }\r
          </div>\r
        </div>\r
        <div class="form-group col-md-6">\r
          <input type="text" formControlName="lastName" class="form-control" id="inputLast-General" placeholder="{{'ContactAssessor.LastName' | translate}}">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('lastName', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
      <div class="form-group" style="margin-bottom: 20px;">\r
        <p class="form-label">{{ 'ContactAssessor.Email' | translate}} <span class="color-red">*</span></p>\r
        <input type="email" class="form-control" formControlName="email" placeholder="{{'ContactAssessor.Email' | translate}}">\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('email', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
      <p class="form-label">{{ 'ContactAssessor.Phone' | translate}}  <span class="color-red">*</span></p>\r
      <div class="form-row" style="margin-bottom: 20px;">\r
        <div class="form-group col-12">\r
          <input class="form-control"  type="text" appPhoneMask placeholder="{{'ContactAssessor.Phone' | translate}}"  formControlName="phone" id="inputPhone-General"  >\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('phone', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
\r
      <div class="form-group" style="margin-bottom: 20px;">\r
        <p class="form-label">AIN ({{ 'ContactAssessor.Ain' | translate}})<!--<span class="color-red">*</span>--></p>\r
        <input type="text" class="form-control" appAinMask formControlName="ain" placeholder="XXXX-XXX-XXX">\r
        <!-- <div class="invalid-feedback" style="display: block">\r
        <ng-container *ngIf="hasError('email', 'required')">{{ 'ContactAssessor.Required' | translate}} </ng-container>\r
      </div> -->\r
    </div>\r
\r
    <p class="form-label">{{'ContactAssessor.Address'| translate}} <span class="color-red">*</span></p>\r
    <app-certificate-address\r
      [parentFormGroup]="contactForm"\r
      streetNumber="number"\r
      streetDirection="direction"\r
      streetName="street"\r
      streetType="type"\r
      unitNumber="unit"\r
      city="city"\r
      zipCode="zipCode"\r
\r
      >\r
    </app-certificate-address>\r
\r
    <p class="form-label" style="margin-top: 20px;">TOPIC OF REQUEST<span class="color-red">*</span></p>\r
    <div [ngClass]="requestValue == 'mailingaddress' ? 'alert-dark alert-trigger' : 'alert-dark'" class="alert  " (click)="changeRequest('mailingaddress')" role="alert">\r
      @if (requestValue == 'mailingaddress') {\r
        <i class="fas fa-check" style="font-size: .9rem;"></i>\r
        } Change of mailing address\r
      </div>\r
      <div [ngClass]="requestValue == 'buildingrecords' ? 'alert-dark alert-trigger' : 'alert-dark'" class="alert  " (click)="changeRequest('buildingrecords')" role="alert">\r
        @if (requestValue == 'buildingrecords') {\r
          <i class="fas fa-check" style="font-size: .9rem;"></i>\r
          } Request my property\u2019s building records\r
        </div>\r
        <div [ngClass]="requestValue == 'propertyowner' ? 'alert-dark alert-trigger' : 'alert-dark'" class="alert  " (click)="changeRequest('propertyowner')" role="alert">\r
          @if (requestValue == 'propertyowner') {\r
            <i class="fas fa-check" style="font-size: .9rem;"></i>\r
            } Property owner's name\r
          </div>\r
          <div [ngClass]="requestValue == 'changedescription' ? 'alert-dark alert-trigger' : 'alert-dark'" class="alert  " (click)="changeRequest('changedescription')" role="alert">\r
            @if (requestValue == 'changedescription') {\r
              <i class="fas fa-check" style="font-size: .9rem;"></i>\r
              } Change to the description of your building or land data on the Assessor's records\r
            </div>\r
            <div [ngClass]="requestValue == 'mandc' ? 'alert-dark alert-trigger' : 'alert-dark'" class="alert  " (click)="changeRequest('mandc')" role="alert">\r
              @if (requestValue == 'mandc') {\r
                <i class="fas fa-check" style="font-size: .9rem;"></i>\r
                } Disaster relief (misfortune and calamity)\r
              </div>\r
              <div [ngClass]="requestValue == 'div' ? 'alert-dark alert-trigger' : 'alert-dark'" class="alert  " (click)="changeRequest('div')" role="alert">\r
                @if (requestValue == 'div') {\r
                  <i class="fas fa-check" style="font-size: .9rem;"></i>\r
                  } Decline-in-Value\r
                </div>\r
                <div [ngClass]="requestValue == 'disagree' ? 'alert-dark alert-trigger' : 'alert-dark'" class="alert  " (click)="changeRequest('disagree')" role="alert">\r
                  @if (requestValue == 'disagree') {\r
                    <i class="fas fa-check" style="font-size: .9rem;"></i>\r
                    } Disagree with recent assessment or valuation change of your property\r
                  </div>\r
                  <div [ngClass]="requestValue == 'other' ? 'alert-dark alert-trigger' : 'alert-dark'" class="alert  " (click)="changeRequest('other')" role="alert">\r
                    @if (requestValue == 'other') {\r
                      <i class="fas fa-check" style="font-size: .9rem;"></i>\r
                      } Other\r
                    </div>\r
\r
                    <div class="invalid-feedback" style="display: block">\r
                      @if (hasError('request', 'required')) {\r
                        {{ 'ContactAssessor.Required' | translate}}\r
                      }\r
                    </div>\r
\r
