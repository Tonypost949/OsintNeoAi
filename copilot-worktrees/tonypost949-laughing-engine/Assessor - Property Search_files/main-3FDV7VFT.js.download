(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(EnotificationProfileComponent, [{
    type: Component,
    args: [{ selector: "app-enotification-profile", standalone: false, template: `<div class="enotification-page" [formGroup]="formGroup">\r
  <h2 style="color: black">My Properties Registered for Opt-in e-Notification</h2>\r
\r
  <p style="color: black">\r
    {{ 'EnotificationProfile.Paragraph1' | translate }}\r
  </p>\r
\r
  <p style="color: black"\r
    [innerHTML]="'EnotificationProfile.Paragraph2' | translate">\r
  </p>\r
\r
  <p style="color: black">\r
    {{ 'EnotificationProfile.Paragraph3' | translate }}\r
  </p>\r
\r
  <div style="display: flex; gap: 10px;">\r
    <div style="display: flex; flex-direction: row; gap: 10px; flex-grow: 1">\r
      <app-form-segment-control\r
        [options]="options"\r
        [selectedOption]="selectedOption"\r
        (segmentControlClicked)="handleSegmentChanged($event)">\r
      </app-form-segment-control>\r
\r
      @switch (selectedOption) {\r
        @case ('Address') {\r
          <input\r
            [formControl]="searchControl"\r
            typeaheadOptionField="SitusStreet"\r
            [typeahead]="parcels"\r
            [typeaheadAsync]="true"\r
            [typeaheadOptionsLimit]="5"\r
            [optionsListTemplate]="customListTemplate"\r
            (typeaheadOnSelect)="handleTypeheadOnSelect($event)"\r
            class="form-control custom-menu"\r
            placeholder="123 Main Street, Los Angeles CA, 90019">\r
          }\r
          @case ('AIN') {\r
            <input\r
              class="form-control custom-menu"\r
              placeholder="001-002-003"\r
              [formControl]="searchControl"\r
              appNumericSplitter\r
              [splitterType]="SplitterType.AIN">\r
            }\r
          }\r
\r
          <button\r
            class="btn btn-primary btn-assessor"\r
            style="white-space: nowrap"\r
            (click)="clickAddAin()">\r
            Add\r
          </button>\r
        </div>\r
      </div>\r
\r
      <app-simple-error-list\r
        [control]="formGroup.get('ain')">\r
      </app-simple-error-list>\r
\r
      <table class="table table-striped">\r
        <thead>\r
          <tr>\r
            <th scope="col">#</th>\r
            <th scope="col">AIN</th>\r
            <th scope="col">Address</th>\r
            <th scope="col" style="text-align: right"></th>\r
          </tr>\r
        </thead>\r
        <tbody>\r
          @for (subscription of subscriptions; track subscription.ain; let i = $index) {\r
            <tr>\r
              <th scope="row">{{ i + 1 }}</th>\r
              <td>{{ subscription.ain }}</td>\r
              <td>{{ subscription.address }}</td>\r
              <td style="text-align: right">\r
                <button\r
                  class="btn btn-primary btn-danger"\r
                  (click)="onDeleteClicked(i)">\r
                  Delete\r
                </button>\r
              </td>\r
            </tr>\r
          }\r
        </tbody>\r
      </table>\r
\r
      <!-- <div class="form-check" style="margin-top: 30px">\r
      <hr />\r
      <input\r
        id="optIn"\r
        formControlName="optIn"\r
        class="form-check-input"\r
        type="checkbox">\r
        <label\r
          class="form-check-label"\r
          for="optIn"\r
          style="color: black">\r
          Opt-In Email Notification\r
        </label>\r
      </div> -->\r
    </div>\r
\r
    <!-- Custom Typeahead List Template -->\r
    <ng-template\r
      #customListTemplate\r
      let-matches="matches"\r
      let-query="query"\r
      let-typeaheadTemplateMethods>\r
\r
      <ul class="custom-list-group">\r
        @for (match of matches; track match) {\r
          <li\r
            class="custom-list-group-item"\r
            [class.active]="typeaheadTemplateMethods.isActive(match)"\r
            (click)="typeaheadTemplateMethods.selectMatch(match, $event)"\r
            (mouseenter)="typeaheadTemplateMethods.selectActive(match)">\r
            {{ match.item.SitusStreet }},\r
            {{ match.item.SitusCity }},\r
            {{ match.item.SitusZipCode }}\r
          </li>\r
        }\r
      </ul>\r
    </ng-template>\r
`, styles: ["/* src/app/enotification-profile/enotification-profile.component.scss */\ninput[type=number]::-webkit-inner-spin-button,\ninput[type=number]::-webkit-outer-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\ninput[type=number] {\n  -moz-appearance: textfield;\n}\n.enotification-page {\n  border: 2px solid lightgray;\n  background: whitesmoke;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  margin-bottom: 20px;\n  margin-top: 20px;\n}\n.custom-list-group {\n  padding-left: 0;\n  list-style-type: none;\n}\n.custom-list-group-item {\n  color: black;\n  padding: 10px;\n}\n.custom-list-group-item:hover {\n  color: white;\n  background-color: #043c5a;\n}\n.typeahead-search {\n  position: relative;\n}\n/*# sourceMappingURL=enotification-profile.component-JLVJJX33.css.map */\n"] }]
  }], () => [{ type: FormBuilder }, { type: ApiService }, { type: ToastrService }], null);
})();
