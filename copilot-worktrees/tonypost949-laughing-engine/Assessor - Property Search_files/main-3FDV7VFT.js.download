(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(ContactCertificateComponent, [{
    type: Component,
    args: [{ selector: "app-contactCertificate", standalone: false, template: `<div class="container my-3 p-3 contactContent General">\r
  <h3 class="page-title">{{ 'ContactCertificate.PageTitle' | translate }}</h3>\r
  <p>{{ 'ContactCertificate.PageDescription' | translate }}</p>\r
  <p><strong>{{ 'ContactCertificate.PleaseConsider' | translate }}</strong></p>\r
\r
  <ul>\r
    <div [innerHTML]="'ContactCertificate.DescriptionList2' | translate"></div>\r
  </ul>\r
\r
  <p>{{ 'ContactCertificate.DescriptionRequest' | translate }}</p>\r
  <p>{{ 'ContactCertificate.DescriptionReviewed' | translate }}</p>\r
  <p>{{ 'ContactCertificate.RequestGiven2' | translate }}</p>\r
  <p [innerHTML]="'ContactCertificate.RequestQuestion' | translate"></p>\r
  <br>\r
    <h5>{{ 'ContactCertificate.TitleRequest' | translate }}</h5>\r
    <hr>\r
      <form [formGroup]="contactForm" (ngSubmit)="submit()">\r
        <div class="row gx-2">\r
          <div class="col-12 col-md-6">\r
            <label for="" class="form-label">{{ 'ContactCertificate.EventDate' | translate }} <span\r
            class="color-red">*</span></label>\r
            <input type="text" formControlName="eventDate" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('eventDate', 'required')) {\r
                {{ 'ContactAssessor.Required' | translate }}\r
              }\r
            </div>\r
          </div>\r
          <div class="col-12 col-md-6">\r
            <label for="" class="form-label">{{ 'ContactCertificate.CertificateDate' | translate }} <span class="color-red">*</span></label>\r
            <input type="text" formControlName="certDate" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('certDate', 'required')) {\r
                {{ 'ContactAssessor.Required' | translate }}\r
              }\r
            </div>\r
          </div>\r
        </div>\r
        <br>\r
          <h5>{{ 'ContactCertificate.TitleHonoree' | translate }}</h5>\r
          <hr>\r
            <p class="form-label">{{ 'ContactAssessor.Name'|translate }} <span class="color-red">*</span></p>\r
            <div class="row gx-2">\r
              <div class="col-12 col-md-6">\r
                <input type="text" formControlName="firstName" class="form-control" id="inputFirst-Speaker" placeholder="First">\r
                <div class="invalid-feedback" style="display: block">\r
                  @if (hasError('firstName', 'required')) {\r
                    {{ 'ContactAssessor.Required'|translate }}\r
                  }\r
                </div>\r
              </div>\r
              <div class="col-12 col-md-6">\r
                <input type="text" formControlName="lastName" class="form-control" id="inputLast-Speaker" placeholder="Last">\r
                <div class="invalid-feedback" style="display: block">\r
                  @if (hasError('lastName', 'required')) {\r
                    {{ 'ContactAssessor.Required' | translate }}\r
                  }\r
                </div>\r
              </div>\r
            </div>\r
            <div class="form-group" style="margin-top: 20px;">\r
              <label for="" class="form-label">{{ 'ContactCertificate.Organization' | translate }}</label>\r
              <input formControlName="organization" type="text" class="form-control">\r
            </div>\r
            <p class="form-label" style="margin-top: 20px;">{{ 'ContactCertificate.Address'| translate }}</p>\r
\r
            <app-certificate-address\r
              [parentFormGroup]="contactForm"\r
              streetNumber="number"\r
              streetDirection="direction"\r
              streetName="street"\r
              streetType="type"\r
              unitNumber="unit"\r
              city="city"\r
              zipCode="zipCode"\r
              >\r
            </app-certificate-address>\r
\r
            <div class="form-group" style="margin-top: 20px;">\r
              <label for="" class="form-label">{{ 'ContactCertificate.EventTitle' | translate }}</label>\r
              <input type="text" formControlName="eventTitle" class="form-control">\r
            </div>\r
            <div class="form-group" style="margin-top: 20px;">\r
              <label for="" class="form-label">{{ 'ContactCertificate.ReasonHonor' | translate }}<span\r
              class="color-red">*</span></label>\r
              <select formControlName="reason" name="" id="reason-honor" class="form-control">\r
                <option value="">Select One</option>\r
                <option>Business Grand Opening / Ribbon Cutting</option>\r
                <option>Anniversary / Milestones</option>\r
                <option>In Memoriam</option>\r
                <option>Retirement</option>\r
                <option>Military Service Recognition</option>\r
                <option>Community Service / Volunteer</option>\r
                <option>Cultural or Heritage Celebration</option>\r
                <option>Event Recognition</option>\r
                <option>Special Accomplishment (Other)</option>\r
\r
              </select>\r
              <div class="invalid-feedback" style="display: block">\r
                @if (hasError('reason', 'required')) {\r
                  {{ 'ContactAssessor.Required' | translate }}\r
                }\r
              </div>\r
            </div>\r
\r
            @if (retire) {\r
              <div>\r
                <div class="form-row" style="margin-top: 20px;">\r
                  <div class="form-group col-md-4">\r
                    <label for="" class="form-label">{{ 'ContactCertificate.StartDate' | translate }}<span\r
                    class="color-red">*</span></label>\r
                    <input type="text" formControlName="startDate" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
                    <div class="invalid-feedback" style="display: block">\r
                      @if (hasError('startDate', 'required')) {\r
                        {{ 'ContactAssessor.Required' | translate }}\r
                      }\r
                    </div>\r
                  </div>\r
                  <div class="form-group col-md-4">\r
                    <label for="" class="form-label">{{ 'ContactCertificate.RetirementDate' | translate }}<span class="color-red">*</span></label>\r
                    <input type="text" formControlName="retirementDate" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
                    <div class="invalid-feedback" style="display: block">\r
                      @if (hasError('retirementDate', 'required')) {\r
                        {{ 'ContactAssessor.Required' | translate }}\r
                      }\r
                    </div>\r
                  </div>\r
                  <div class="form-group col-md-4">\r
                    <label for="" class="form-label">{{ 'ContactCertificate.RequestScrollDate' | translate }}<span\r
                    class="color-red">*</span></label>\r
                    <input type="text" formControlName="scroll" class="form-control">\r
                    <div class="invalid-feedback" style="display: block">\r
                      @if (hasError('scroll', 'required')) {\r
                        {{ 'ContactAssessor.Required' | translate }}\r
                      }\r
                    </div>\r
                  </div>\r
                </div>\r
              </div>\r
            }\r
            @if (memoriam) {\r
              <div>\r
                <div class="form-row" style="margin-top: 20px;">\r
                  <div class="form-group col-md-6">\r
                    <label for="" class="form-label">{{ 'ContactCertificate.DateOfBirth' | translate }}<span\r
                    class="color-red">*</span></label>\r
                    <input type="text" formControlName="birthDate" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
                    <div class="invalid-feedback" style="display: block">\r
                      @if (hasError('birthDate', 'required')) {\r
                        {{ 'ContactAssessor.Required' | translate }}\r
                      }\r
                    </div>\r
                  </div>\r
                  <div class="form-group col-md-6">\r
                    <label for="" class="form-label">{{ 'ContactCertificate.DateOfPassing' | translate }}<span\r
                    class="color-red">*</span></label>\r
                    <input type="text" formControlName="passingDate" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
                    <div class="invalid-feedback" style="display: block">\r
                      @if (hasError('passingDate', 'required')) {\r
                        {{ 'ContactAssessor.Required' | translate }}\r
                      }\r
                    </div>\r
                  </div>\r
                </div>\r
              </div>\r
            }\r
            <br>\r
              <h5>{{ 'ContactCertificate.Requestor' | translate }}</h5>\r
              <hr>\r
                <p class="form-label">{{ 'ContactAssessor.Name'|translate }}</p>\r
                <div class="row gx-2">\r
                  <div class="col-12 col-md-6">\r
                    <input type="text" formControlName="requestorFirstName" class="form-control" id="inputFirst-Requestor"\r
                      placeholder="First">\r
                      <div class="invalid-feedback" style="display: block">\r
                        @if (hasError('requestorFirstName', 'required')) {\r
                          {{ 'ContactAssessor.Required'|translate }}\r
                        }\r
                      </div>\r
                    </div>\r
                    <div class="col-12 col-md-6">\r
                      <input type="text" formControlName="requestorLastName" class="form-control" id="inputLast-Requestor"\r
                        placeholder="Last">\r
                        <div class="invalid-feedback" style="display: block">\r
                          @if (hasError('requestorLastName', 'required')) {\r
                            {{ 'ContactAssessor.Required' | translate }}\r
                          }\r
                        </div>\r
                      </div>\r
                    </div>\r
                    <div class="form-group" style="margin-top: 20px;">\r
                      <label for="" class="form-label">{{ 'ContactCertificate.Organization' | translate }}</label>\r
                      <input type="text" formControlName="requestorOrg" class="form-control">\r
                    </div>\r
                    <div class="row">\r
                      <div class="form-group col-md-6" style="margin-top: 20px;">\r
                        <label for="" class="form-label">{{ 'ContactAssessor.Email' | translate }} <span\r
                        class="color-red">*</span></label>\r
                        <input type="text" class="form-control" formControlName="requestorEmail">\r
                        <div class="invalid-feedback" style="display: block">\r
                          @if (hasError('requestorEmail', 'required')) {\r
                            {{ 'ContactAssessor.Required' | translate }}\r
                          }\r
                        </div>\r
                      </div>\r
                      <div class="form-group col-md-6" style="margin-top: 20px;">\r
                        <label for="" class="form-label">{{ 'ContactAssessor.Phone' | translate }} <span\r
                        class="color-red">*</span></label>\r
                        <input appPhoneMask type="text" class="form-control" formControlName="requestorPhone">\r
                        <div class="invalid-feedback" style="display: block">\r
                          @if (hasError('requestorPhone', 'required')) {\r
                            {{ 'ContactAssessor.Required' | translate }}\r
                          }\r
                        </div>\r
                      </div>\r
                    </div>\r
                    <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Address'| translate }}</p>\r
                    <app-certificate-address\r
                      [parentFormGroup]="contactForm"\r
                      streetNumber="requestorNumber"\r
                      streetDirection="requestorDirection"\r
                      streetName="requestorStreet"\r
                      streetType="requestorType"\r
                      unitNumber="requestorUnit"\r
                      city="requestorCity"\r
                      zipCode="requestorZipCode"\r
                      >\r
                    </app-certificate-address>\r
\r
                    <div class="form-group" style="margin-top: 20px;">\r
                      <app-file-upload formControlName="file" [progress]="progress"></app-file-upload>\r
                      <div class="invalid-feedback" style="display: block">\r
                        @if (hasError('file', 'required')) {\r
                          {{ 'ContactAssessor.Required' | translate }}\r
                        }\r
                        @if (hasError('file', 'requiredFileType')) {\r
                          Only PDF, Docx\r
                        }\r
                        @if (hasError('file', 'requiredFileSize')) {\r
                          Size to exceeds 10 MB\r
                        }\r
                      </div>\r
                    </div>\r
                    <br>\r
                      <h5>{{ 'ContactCertificate.DeliveryInfo' | translate }}</h5>\r
                      <hr>\r
                        <div>\r
                          <label for="" class="form-label">{{ 'ContactCertificate.Method' | translate }} <span\r
                          class="color-red">*</span></label>\r
                          <select formControlName="method" name="" id="" class="form-select">\r
                            <option value="">Select One</option>\r
                            <option>Mail</option>\r
                            <option>Pick-Up</option>\r
                          </select>\r
                          <div class="invalid-feedback" style="display: block">\r
                            @if (hasError('method', 'required')) {\r
                              {{ 'ContactAssessor.Required' | translate }}\r
                            }\r
                          </div>\r
                        </div>\r
                        <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Name'|translate }} <span class="color-red">*</span></p>\r
                        <div class="row gx-2">\r
                          <div class="col-12 col-md-6">\r
                            <input type="text" formControlName="deliveryFirstName" class="form-control" id="inputDeliveryFirst"\r
                              placeholder="First">\r
                              <div class="invalid-feedback" style="display: block">\r
                                @if (hasError('deliveryFirstName', 'required')) {\r
                                  {{ 'ContactAssessor.Required'|translate }}\r
                                }\r
                              </div>\r
                            </div>\r
                            <div class="col-12 col-md-6">\r
                              <input type="text" formControlName="deliveryLastName" class="form-control" id="inputDeliveryLast"\r
                                placeholder="Last">\r
                                <div class="invalid-feedback" style="display: block">\r
                                  @if (hasError('deliveryLastName', 'required')) {\r
                                    {{ 'ContactAssessor.Required' | translate }}\r
                                  }\r
                                </div>\r
                              </div>\r
                            </div>\r
                            <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Address'| translate }}</p>\r
                            <app-certificate-address\r
                              [parentFormGroup]="contactForm"\r
                              streetNumber="deliveryNumber"\r
                              streetDirection="deliveryDirection"\r
                              streetName="deliveryStreet"\r
                              streetType="deliveryType"\r
                              unitNumber="deliveryUnit"\r
                              city="deliveryCity"\r
                              zipCode="deliveryZipCode"\r
                              >\r
                            </app-certificate-address>\r
\r
                            <div class="p-10" style="margin-top: 15px;">\r
                              <app-captcha [form]="contactForm" captchaFieldName="recaptchaReactive"></app-captcha>\r
                              <div class="invalid-feedback" style="display: block">\r
                                @if (hasError('recaptchaReactive', 'required')) {\r
                                  {{ 'ContactAssessor.Required' | translate }}\r
                                }\r
                              </div>\r
                            </div>\r
                            <button type="submit" class="btn btn-primary mr-4" style="margin-top: 10px;">Submit</button>\r
                            @if (success) {\r
                              <span>Successfully Submitted</span>\r
                            }\r
                          </form>\r
                        </div>\r
\r
\r
\r
\r
\r
\r
