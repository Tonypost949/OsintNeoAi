    type: Component,
    args: [{ selector: "app-newsroom", standalone: false, template: '\r\n<tabset>\r\n  <tab heading="Press Releases">\r\n    <div class="General container-fluid">\r\n      <h3>{{"Newsroom.SearchTitle" | translate}}</h3>\r\n      <!-- <h3>{{"Newsroom.Archived" | translate}}</h3> -->\r\n      @if (newsPressRelease) {\r\n        <div class="row NewsItems">\r\n          @for (item of returnNewsPress; track item) {\r\n            <div class="col-md-6 col-lg-4  d-flex alight-items-stretch mb-4">\r\n              <a href="{{item.linkUrl}}" target="_blank" class="card grow">\r\n                <img class="card-img-top" src="{{item.imageUrl}}" alt="Card image cap">\r\n                <div class="card-body">\r\n                  <h5 class="card-title">{{item.title}}</h5>\r\n                  <p class="card-date">{{item.newsDate | date}}</p>\r\n                  <p class="card-text">{{item.description}}</p>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          }\r\n          <div class="w-100">\r\n            <div style="display: flex;\r\n            justify-content: flex-end;\r\n            margin-right: 2em;">\r\n              <pagination [boundaryLinks]="showBoundaryLinks"\r\n                [directionLinks]="showDirectionLinks"\r\n                [totalItems]="newsPressRelease.length"\r\n                [itemsPerPage]="9"\r\n                [maxSize]="5"\r\n              (pageChanged)="pageChangedPress($event)"  previousText="&lsaquo;" nextText="&rsaquo;" firstText="&laquo;" lastText="&raquo;"></pagination>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      }\r\n    </div>\r\n  </tab>\r\n  <tab heading="Press / Media" id="tab1">\r\n    <div class="General container-fluid">\r\n      <h3>{{"Newsroom.SearchTitle" | translate}}</h3>\r\n      @if (newsRecent) {\r\n        <div class="row NewsItems">\r\n          @for (item of returnNewsRecent; track item) {\r\n            <div class="col-md-6 col-lg-4 d-flex alight-items-stretch mb-4">\r\n              <a href="{{item.linkUrl}}" target="_blank" class="card grow">\r\n                <img class="card-img-top" src="{{item.imageUrl}}" alt="Card image cap">\r\n                <div class="card-body">\r\n                  <h5 class="card-title">{{item.title}}</h5>\r\n                  <p class="card-date">{{item.newsDate | date}}</p>\r\n                  <p class="card-text">{{item.description}}</p>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          }\r\n          <div class="w-100">\r\n            <div style="display: flex;\r\n            justify-content: flex-end;\r\n            margin-right: 2em;">\r\n              <pagination\r\n                [boundaryLinks]="showBoundaryLinks"\r\n                [directionLinks]="showDirectionLinks"\r\n                [totalItems]="newsRecent.length"\r\n                [itemsPerPage]="9"\r\n                [maxSize]="5"\r\n              (pageChanged)="pageChanged($event)"  previousText="&lsaquo;" nextText="&rsaquo;" firstText="&laquo;" lastText="&raquo;"></pagination>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      }\r\n    </div>\r\n  </tab>\r\n\r\n  <!--\r\n  <tab heading="SOCIAL MEDIA">\r\n    <div class="General container-fluid">\r\n      <div class="row">\r\n\r\n        <div class="col-md">\r\n          <a class="twitter-timeline"\r\n            href="https://x.com/LACAssessor/"\r\n            data-width="500"\r\n            data-height="500">\r\n\r\n            Tweets by @LACAssessor\r\n          </a>\r\n        </div>\r\n\r\n        <div class="col-md">\r\n\r\n          <div id="fb-root"></div>\r\n          <script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v11.0" nonce="ew5EdivY"><\/script>\r\n\r\n          <div class="fb-page" data-href="https://www.facebook.com/lacassessor" data-tabs="timeline" data-width="500" data-height="500" data-small-header="false" data-adapt-container-width="true" data