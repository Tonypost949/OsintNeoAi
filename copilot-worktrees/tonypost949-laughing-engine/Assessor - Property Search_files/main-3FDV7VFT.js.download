      <p class="form-label">{{ 'ContactAssessor.Phone' | translate}}  <span class="color-red">*</span></p>\r
      <div class="form-row">\r
        <div class="form-group col-12" style="margin-bottom: 20px;">\r
          <input class="form-control"  type="text" appPhoneMask placeholder="{{'ContactAssessor.Phone' | translate}}"  formControlName="phone" id="inputPhone-General"  >\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('phone', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
\r
      <div class="form-group">\r
        <p class="form-label">AIN ({{ 'ContactAssessor.Ain' | translate}})</p>\r
        <input type="text" class="form-control" appAinMask formControlName="ain" placeholder="XXXX-XXX-XXX">\r
\r
      </div>\r
\r
      <p class="form-label"  style="margin-top: 20px;" >{{'ContactAssessor.Address'| translate}} <span class="color-red">*</span></p>\r
      <app-certificate-address\r
        [parentFormGroup]="contactForm"\r
        streetNumber="number"\r
        streetDirection="direction"\r
        streetName="street"\r
        streetType="type"\r
        unitNumber="unit"\r
        city="city"\r
        zipCode="zipCode"\r
\r
        >\r
      </app-certificate-address>\r
\r
\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.TaxInquiry' | translate}} <span class="color-red">*</span></p>\r
      <div class="form-group">\r
        <select formControlName="inquiry"  class="form-select">\r
          <option selected value="">Select..</option>\r
          <option>Homeowners\u2019 Exemption </option>\r
          <option>Veterans\u2019 Exemption </option>\r
          <option>Disabled Veterans</option>\r
          <option>Decline-in-Value </option>\r
          <option>Mills Act </option>\r
          <option>Churches and Religious</option>\r
          <option>Other</option>\r
        </select>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('inquiry', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
\r
      <p class="form-label" style="margin-top: 20px;">\r
        {{'ContactAssessor.StatusRadio' | translate}} <span class="color-red">*</span>\r
      </p>\r
      <div class="form-group d-flex align-items-center gap-3">\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="claimStatus" value="Yes" name="claimStatus" type="radio" id="claimStatusYes">\r
          <label class="form-check-label" for="claimStatusYes">Yes</label>\r
        </div>\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="claimStatus" value="No" name="claimStatus" type="radio" id="claimStatusNo">\r
          <label class="form-check-label" for="claimStatusNo">No</label>\r
        </div>\r
      </div>\r
      <div class="invalid-feedback d-block">\r
        @if (hasError('claimStatus', 'required')) {\r
          {{ 'ContactAssessor.Required' | translate}}\r
        }\r
      </div>\r
\r
\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Description' | translate}}</p>\r
      <div class="form-group">\r
\r
        <textarea class="form-control" formControlName="description"  id="inputDescription-General" rows="4" placeholder="Type here"></textarea>\r
      </div>\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Attachment' | translate}} (PDF or Docx)</p>\r
      <div class="form-group">\r
        <app-file-upload formControlName="file" [progress]="progress"></app-file-upload>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('file', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
          @if (hasError('file', 'requiredFileType')) {\r
            Only PDF, Docx\r
          }\r
          @if (hasError('file', 'requiredFileSize')) {\r
            Size to exceeds 10 MB\r
          }\r
        </div>\r
      </div>\r
\r
\r
      <div class="form-group" style="margin-top: 15px;">\r
        <app-captcha [form]="contactForm" captchaFieldName="recaptchaReactive"></app-captcha>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('recaptchaReactive', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
\r
      <button type="submit" class="btn btn-primary mr-4" style="margin-top: 15px;">Submit</button>@if (success) {\r
      <span>Successfully Submitted</span>\r
    }\r
\r
  </form>\r
\r
</div>\r
` }]
