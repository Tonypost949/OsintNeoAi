    args: [{ selector: "app-accessibility-statement", standalone: false, template: '<div class="container my-4 accessibility-page">\r\n\r\n  <h2 class="page-title">Accessibility</h2>\r\n\r\n  <div class="statement-box">\r\n\r\n    <p>\r\n      The County of Los Angeles strives to ensure that information and services\r\n      provided through our websites is accessible, inclusive and usable for all\r\n      people, including individuals with disabilities.\r\n    </p>\r\n\r\n    <p>\r\n      We endeavor to design and maintain our websites in conformance with recognized\r\n      accessibility standards, including:\r\n    </p>\r\n\r\n    <ul>\r\n      <li>Web Content Accessibility Guidelines (WCAG) 2.1 Level AA</li>\r\n      <li>Title II of the Americans with Disabilities Act (ADA)</li>\r\n    </ul>\r\n\r\n    <p>\r\n      While we strive toward full accessibility compliance, we recognize there is still\r\n      work to be done, and we remain dedicated to ongoing improvements.\r\n    </p>\r\n\r\n    <hr>\r\n\r\n    <h3 class="section-title">Report an ADA Accessibility Issue</h3>\r\n\r\n    <p>\r\n      We are committed to ensuring our website is accessible to all individuals,\r\n      including those with disabilities. If you encounter an accessibility issue\r\n      while using our website, please report it using the form below.\r\n    </p>\r\n\r\n    <h4 class="section-subtitle">How to Report an Issue</h4>\r\n\r\n    <p>To help us resolve the issue efficiently, please include the following:</p>\r\n\r\n    <ul>\r\n      <li><strong>Department:</strong> Specify the department related to the issue</li>\r\n      <li><strong>Description of the Issue:</strong> Include the page or feature affected</li>\r\n      <li><strong>Device & Browser Information:</strong> Desktop/mobile and browser used</li>\r\n      <li><strong>Assistive Technology:</strong> Screen reader or accessibility tool used</li>\r\n    </ul>\r\n\r\n    <div class="email-box">\r\n      Please contact us at:\r\n      <a routerLink="/contact/assessor/7" class="contact-link">\r\n      Website Support\r\n    </a>\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>', styles: ["/* src/app/accessibility-statement/accessibility-statement.component.scss */\n.accessibility-page .page-title {\n  color: #444444;\n  font-weight: 600;\n  margin-bottom: 20px;\n}\n.accessibility-page .statement-box {\n  background: #f5f6f7;\n  border: 1px solid #d9dee3;\n  border-radius: 6px;\n  padding: 30px;\n  line-height: 1.7;\n  color: #666666;\n}\n.accessibility-page .section-title {\n  color: #3165b1;\n  margin-top: 25px;\n  margin-bottom: 15px;\n  font-weight: 600;\n}\n.accessibility-page .section-subtitle {\n  font-weight: 600;\n  margin-top: 15px;\n}\n.accessibility-page ul {\n  margin-left: 20px;\n  margin-bottom: 20px;\n}\n.accessibility-page {\n}\n.accessibility-page .email-box {\n  background: #fff3cd;\n  border: 1px solid #ffe69c;\n  padding: 12px 16px;\n  border-radius: 4px;\n  margin-top: 20px;\n  font-weight: 500;\n}\n.accessibility-page .email-placeholder {\n  background: #f8e79b;\n  padding: 3px 8px;\n  border-radius: 3px;\n  font-family: monospace;\n}\n.accessibility-page .contact-box {\n  background-color: #f8f9fa;\n  padding: 20px;\n  border-left: 5px solid #3165b1;\n  border-radius: 4px;\n}\n.accessibility-page .contact-box .contact-link {\n  display: inline-block;\n  margin-top: 10px;\n  font-weight: 600;\n  text-decoration: underline;\n  color: #3165b1;\n}\n.accessibility-page .contact-box .contact-link:hover {\n  color: #274f8c;\n}\n.accessibility-page .email-box a {\n  color: #3165b1;\n  font-weight: 600;\n}\n/*# sourceMappingURL=accessibility-statement.component-455M6YE4.css.map */\n"] }]
  }], () => [], null);
