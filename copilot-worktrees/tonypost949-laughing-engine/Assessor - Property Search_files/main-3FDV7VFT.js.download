    type: Component,
    args: [{ selector: "app-News-Information", standalone: false, template: `<div class="wrapper w-100">\r
  <!-- Sidebar -->\r
\r
  <nav id="sidebar" [ngClass]="status ? 'active' : ''">\r
    <div class="close-button" type="button" id="sidebarCollapse" (click)="status=!status">\r
      @if (status) {\r
        <span><i class="fas fa-angle-right"></i></span>\r
      }\r
\r
      @if (!status) {\r
        <span><i class="fas fa-angle-left"></i></span>\r
      }\r
    </div>\r
    <div class="sidebar-header">\r
      <h3>{{'NavMenu.NewsInfo'|translate}}</h3>\r
    </div>\r
\r
    <ul class="list-unstyled components">\r
\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="newsroom">{{'NavMenu.Newsroom'|translate}}</a>\r
      </li>\r
      <li>\r
        <a  [innerHTML]="'Newsletters'|translate" routerLinkActive="active-tab" (click)="status=!status" routerLink="newsletters"></a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="enotification">{{'Homeowner Alert Service'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="events">{{'NavMenu.Events'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="webinars-presentations">{{'NavMenu.Webinars'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="annualroll">{{'NavMenu.AnnualReport'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="assessmentroll">{{'NavMenu.AssessmentRoll'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="awards">{{'NavMenu.Awards'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" routerLink="careers">{{'NavMenu.Careers'|translate}}</a>\r
      </li>\r
      <!-- <li>\r
      <a routerLinkActive="active-tab" (click)="status=!status" routerLink="publicrecord">{{'PublicRecords.SearchTitle'|translate}}</a>\r
    </li> -->\r
\r
\r
  </ul>\r
\r
</nav>\r
<div id="content">\r
\r
