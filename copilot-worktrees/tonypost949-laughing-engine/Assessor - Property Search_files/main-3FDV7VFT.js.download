    type: Component,
    args: [{ selector: "app-adu", standalone: false, template: `<app-leveltwo [videos]="true" [pageName]="'ADUs'">\r
    <div heading="General Info" class="General">\r
      <h3>{{'ADU.PageTitlev2'|translate}}</h3>\r
\r
      <p>{{'ADU.anaccessoryv2'|translate}}</p>\r
      <ul>\r
        <li><p>{{'ADU.accessoryitem1'|translate}}</p></li>\r
        <li><p>{{'ADU.accessoryitem2'|translate}}</p></li>\r
        <li><p>{{'ADU.accessoryitem3'|translate}}</p></li>\r
