// src/app/forms/file-online-v2/validators/RequiredTrueValidator.ts
function requiredCheckboxValidator() {
  return (control) => {
    if (!control.value) {
      return { requiredCheckbox: true };
    }
    return null;
  };
}

// src/app/forms/file-online-v2/components/controls/CustomFormGroup.ts
var CustomFormGroup = class extends UntypedFormGroup {
  constructor(controls, customFormControls, validatorOrOpts, asyncValidator) {
    super(controls, validatorOrOpts, asyncValidator);
    this.customFormControls = customFormControls;
  }
};

// src/app/forms/file-online-v2/validators/AtLeastOneCheckboxValidator.ts
function atLeastOneCheckboxValidator(validation, controls) {
  return (_) => {
    for (const checkbox of validation.controls) {
      const targetControl = controls.get(checkbox);
      if (targetControl && targetControl.value === true) {
        return null;
      }
    }
    return { noCheckboxesSelected: validation.customErrorMessage };
  };
}

// src/app/forms/file-online-v2/validators/RegexValidator.ts
function regexValidator(nameRe) {
  return (control) => {
    const regex = new RegExp(nameRe);
    const matches = regex.test(control.value);
    return matches ? null : { regexValidator: { value: control.value } };
  };
}

// src/app/forms/file-online-v2/validators/SsnValidator.ts
function ssnValidator() {
  return (control) => {
    const filtered = control.value.replace(/\D/g, "");
    return filtered.length === 9 ? null : { invalidSsn: true };
  };
}

// src/app/forms/file-online-v2/validators/ZipValidator.ts
function zipCodeValidator() {
  return (control) => {
    if (!control.value) {
      return { invalidZip: true };
    }
    const filtered = control.value.replace(/\D/g, "");
    return filtered.length === 5 || filtered.length === 9 ? null : { invalidZip: true };
  };
}

// src/app/forms/file-online-v2/validators/UniqueArrayFieldValidator.ts
function uniqueArrayFieldValidator(targetField) {
  return (control) => {
    if (!(control instanceof UntypedFormArray)) {
      return null;
    }
    const formArray = control;
    const set = /* @__PURE__ */ new Set();
    for (const arrayControl of formArray.controls) {
      if (!(arrayControl instanceof UntypedFormGroup)) {
        continue;
      }
      set.add(arrayControl.controls[targetField].value);
    }
    return set.size === formArray.length ? null : { nonUnique: `Each ${targetField.replace("#{i}", "")} value must be unique` };
  };
}

// src/app/forms/file-online-v2/validators/NoCountyEmailValidator.ts
function noCountyEmailValidator() {
  return (control) => {
    const countyEmailPattern = /lacounty\.gov/i;
    return countyEmailPattern.test(control.value) ? { noCountyEmail: "LA County emails are forbidden" } : null;
  };
}

// src/app/forms/file-online-v2/validators/SignixEmailLimitValidator.ts
function signixEmailLimitValidator() {
  return (control) => {
    return control.value.length <= 50 ? null : { signixEmailTooLong: true };
  };
}

// src/app/forms/file-online-v2/validators/MinimumTemplateCountValidator.ts
function minimumTemplateCountValidator(minimum) {
  return (control) => {
    if (!(control instanceof UntypedFormArray)) {
      return;
    }
    const formArray = control;
    return formArray.length < minimum ? { minimumElementNeeded: `You must add at least ${minimum} item(s)` } : null;
  };
}

// src/app/forms/file-online-v2/validators/AlphanumericValidator.ts
function alphanumericValidator() {
  return (control) => {
    const value = control.value;
    if (value && !/^[a-zA-Z0-9]*$/.test(value)) {
      return { alphanumeric: true };
    }
    return null;
  };
}

// src/app/forms/file-online-v2/validators/EqualityValidator.ts
function equalityValidator(validation, controls) {
  return (control) => {
    const targetControl = controls.get(validation.targetControlId);
    if (!targetControl) {
      return;
    }
    const areEqual = targetControl.value.toLowerCase() === control.value.toLowerCase();
    if (validation.successIf === "equal") {
      return areEqual ? null : { inequality: validation.customErrorMessage };
    }
    return validation.successIf === "notEqual" && !areEqual ? null : { inequality: validation.customErrorMessage };
  };
}

// src/app/forms/file-online-v2/validators/AsyncPersonalPropertyValidator.ts
function asyncPersonalPropertyValidator(apiService) {
  return (control) => {
    if (!(control instanceof CustomFormControl)) {
      return;
    }
    const assessment = control.value.replace(/-/g, "").toUpperCase();
    return apiService.getAssessmentType(assessment).pipe(map((assessmentType) => {
      control.markAsTouched({ onlySelf: true });
      if (assessmentType.propertyType === null) {
        return { invalidAin: true };
      }
      if (assessmentType.propertyType === "RP" || assessmentType.propertyType === "CR") {
        return { notPersonalPropertyIsRealProperty: true };
      }
      return null;
    }), catchError((error) => {
      console.error(error);
      control.markAsTouched({ onlySelf: true });
      return of({ invalidAin: true });
    }));
  };
}

