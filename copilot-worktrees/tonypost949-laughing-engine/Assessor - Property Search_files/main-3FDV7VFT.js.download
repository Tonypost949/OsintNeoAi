                        {{ "Prop19.Prop58prop193" | translate }}\r
                        {{ "Prop19.alsoallowed" | translate }}\r
                      </p>\r
\r
                      <b>{{ "Prop19.underprop19v2" | translate }}</b>\r
                      <br><br>\r
                      <ol>\r
                        <li>{{ "Prop19.condition1" | translate }}</li>\r
                        <!-- <li>{{ "Prop19.condition2v3pt1" | translate }} <a *ngIf="!toggle" [routerLink]="['../homeowner-exemption']">{{ "Prop19.condition2v3pt2" | translate }}</a> <a *ngIf="toggle" [routerLink]="['../apply-for-hox']">{{ "Prop19.condition2v3pt2" | translate }}</a> {{ "Prop19.condition2v3pt3" | translate }}</li> -->\r
                        <li>{{ "Prop19.condition2v3pt1" | translate }} @if (toggle) {\r
                          <a [routerLink]="['../apply-for-hox']">{{ "Prop19.condition2v3pt2" | translate }}</a>\r
                          } @if (!toggle) {\r
                          <a href="https://assessor.lacounty.gov/exemptions/homeowner-exemption">{{ "Prop19.condition2v3pt2" | translate }}</a>\r
                        } {{ "Prop19.condition2v3pt3" | translate }}</li>\r
                        <li>{{ "Prop19.condition3" | translate }}</li>\r
                      </ol>\r
                      <p>\r
                        <b>{{ "Prop19.theprovisions" | translate }}</b>\r
                      </p>\r
\r
                      <h4>{{ "Prop19.Senior" | translate }}</h4>\r
                      <p [innerHTML]=" 'Prop19.Proposition60' | translate ">\r
                        <!--\r
                        <a\r
                          href="https://www.boe.ca.gov/proptaxes/prop60-90_55over.htm"\r
                          target="_blank"\r
                          >{{ "Prop19.Proposition60" | translate }}</a\r
                          >{{ "Prop19.and" | translate\r
                          }}<a\r
                          href="https://www.boe.ca.gov/proptaxes/faqs/propositions110.htm#:~:text=Proposition%20110%20is%20a%20constitutional,and%20buy%20or%20build%20another."\r
                          target="_blank"\r
                        >110</a>\r
                        {{ "Prop19.allowedpersons" | translate }}-->\r
                      </p>\r
                      <p>\r
                        <i>{{ "Prop19.subjectto" | translate }}</i>\r
                      </p>\r
\r
                      <p>\r
                        <b>{{ "Prop19.theeffective" | translate }}</b>\r
                      </p>\r
\r
                      <h4>{{ "Prop19.DisasterRelief" | translate }}</h4>\r
                      <p>\r
                        <a\r
                          href="https://www.boe.ca.gov/proptaxes/disaster-relief.htm#Description"\r
                          target="_blank"\r
                          >{{ "Prop19.Prop50" | translate }}</a\r
                          >\r
                          {{ "Prop19.provided" | translate }}\r
                        </p>\r
\r
                        <p>\r
                          <b>{{ "Prop19.theeffective" | translate }}</b>\r
                        </p>\r
                      </div>\r
                      <div class="Calculator">\r
                        <div id="parent-child">\r
                          <div class="calculator-top">\r
                            <h5>{{ "Prop19.ParentChildCalculator" | translate }}</h5>\r
                            <p [innerHTML]="'Prop19.ParentCalculatorDescription' | translate"></p>\r
                            <button\r
                              (click)="parentSelector = true; calc1Values = null"\r
                              type="button"\r
                              class="btn btn-ain"\r
                              [ngClass]="parentSelector ? 'btn-active' : ''"\r
                              >\r
                              AIN <i class="fas fa-chevron-down"></i>\r
                            </button>\r
                            <button\r
                              (click)="parentSelector = false; calc1Values = null"\r
                              type="button"\r
                              class="btn btn-address"\r
                              [ngClass]="parentSelector ? '' : 'btn-active'"\r
                              >\r
                              ADDRESS <i class="fas fa-chevron-down"></i>\r
                            </button>\r
                          </div>\r
                          <div class="calculator-bottom">\r
                            @if (parentSelector) {\r
                              <div class="select-ain animate slideIn">\r
                                <h5>AIN ({{ "ContactAssessor.Ain" | translate }})</h5>\r
                                <form #myForm="ngForm" (ngSubmit)="submitAin()">\r
                                  <div class="form-inline" style="display: flex; align-items: center;">\r
                                    <input\r
                                      class="form-control"\r
                                      type="text"\r
                                      [(ngModel)]="ain"\r
                                      name="ain"\r
                                      appAinMask\r
                                      placeholder="XXXX-XXX-XXX"\r
                                      />\r
                                      <button type="submit" class="btn btn-active" style="margin-left: 8px;">SEARCH</button>\r
                                    </div>\r
                                  </form>\r
                                </div>\r
                              }\r
                              @if (!parentSelector) {\r
                                <div class="select-address animate slideIn">\r
                                  <app-ainAddress (AddressList)="getAddress($event)"></app-ainAddress>\r
                                </div>\r
                              }\r
                              @if (calc1Values) {\r
                                <div class="parent-calculator animate slideIn">\r
                                  <hr />\r
                                  <div class="form-group" style="margin-bottom: 30px;">\r
                                    <label for="">Enter Fair Market Value</label>\r
                                    <input\r
                                      id="MarketValueParent"\r
                                      currencyMask\r
                                      [(ngModel)]="calc1Values.fairMarketValue"\r
                                      [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                      class="form-control"\r
                                      />\r
                                    </div>\r
                                    @if (calc1Values.fairMarketValue != 0) {\r
                                      <div\r
                                        class="upper animate slideIn"\r
                                        >\r
                                        <label style="margin: 10px 0px 10px 0px;"\r
                                          >1. {{ "Prop19.CalcTaxSum" | translate }}\r
                                          {{ calc1Values.millionDollarExclusion }}</label\r
                                          >\r
                                          <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px;">\r
                                            <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                              <input\r
                                                currencyMask\r
                                                [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                [(ngModel)]="calc1Values.taxableValue"\r
                                                class="form-control"\r
                                                disabled\r
                                                style="width: 100%; height: 40px; text-align: center;"\r
                                                />\r
                                                <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">TAXABLE VALUE</p>\r
                                              </div>\r
                                              <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                <p><i class="fas fa-plus"></i></p>\r
                                              </div>\r
                                              <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                <input\r
                                                  currencyMask\r
                                                  [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                  [(ngModel)]="calc1Values.millionDollarExclusion"\r
                                                  class="form-control"\r
                                                  disabled\r
                                                  style="width: 100%; height: 40px; text-align: center;"\r
                                                  />\r
                                                  <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">EXCLUSION ADJUSTED ANNUALLY</p>\r
                                                </div>\r
                                                <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                  <p><i class="fas fa-equals"></i></p>\r
                                                </div>\r
                                                <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                  <input\r
                                                    currencyMask\r
                                                    [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                    [ngModel]="calc1Values.millionDollarExclusion + calc1Values.taxableValue"\r
                                                    class="form-control"\r
                                                    disabled\r
                                                    style="width: 100%; height: 40px; text-align: center;"\r
                                                    />\r
                                                    <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">SUM</p>\r
                                                  </div>\r
                                                </div>\r
                                                <label style="margin: 20px 0px 10px 0px;"\r
                                                  >2. {{ "Prop19.CalcTaxSum" | translate }}\r
                                                  {{ calc1Values.millionDollarExclusion }}</label\r
                                                  >\r
                                                  <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px;">\r
                                                    <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                      <input\r
                                                        currencyMask\r
                                                        [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                        [ngModel]="calc1Values.fairMarketValue"\r
                                                        class="form-control border-blue"\r
                                                        disabled\r
                                                        style="width: 100%; height: 40px; text-align: center;"\r
                                                        />\r
                                                        <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">FAIR MARKET VALUE</p>\r
                                                      </div>\r
                                                      @if (checkValue()) {\r
                                                        <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                          <p><i class="fas fa-less-than-equal"></i></p>\r
                                                        </div>\r
                                                      }\r
                                                      @if (!checkValue()) {\r
                                                        <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                          <p><i class="fas fa-greater-than"></i></p>\r
                                                        </div>\r
                                                      }\r
                                                      <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                        <input\r
                                                          currencyMask\r
                                                          [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                          [ngModel]="calc1Values.millionDollarExclusion + calc1Values.taxableValue"\r
                                                          class="form-control"\r
                                                          disabled\r
                                                          style="width: 100%; height: 40px; text-align: center;"\r
                                                          />\r
                                                          <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">EXCLUSION ADJUSTED ANNUALLY</p>\r
                                                        </div>\r
                                                      </div>\r
                                                      @if (checkValue()) {\r
                                                        <div>\r
                                                          <p\r
                                                            style="text-align: left; color: blue"\r
                                                            [innerHTML]="'Prop19.FmvAlertNo' | translate"\r
                                                          ></p>\r
                                                          <label style="margin: 20px 0px 10px 0px;">3. {{ "Prop19.Retained" | translate }}</label>\r
                                                          <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px;">\r
                                                            <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                              <input\r
                                                                currencyMask\r
                                                                [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                [ngModel]="calc1Values.taxableValue"\r
                                                                class="form-control border-green"\r
                                                                disabled\r
                                                                style="width: 100%; height: 40px; text-align: center;"\r
                                                                />\r
                                                                <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">TAXABLE VALUE</p>\r
                                                              </div>\r
                                                            </div>\r
                                                          </div>\r
                                                        }\r
                                                        @if (!checkValue()) {\r
                                                          <div>\r
                                                            <p\r
                                                              style="text-align: left; color: blue"\r
                                                              [innerHTML]="'Prop19.FmvAlertYes' | translate"\r
                                                            ></p>\r
                                                            <label style="margin: 20px 0px 10px 0px;">3. {{ "Prop19.Difference" | translate }}</label>\r
                                                            <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px;">\r
                                                              <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                <input\r
                                                                  currencyMask\r
                                                                  [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                  [ngModel]="calc1Values.fairMarketValue"\r
                                                                  class="form-control"\r
                                                                  disabled\r
                                                                  style="width: 100%; height: 40px; text-align: center;"\r
                                                                  />\r
                                                                  <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">FAIR MARKET VALUE</p>\r
                                                                </div>\r
                                                                <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                                  <p><i class="fas fa-minus"></i></p>\r
                                                                </div>\r
                                                                <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                  <input\r
                                                                    currencyMask\r
                                                                    [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                    [ngModel]="calc1Values.millionDollarExclusion + calc1Values.taxableValue"\r
                                                                    class="form-control"\r
                                                                    disabled\r
                                                                    style="width: 100%; height: 40px; text-align: center;"\r
                                                                    />\r
                                                                    <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">SUM</p>\r
                                                                  </div>\r
                                                                  <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                                    <p><i class="fas fa-equals"></i></p>\r
                                                                  </div>\r
                                                                  <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                    <input\r
                                                                      currencyMask\r
                                                                      [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                      [ngModel]="calc1Values.fairMarketValue - (calc1Values.millionDollarExclusion + calc1Values.taxableValue)"\r
                                                                      class="form-control"\r
                                                                      disabled\r
                                                                      style="width: 100%; height: 40px; text-align: center;"\r
                                                                      />\r
                                                                      <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">DIFFERENCE</p>\r
                                                                    </div>\r
                                                                  </div>\r
                                                                  <label style="margin: 20px 0px 10px 0px;">3. {{ "Prop19.Add" | translate }}</label>\r
                                                                  <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px;">\r
                                                                    <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                      <input\r
                                                                        currencyMask\r
                                                                        [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                        [ngModel]="calc1Values.fairMarketValue - (calc1Values.millionDollarExclusion + calc1Values.taxableValue)"\r
                                                                        class="form-control"\r
                                                                        disabled\r
                                                                        style="width: 100%; height: 40px; text-align: center;"\r
                                                                        />\r
                                                                        <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">DIFFERENCE</p>\r
                                                                      </div>\r
                                                                      <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                                        <p><i class="fas fa-plus"></i></p>\r
                                                                      </div>\r
                                                                      <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                        <input\r
                                                                          currencyMask\r
                                                                          [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                          [ngModel]="calc1Values.taxableValue"\r
                                                                          class="form-control"\r
                                                                          disabled\r
                                                                          style="width: 100%; height: 40px; text-align: center;"\r
                                                                          />\r
                                                                          <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">TAXABLE VALUE</p>\r
                                                                        </div>\r
                                                                        <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                                          <p><i class="fas fa-equals"></i></p>\r
                                                                        </div>\r
                                                                        <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                          <input\r
                                                                            currencyMask\r
                                                                            [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                            [ngModel]="calc1Values.fairMarketValue - (calc1Values.millionDollarExclusion + calc1Values.taxableValue) + calc1Values.taxableValue"\r
                                                                            class="form-control border-green"\r
                                                                            disabled\r
                                                                            style="width: 100%; height: 40px; text-align: center;"\r
                                                                            />\r
                                                                            <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">FINAL VALUE</p>\r
                                                                          </div>\r
                                                                        </div>\r
                                                                      </div>\r
                                                                    }\r
                                                                  </div>\r
                                                                }\r
                                                                <button class="btn" style="margin-top: 10px;" (click)="calc1Values = null">Clear</button>\r
                                                              </div>\r
                                                            }\r
                                                          </div>\r
                                                        </div>\r
                                                        <div id="base-year">\r
                                                          <div class="calculator-top">\r
                                                            <h5>{{ "Prop19.BaseYearCalculator" | translate }}</h5>\r
                                                            <p [innerHTML]="'Prop19.BaseYearDescription' | translate"></p>\r
                                                            <button\r
                                                              (click)="baseYearSelector = true; calc2Values = null"\r
                                                              type="button"\r
                                                              class="btn btn-ain"\r
                                                              [ngClass]="baseYearSelector ? 'btn-active' : ''"\r
                                                              >\r
                                                              AIN <i class="fas fa-chevron-down"></i>\r
                                                            </button>\r
                                                            <button\r
                                                              (click)="baseYearSelector = false; calc2Values = null"\r
                                                              type="button"\r
                                                              class="btn btn-address"\r
                                                              [ngClass]="baseYearSelector ? '' : 'btn-active'"\r
                                                              >\r
                                                              ADDRESS <i class="fas fa-chevron-down"></i>\r
                                                            </button>\r
                                                          </div>\r
                                                          <div class="calculator-bottom">\r
                                                            @if (baseYearSelector) {\r
                                                              <div class="select-ain animate slideIn">\r
                                                                <h5>AIN ({{ "ContactAssessor.Ain" | translate }})</h5>\r
                                                                <form #ainF="ngForm" (ngSubmit)="submitAin('base')">\r
                                                                  <div class="form-inline" style="display: flex; align-items: center;">\r
                                                                    <input\r
                                                                      class="form-control"\r
                                                                      type="text"\r
                                                                      [(ngModel)]="ain"\r
                                                                      name="ain"\r
                                                                      appAinMask\r
                                                                      placeholder="XXXX-XXX-XXX"\r
                                                                      />\r
                                                                      <button type="submit" class="btn btn-active" style="margin-left: 8px;">SEARCH</button>\r
                                                                    </div>\r
                                                                  </form>\r
                                                                </div>\r
                                                              }\r
                                                              @if (!baseYearSelector) {\r
                                                                <div class="select-address animate slideIn">\r
                                                                  <app-ainAddress\r
                                                                    (AddressList)="getAddress($event, 'base')"\r
                                                                  ></app-ainAddress>\r
                                                                </div>\r
                                                              }\r
                                                              @if (calc2Values) {\r
                                                                <div class="parent-calculator animate slideIn">\r
                                                                  <hr />\r
                                                                  <div class="form-group">\r
                                                                    <label for=""\r
                                                                      >Enter Fair Market Value of Original Principal Residence</label\r
                                                                      >\r
                                                                      <input\r
                                                                        id="MarketValueBaseYear"\r
                                                                        currencyMask\r
                                                                        [(ngModel)]="calc2Values.fairMarketValue"\r
                                                                        [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                        class="form-control"\r
                                                                        />\r
                                                                      </div>\r
                                                                      <div class="form-group">\r
                                                                        <label for=""\r
                                                                          >Enter Fair Market Value of Replacement Principal Residence</label\r
                                                                          >\r
                                                                          <input\r
                                                                            currencyMask\r
                                                                            [(ngModel)]="calc2Values.fairMarketValueReplacement"\r
                                                                            [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                            class="form-control"\r
                                                                            />\r
                                                                          </div>\r
                                                                          @if (\r
                                                                            calc2Values.fairMarketValue > 0 &&\r
                                                                            calc2Values.fairMarketValueReplacement > 0\r
                                                                            ) {\r
                                                                            <div\r
                                                                              class="upper animate slideIn"\r
                                                                              >\r
                                                                              @if (checkParentValue()) {\r
                                                                                <div>\r
                                                                                  <label style="margin: 20px 0px 10px 0px;">3. {{ "Prop19.FmvDifference" | translate }}</label>\r
                                                                                  <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px;">\r
                                                                                    <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                                      <input\r
                                                                                        currencyMask\r
                                                                                        [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                                        [ngModel]="calc2Values.fairMarketValueReplacement"\r
                                                                                        class="form-control border-blue"\r
                                                                                        disabled\r
                                                                                        style="width: 100%; height: 40px; text-align: center;"\r
                                                                                        />\r
                                                                                        <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">FMV Replacement Property</p>\r
                                                                                      </div>\r
                                                                                      <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                                                        <p><i class="fas fa-minus"></i></p>\r
                                                                                      </div>\r
                                                                                      <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                                        <input\r
                                                                                          currencyMask\r
                                                                                          [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                                          [ngModel]="calc2Values.fairMarketValue"\r
                                                                                          class="form-control border-blue"\r
                                                                                          disabled\r
                                                                                          style="width: 100%; height: 40px; text-align: center;"\r
                                                                                          />\r
                                                                                          <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">FMV Original Property</p>\r
                                                                                        </div>\r
                                                                                        <div class="col-md-1 text-center" style="display: flex; flex-direction: column; justify-content: center; width: 40px;">\r
                                                                                          <p><i class="fas fa-equals"></i></p>\r
                                                                                        </div>\r
                                                                                        <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                                          <input\r
                                                                                            currencyMask\r
                                                                                            [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                                            [ngModel]="calc2Values.fairMarketValueReplacement - calc2Values.fairMarketValue"\r
                                                                                            class="form-control"\r
                                                                                            disabled\r
                                                                                            style="width: 100%; height: 40px; text-align: center;"\r
                                                                                            />\r
                                                                                            <p class="text-center" style="min-height: 40px; text-align: center; white-space: nowrap;">Positive DIFFERENCE</p>\r
                                                                                          </div>\r
                                                                                        </div>\r
                                                                                        <label style="margin: 20px 0px 10px 0px;">3. {{ "Prop19.FmvAdd" | translate }}</label>\r
                                                                                        <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px;">\r
                                                                                          <div class="col-md-3 form-group" style="display: flex; flex-direction: column; align-items: center; width: 25%;">\r
                                                                                            <input\r
                                                                                              currencyMask\r
                                                                                              [options]="{ align: 'left', prefix: '$', precision: 0 }"\r
                                                                                              [ngModel]="calc2Values.fairMarketValueReplacement - calc2Values.fairMarketValue"\r
                                                                                              class="form-control"\r
                                                                                              disabled\r
                                                                                              style="width: 100%; height: 40px; text-align: center;"\r
                                                                                              />\r
