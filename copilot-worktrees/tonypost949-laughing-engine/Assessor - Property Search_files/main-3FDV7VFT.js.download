(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(Ads820Component, [{
    type: Component,
    args: [{ selector: "app-ads820", standalone: false, template: `<div id="formTop" style="margin: 20px" [formGroup]="formGroup" class="efile-page">\r
  @if (siteConfig.getMncMaintenanceMessage()) {\r
    <app-banner\r
      type="error"\r
      [header]="'Maintenance Mode'"\r
      [message]="siteConfig.getMncMaintenanceMessage() ?? 'Maintenance Mode'">\r
    </app-banner>\r
  } @else {\r
    <div style="display: flex; flex-direction: column; gap: 10px">\r
\r
      <!-- Titles -->\r
      <h1>{{ 'ADS-820.Title' | translate }}</h1>\r
      <h5>{{ 'ADS-820.Subtitle' | translate }}</h5>\r
\r
      <!-- Description Paragraphs (using [innerHTML] to preserve bold & links) -->\r
      <p style="margin-bottom: 0" [innerHTML]="'ADS-820.Description1' | translate"></p>\r
      <p style="margin-bottom: 0" [innerHTML]="'ADS-820.Description2' | translate"></p>\r
      <p style="margin-bottom: 0" [innerHTML]="'ADS-820.Description3' | translate"></p>\r
      <hr>\r
\r
        <!-- Damaged Property Information Section -->\r
        <h4>{{ 'ADS-820.DamagedPropertyInfo' | translate }}</h4>\r
        <div style="display: flex; flex-direction: column; gap: 10px">\r
\r
          <!-- Damaged Property Address Search -->\r
          <div style="display: flex; flex-direction: row; gap: 10px; flex-grow: 1">\r
            <div class="input-group">\r
              <span class="input-group-text" style="background: lightgray">\r
                <i class="fas fa-search"></i>\r
              </span>\r
              <input\r
                id="parcel-address-search"\r
                [formControl]="searchField"\r
                typeaheadOptionField="SitusStreet"\r
                [typeahead]="parcels"\r
                [typeaheadAsync]="true"\r
                [typeaheadOptionsLimit]="5"\r
                [optionsListTemplate]="customListTemplate"\r
                (typeaheadOnSelect)="handleTypeheadOnSelect($event)"\r
                class="form-control custom-menu"\r
                [placeholder]="'ADS-820.SitusStreetPlaceholder' | translate"\r
                />\r
              </div>\r
\r
              <button\r
                class="btn btn-primary btn-assessor"\r
                style="white-space: nowrap"\r
                (click)="onClickUseAddress()"\r
                [ngbTooltip]="useAddressToolTip">\r
                {{ 'ADS-820.UseAddressButton' | translate }}\r
              </button>\r
            </div>\r
\r
            <!-- Damaged Property Street Address -->\r
            <div>\r
              <app-input-label\r
                controlId="damaged_property_street_address"\r
                [controlLabel]="'ADS-820.DamagedPropertyStreetAddress' | translate"\r
                required="true">\r
              </app-input-label>\r
              <input\r
                id="damaged_property_street_address"\r
                type="text"\r
                class="form-control"\r
                [placeholder]="'ADS-820.StreetAddressPlaceholder' | translate"\r
                formControlName="damaged_property_street_address"\r
                />\r
                <app-simple-error-list [control]="formGroup.get('damaged_property_street_address')"></app-simple-error-list>\r
              </div>\r
\r
              <!-- Damaged Property City -->\r
              <div>\r
                <app-input-label\r
                  controlId="damaged_property_city"\r
                  [controlLabel]="'ADS-820.DamagedPropertyCity' | translate"\r
                  required="true">\r
                </app-input-label>\r
                <input\r
                  id="damaged_property_city"\r
                  type="text"\r
                  class="form-control"\r
                  [placeholder]="'ADS-820.CityPlaceholder' | translate"\r
                  formControlName="damaged_property_city"\r
                  />\r
                  <app-simple-error-list [control]="formGroup.get('damaged_property_city')"></app-simple-error-list>\r
                </div>\r
\r
                <!-- Damaged Property Zip -->\r
                <div>\r
                  <app-input-label\r
                    controlId="damaged_property_zip"\r
                    [controlLabel]="'ADS-820.DamagedPropertyZip' | translate"\r
                    required="true">\r
                  </app-input-label>\r
                  <input\r
                    id="damaged_property_zip"\r
                    type="text"\r
                    class="form-control"\r
                    [placeholder]="'ADS-820.ZipCodePlaceholder' | translate"\r
                    formControlName="damaged_property_zip"\r
                    appNumericSplitter\r
                    [splitterType]="SplitterType.ZIP"\r
                    />\r
                    <app-simple-error-list [control]="formGroup.get('damaged_property_zip')"></app-simple-error-list>\r
                  </div>\r
                </div>\r
\r
                <button\r
                  class="btn btn-primary btn-assessor"\r
                  style="white-space: nowrap"\r
                  (click)="onClickClearAddress()">\r
                  {{ 'ADS-820.ClearAddress' | translate }}\r
                </button>\r
\r
                <hr>\r
                  <!-- Damaged Property Type -->\r
                  <h4>\r
                    {{ 'ADS-820.DamagedPropertyType' | translate }}\r
                    <span class="color-red">*</span>\r
                  </h4>\r
                  <div id="damaged_property_group">\r
\r
                    <!-- Real Property -->\r
                    <div id="prop_real_property">\r
                      <div class="form-check">\r
                        <input\r
                          class="form-check-input"\r
                          id="real_property"\r
                          value="real_property"\r
                          type="checkbox"\r
                          formControlName="real_property"\r
                          />\r
                          <label class="form-check-label" style="color: black" for="real_property">\r
                            <b>{{ 'ADS-820.RealProperty' | translate }}</b> {{ 'ADS-820.RealPropertyExtra' | translate }}\r
                          </label>\r
                        </div>\r
                        <div style="margin-left: 20px">\r
                          <app-input-label\r
                            controlId="ain"\r
                            [controlLabel]="'ADS-820.AssessmentNumber' | translate"\r
                            [required]="false">\r
                          </app-input-label>\r
                          <input\r
                            id="ain"\r
                            type="text"\r
                            class="form-control"\r
                            placeholder="xxxx-xxx-xxx"\r
                            formControlName="ain"\r
                            appNumericSplitter\r
                            [splitterType]="SplitterType.AIN"\r
                            />\r
                            <app-simple-error-list [control]="formGroup.get('ain')"></app-simple-error-list>\r
                          </div>\r
                        </div>\r
\r
                        <!-- Boat or Aircraft Property -->\r
                        <div id="prop_aircraft_boat">\r
                          <div class="form-check">\r
                            <input\r
                              class="form-check-input"\r
                              id="boat_aircraft_property"\r
                              value="boat_aircraft_property"\r
                              type="checkbox"\r
                              formControlName="boat_aircraft_property"\r
                              />\r
                              <label class="form-check-label" style="color: black" for="boat_aircraft_property">\r
                                <b>{{ 'ADS-820.BoatAircraftProperty' | translate }}</b>\r
                              </label>\r
                            </div>\r
                            <div style="margin-left: 20px">\r
                              <app-input-label\r
                                controlId="boat_aircraft_property"\r
                                [controlLabel]="'ADS-820.RegistrationNumber' | translate"\r
                                [required]="false">\r
                              </app-input-label>\r
                              <input\r
                                id="boat_aircraft_reg"\r
                                type="text"\r
                                class="form-control"\r
                                [placeholder]="'ADS-820.BoatAircraftPlaceholder' | translate"\r
                                formControlName="boat_aircraft_reg"\r
                                />\r
                                <app-simple-error-list [control]="formGroup.get('boat_aircraft_reg')"></app-simple-error-list>\r
                              </div>\r
                            </div>\r
\r
                            <!-- Business Personal Property -->\r
                            <div id="prop_business_pp">\r
                              <div class="form-check">\r
                                <input\r
                                  class="form-check-input"\r
                                  id="business_personal_property"\r
                                  value="business_personal_property"\r
                                  type="checkbox"\r
                                  formControlName="business_personal_property"\r
                                  />\r
                                  <label class="form-check-label" style="color: black" for="business_personal_property">\r
                                    <b>{{ 'ADS-820.BusinessPersonalProperty' | translate }}</b>\r
                                  </label>\r
                                </div>\r
                                <div class="business-pp-group" style="margin-left: 20px">\r
                                  <div style="flex-grow: 1">\r
                                    <app-input-label\r
                                      controlId="assessment_number"\r
                                      [controlLabel]="'ADS-820.AssessmentNumberBusiness' | translate"\r
                                      [required]="false">\r
                                    </app-input-label>\r
                                    <input\r
                                      id="assessment_number"\r
                                      type="text"\r
                                      class="form-control"\r
                                      [placeholder]="'ADS-820.Assessment/CompanyPlaceholder' | translate"\r
                                      formControlName="assessment_number"\r
                                      />\r
                                      <app-simple-error-list [control]="formGroup.get('assessment_number')"></app-simple-error-list>\r
                                    </div>\r
                                    <div style="flex-grow: 1">\r
                                      <app-input-label\r
                                        controlId="company_name"\r
                                        [controlLabel]="'ADS-820.CompanyName' | translate"\r
                                        [required]="false">\r
                                      </app-input-label>\r
                                      <input\r
                                        id="company_name"\r
                                        type="text"\r
                                        class="form-control"\r
                                        [placeholder]="'ADS-820.CompanyNamePlaceholder' | translate"\r
                                        formControlName="company_name"\r
                                        />\r
                                        <app-simple-error-list [control]="formGroup.get('company_name')"></app-simple-error-list>\r
                                      </div>\r
                                    </div>\r
                                  </div>\r
\r
                                  <!-- Manufactured Home -->\r
                                  <div id="prop_manufactured_home">\r
                                    <div class="form-check">\r
                                      <input\r
                                        class="form-check-input"\r
                                        id="manufactured_property"\r
                                        value="manufactured_property"\r
                                        type="checkbox"\r
                                        formControlName="manufactured_property"\r
                                        />\r
                                        <label class="form-check-label" style="color: black" for="manufactured_property">\r
                                          <b>{{ 'ADS-820.ManufacturedHome' | translate }}</b>\r
                                        </label>\r
                                      </div>\r
                                      <div style="margin-left: 20px">\r
                                        <app-input-label\r
                                          controlId="manufactured_home_no"\r
                                          [controlLabel]="'ADS-820.AssessorIDNumber' | translate"\r
                                          [required]="false">\r
                                        </app-input-label>\r
                                        <input\r
                                          id="manufactured_home_no"\r
                                          type="text"\r
                                          class="form-control"\r
                                          [placeholder]="'ADS-820.AssessorIDPlaceholder' | translate"\r
                                          formControlName="manufactured_home_no"\r
                                          />\r
                                          <app-simple-error-list [control]="formGroup.get('manufactured_home_no')"></app-simple-error-list>\r
                                        </div>\r
                                      </div>\r
                                    </div>\r
\r
                                    <!-- Validation message if no property type is selected -->\r
                                    @if (hasDamagePropSelected === false) {\r
                                      <ul>\r
                                        <li style="color: red; margin-left: 20px">\r
                                          {{ 'ADS-820.PleaseIndicateDamageType' | translate }}\r
                                        </li>\r
                                      </ul>\r
                                    }\r
\r
                                    <hr>\r
                                      <!-- Damaged Property Details -->\r
                                      <h4>{{ 'ADS-820.DamagedPropertyDetails' | translate }}</h4>\r
                                      <div id="damage-info">\r
                                        <div style="display: flex; flex-direction: row; gap: 10px">\r
                                          <!-- Date Damage Occurred -->\r
                                          <div>\r
                                            <app-input-label\r
                                              controlId="date_damage"\r
                                              [controlLabel]="'ADS-820.DateDamageOccurred' | translate"\r
                                              [required]="true">\r
                                            </app-input-label>\r
                                            <input\r
                                              id="date_damage"\r
                                              type="date"\r
                                              class="form-control"\r
                                              placeholder="Date damage occurred"\r
                                              formControlName="date_damage"\r
                                              />\r
                                              <app-simple-error-list [control]="formGroup.get('date_damage')"></app-simple-error-list>\r
                                            </div>\r
\r
                                            <!-- Date Damage Repaired -->\r
                                            <div>\r
                                              <app-input-label\r
                                                controlId="date_repaired"\r
                                                [controlLabel]="'ADS-820.DateDamageRepaired' | translate"\r
                                                [required]="false">\r
                                              </app-input-label>\r
                                              <input\r
                                                id="date_repaired"\r
                                                type="date"\r
                                                class="form-control"\r
                                                placeholder="Date damage repaired"\r
                                                formControlName="date_repaired"\r
                                                />\r
                                              </div>\r
                                            </div>\r
\r
                                            <!-- Describe Damage -->\r
                                            <div>\r
                                              <app-input-label\r
                                                controlId="damage_cause"\r
                                                [controlLabel]="'ADS-820.DescribeDamage' | translate"\r
                                                [required]="false">\r
                                              </app-input-label>\r
                                              <textarea\r
                                                id="damage_cause"\r
                                                maxlength="280"\r
                                                rows="5"\r
                                                class="form-control"\r
                                                [placeholder]="'ADS-820.DescriptionPlaceholder' | translate"\r
                                                formControlName="damage_cause">\r
                                              </textarea>\r
                                              <app-simple-error-list [control]="formGroup.get('damage_cause')"></app-simple-error-list>\r
                                            </div>\r
                                            <hr>\r
\r
                                              <!-- Owner/Applicant Information -->\r
                                              <h4>{{ 'ADS-820.OwnerApplicantInfo' | translate }}</h4>\r
                                              <div style="display: flex; flex-direction: column; gap: 10px">\r
                                                <!-- First Name -->\r
                                                <div>\r
                                                  <app-input-label\r
                                                    controlId="first_name"\r
                                                    [controlLabel]="'ADS-820.FirstName' | translate"\r
                                                    [required]="true">\r
                                                  </app-input-label>\r
                                                  <input\r
                                                    id="first_name"\r
                                                    type="text"\r
                                                    class="form-control"\r
                                                    [placeholder]="'ADS-820.FirstNamePlaceholder' | translate"\r
                                                    formControlName="first_name"\r
                                                    />\r
                                                    <app-simple-error-list [control]="formGroup.get('first_name')"></app-simple-error-list>\r
                                                  </div>\r
\r
                                                  <!-- Last Name -->\r
                                                  <div>\r
                                                    <app-input-label\r
                                                      controlId="last_name"\r
                                                      [controlLabel]="'ADS-820.LastName' | translate"\r
                                                      [required]="true">\r
                                                    </app-input-label>\r
                                                    <input\r
                                                      id="last_name"\r
                                                      type="text"\r
                                                      class="form-control"\r
                                                      [placeholder]="'ADS-820.LastNamePlaceholder' | translate"\r
                                                      formControlName="last_name"\r
                                                      />\r
                                                      <app-simple-error-list [control]="formGroup.get('last_name')"></app-simple-error-list>\r
                                                    </div>\r
\r
                                                    <!-- Email (hardcoded label or add a key in JSON if desired) -->\r
                                                    <div>\r
                                                      <app-input-label\r
                                                        controlId="signer1_email"\r
                                                        controlLabel="Email"\r
                                                        [required]="true">\r
                                                      </app-input-label>\r
                                                      <input\r
                                                        id="email"\r
                                                        type="email"\r
                                                        class="form-control"\r
                                                        [placeholder]="'ADS-820.EmailPlaceholder' | translate"\r
                                                        formControlName="signer1_email"\r
                                                        />\r
                                                        <app-simple-error-list [control]="formGroup.get('signer1_email')"></app-simple-error-list>\r
                                                      </div>\r
\r
                                                      <!-- Phone (hardcoded label or add a key in JSON if desired) -->\r
                                                      <div>\r
                                                        <app-input-label\r
                                                          controlId="signer1_phone"\r
                                                          [controlLabel]="'ADS-820.PhonePlaceholder' | translate"\r
                                                          [required]="true">\r
                                                        </app-input-label>\r
                                                        <input\r
                                                          id="phone"\r
                                                          type="text"\r
                                                          class="form-control"\r
                                                          [placeholder]="'ADS-820.PhonePlaceholder' | translate"\r
                                                          formControlName="signer1_phone"\r
                                                          appNumericSplitter\r
                                                          [splitterType]="SplitterType.PHONE"\r
                                                          />\r
                                                          <app-simple-error-list [control]="formGroup.get('signer1_phone')"></app-simple-error-list>\r
                                                        </div>\r
                                                      </div>\r
                                                      <hr>\r
\r
                                                        <!-- Current Mailing Address (not in JSON, so left as is) -->\r
                                                        <h4>{{ 'ADS-820.CurrentMailingAddress' | translate }}</h4>\r
                                                        <p [innerHTML]="'ADS-820.CurrentMailingAddressDesc' | translate"></p>\r
                                                        <div style="display: flex; flex-direction: column; gap: 10px">\r
                                                          <div>\r
                                                            <app-input-label\r
                                                              controlId="mail_street_address"\r
                                                              [controlLabel]="'ADS-820.MailingStreetAddress' | translate"\r
                                                              [required]="true">\r
                                                            </app-input-label>\r
                                                            <input\r
                                                              id="mail_street_address"\r
                                                              type="text"\r
                                                              class="form-control"\r
                                                              [placeholder]="'ADS-820.StreetAddressPlaceholder' | translate"\r
                                                              formControlName="mail_street_address"\r
                                                              />\r
                                                              <app-simple-error-list [control]="formGroup.get('mail_street_address')"></app-simple-error-list>\r
                                                            </div>\r
                                                            <div>\r
                                                              <app-input-label\r
                                                                controlId="mail_city"\r
                                                                [controlLabel]="'ADS-820.MailingAddressCity' | translate"\r
                                                                [required]="true">\r
                                                              </app-input-label>\r
                                                              <input\r
                                                                id="mail_city"\r
                                                                type="text"\r
                                                                class="form-control"\r
                                                                placeholder="City"\r
                                                                [placeholder]="'ADS-820.CityPlaceholder' | translate"\r
                                                                formControlName="mail_city"\r
                                                                />\r
                                                                <app-simple-error-list [control]="formGroup.get('mail_city')"></app-simple-error-list>\r
                                                              </div>\r
                                                              <div>\r
                                                                <app-input-label\r
                                                                  controlId="mail_state"\r
                                                                  [controlLabel]="'ADS-820.MailingAddressState' | translate"\r
                                                                  [required]="true">\r
                                                                </app-input-label>\r
                                                                <input\r
                                                                  id="mail_state"\r
                                                                  type="text"\r
                                                                  class="form-control"\r
                                                                  [placeholder]="'ADS-820.StatePlaceholder' | translate"\r
                                                                  formControlName="mail_state"\r
                                                                  />\r
                                                                  <app-simple-error-list [control]="formGroup.get('mail_state')"></app-simple-error-list>\r
                                                                </div>\r
                                                                <div>\r
                                                                  <app-input-label\r
                                                                    controlId="mail_zip"\r
                                                                    [controlLabel]="'ADS-820.MailingAddressZip' | translate"\r
                                                                    [required]="true">\r
                                                                  </app-input-label>\r
                                                                  <input\r
                                                                    id="mail_zip"\r
                                                                    type="text"\r
                                                                    class="form-control"\r
                                                                    [placeholder]="'ADS-820.ZipCodePlaceholder' | translate"\r
                                                                    formControlName="mail_zip"\r
                                                                    appNumericSplitter\r
                                                                    [splitterType]="SplitterType.ZIP"\r
                                                                    />\r
                                                                    <app-simple-error-list [control]="formGroup.get('mail_zip')"></app-simple-error-list>\r
                                                                  </div>\r
                                                                </div>\r
                                                                <hr>\r
\r
                                                                  <!-- Optional Supporting Documentation -->\r
                                                                  <h4>{{ 'ADS-820.OptionalSupportingDocumentationTitle' | translate }}</h4>\r
                                                                  <p style="color: black">\r
                                                                    {{ 'ADS-820.OptionalSupportingDocumentationDescription' | translate }}\r
                                                                  </p>\r
                                                                  <app-file-upload-v2 [fileControl]="fileUploadControl"></app-file-upload-v2>\r
                                                                  <hr>\r
\r
                                                                    <!-- Submission Section -->\r
                                                                    @switch (submissionStatus) {\r
                                                                      <!-- Waiting -->\r
                                                                      @case (AdsSubmissionStatus.waiting) {\r
                                                                        <div>\r
                                                                          <div class="centered-content">\r
                                                                            <h4 style="text-align: center">{{ 'ADS-820.SubmitTitle' | translate }}</h4>\r
                                                                            <p style="color: black; text-align: center">\r
                                                                              {{ 'ADS-820.SubmitDescription' | translate }}\r
                                                                            </p>\r
                                                                            @if (error) {\r
                                                                              <p style="text-align: center">\r
                                                                                {{ 'ADS-820.SubmitError' | translate }}\r
                                                                              </p>\r
                                                                            }\r
                                                                            <div style="display: flex; flex-direction: column; gap: 10px">\r
                                                                              <div>\r
                                                                                <app-input-label\r
                                                                                  controlId="signature1"\r
                                                                                  [controlLabel]="'ADS-820.TypeFullLegalNamePlaceholder' | translate"\r
                                                                                  [required]="true">\r
                                                                                </app-input-label>\r
                                                                                <input\r
                                                                                  id="signature"\r
                                                                                  type="text"\r
                                                                                  class="form-control"\r
                                                                                  [placeholder]="'ADS-820.FirstLastPlaceholder' | translate"\r
                                                                                  formControlName="signature1"\r
                                                                                  />\r
                                                                                  @if (hasSigned === false) {\r
                                                                                    <ul>\r
                                                                                      <li style="color: red; margin-left: 20px">\r
                                                                                        {{ 'ADS-820.SignatureError' | translate }}\r
                                                                                      </li>\r
                                                                                    </ul>\r
                                                                                  }\r
                                                                                </div>\r
                                                                                <button\r
                                                                                  class="btn btn-primary btn-submit"\r
                                                                                  style="white-space: nowrap"\r
                                                                                  (click)="onClickSubmit(errorSubmission)"\r
                                                                                  [disabled]="environmentService.isQA() && enableSubmission !== true">\r
                                                                                  {{ 'ADS-820.SubmitButton' | translate }}\r
                                                                                </button>\r
                                                                                <button\r
                                                                                  class="btn btn-primary btn-assessor"\r
                                                                                  style="white-space: nowrap"\r
                                                                                  (click)="onClickPreview(pdfPreviewPopUp)">\r
                                                                                  {{ 'ADS-820.PreviewButton' | translate }}\r
                                                                                </button>\r
                                                                              </div>\r
                                                                            </div>\r
                                                                          </div>\r
                                                                        }\r
                                                                        <!-- Submitting -->\r
                                                                        @case (AdsSubmissionStatus.submitting) {\r
                                                                          <div>\r
                                                                            <div class="centered-content">\r
                                                                              <h4 style="text-align: center">\r
                                                                                {{ 'ADS-820.SubmissionInProgressTitle' | translate }}\r
                                                                              </h4>\r
                                                                              <p style="color: black; text-align: center">\r
                                                                                {{ 'ADS-820.SubmissionInProgressMessage' | translate }}\r
                                                                              </p>\r
                                                                              <div style="display: flex; justify-content: center; align-content: center">\r
                                                                                <app-loading-spinner></app-loading-spinner>\r
                                                                              </div>\r
                                                                            </div>\r
                                                                          </div>\r
                                                                        }\r
                                                                        <!-- Submitted -->\r
                                                                        @case (AdsSubmissionStatus.submitted) {\r
                                                                          <div>\r
                                                                            <div class="centered-content">\r
                                                                              <h4 style="text-align: center">\r
                                                                                {{ 'ADS-820.SubmissionSuccessTitle' | translate }}\r
                                                                              </h4>\r
                                                                              <p style="color: black; text-align: center">\r
                                                                                {{ 'ADS-820.SubmissionSuccessMessage' | translate }}\r
                                                                              </p>\r
                                                                              <button\r
                                                                                class="btn btn-primary btn-assessor"\r
                                                                                style="white-space: nowrap"\r
                                                                                (click)="onStartNewSubmission()">\r
                                                                                {{ 'ADS-820.StartNewSubmissionButton' | translate }}\r
                                                                              </button>\r
                                                                            </div>\r
                                                                          </div>\r
                                                                        }\r
                                                                      }\r
                                                                    </div>\r
                                                                  </div>\r
                                                                }\r
                                                              </div>\r
\r
                                                              <!-- Error Submission Modal -->\r
                                                              <ng-template #errorSubmission>\r
                                                                <div style="display: flex; flex-direction: column; padding: 10px; gap: 5px; background: ghostwhite">\r
                                                                  <h1 style="text-align: center">\r
                                                                    {{ 'ADS-820.FormErrorsTitle' | translate }}\r
                                                                  </h1>\r
                                                                  <p>\r
                                                                    {{ 'ADS-820.FormErrorsMessage' | translate }}\r
                                                                  </p>\r
                                                                  <button class="btn btn-primary btn-assessor" (click)="modalRef.hide()">\r
                                                                    {{ 'ADS-820.CloseButton' | translate }}\r
                                                                  </button>\r
                                                                </div>\r
                                                              </ng-template>\r
\r
                                                              <!-- PDF Preview Modal -->\r
                                                              <ng-template #pdfPreviewPopUp>\r
                                                                <div style="display: flex; flex-direction: column; padding: 10px; gap: 5px; background: ghostwhite">\r
                                                                  <app-form-preview [pdfFillJson]="pdfFillJson()"></app-form-preview>\r
                                                                  <button class="btn btn-primary btn-assessor" (click)="modalRef.hide()">Close Preview</button>\r
                                                                </div>\r
                                                              </ng-template>\r
\r
                                                              <!-- Custom Typeahead List Template -->\r
                                                              <ng-template #customListTemplate let-matches="matches" let-query="query" let-typeaheadTemplateMethods>\r
                                                                <ul class="custom-list-group">\r
                                                                  @for (match of matches; track match) {\r
                                                                    <li\r
                                                                      class="custom-list-group-item"\r
                                                                      [class.active]="typeaheadTemplateMethods.isActive(match)"\r
                                                                      (click)="typeaheadTemplateMethods.selectMatch(match, $event)"\r
                                                                      (mouseenter)="typeaheadTemplateMethods.selectActive(match)">\r
                                                                      {{ match.item.SitusStreet + ', ' + match.item.SitusCity + ', ' + match.item.SitusZipCode }}\r
                                                                    </li>\r
                                                                  }\r
                                                                </ul>\r
                                                              </ng-template>\r
`, styles: ["/* src/app/contact/ads820/ads820.component.scss */\nh1,\nh4,\nh5 {\n  color: black;\n}\np {\n  color: black;\n}\n.custom-list-group {\n  padding-left: 0;\n  list-style-type: none;\n}\n.custom-list-group-item {\n  color: black;\n  padding: 10px;\n}\n.custom-list-group-item:hover {\n  color: white;\n  background-color: #043c5a;\n}\n.typeahead-search {\n  position: relative;\n}\n.business-pp-group {\n  display: flex;\n  gap: 10px;\n}\n@media (max-width: 600px) {\n  .business-pp-group {\n    flex-direction: column;\n  }\n}\n.efile-page {\n  border: 2px solid lightgray;\n  background: whitesmoke;\n  padding: 15px;\n}\n.centered-content {\n  display: flex;\n  justify-content: center;\n  align-content: center;\n  flex-direction: column;\n}\n.tax-bill-info {\n  display: grid;\n  grid-template-columns: 20% 1fr;\n  grid-template-rows: auto auto auto;\n  gap: 10px;\n  width: 100%;\n}\n.tax-bill-info-label {\n  margin-bottom: 0;\n}\n/*# sourceMappingURL=ads820.component-ZBFX4KMB.css.map */\n"] }]
