  <div class="toggler" [ngClass]="{'fadeIn': !toggleDisplay}">\r
    @if (toggleDisplay) {\r
      <div class="toggler-inner" (click)="toggle()">\r
        <p class=""  >\r
          <!-- <i class="fas fa-comment-alt icon-msg"></i> -->\r
          {{"Home.Newsletter" | translate}}\r
        </p>\r
      </div>\r
    }\r
    @if (!toggleDisplay) {\r
      <div class="newsletter animate slideLeft">\r
        <div class="newsletter-content">\r
          <button class="close-btn" (click)="toggleOff()"><i class="fas fa-times"></i></button>\r
          <h3 style="color: #3265B1">{{"Home.NewsTitle" | translate}}</h3>\r
          <h3 style="margin-bottom: .5em; color: #000;">{{"Home.NewsSub" | translate}}</h3>\r
          <div class="buttons">\r
            <div><button type="button" routerLink="news-information/newsletters" (click)="toggleOff()"  class="btn btn-primary">{{"Home.Sub" | translate}}</button></div>\r
            <div><button type="button" (click)="toggle()" class="btn btn-light">{{"Home.Later" | translate}}</button></div>\r
          </div>\r
        </div>\r
      </div>\r
    }\r
  </div>\r
}\r
