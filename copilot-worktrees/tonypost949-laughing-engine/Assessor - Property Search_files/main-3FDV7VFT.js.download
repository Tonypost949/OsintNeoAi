      else
        this.initialize(data.Parcel);
    });
  }
  initialize(item) {
    this.calc1Values = {
      fairMarketValue: 0,
      taxableValue: Number(item.RollPreparation_ImpValue) + Number(item.RollPreparation_LandValue),
      millionDollarExclusion: 1e6
    };
    this.scrollBottom("MarketValueParent");
  }
  initializeBaseYear(item) {
    this.calc2Values = {
      fairMarketValue: 0,
      fairMarketValueReplacement: 0,
      taxableValue: Number(item.RollPreparation_ImpValue) + Number(item.RollPreparation_LandValue),
      millionDollarExclusion: 1e6
    };
    this.scrollBottom("MarketValueBaseYear");
    console.log("BaseYear");
  }
  checkValue() {
    return this.calc1Values.fairMarketValue <= this.calc1Values.millionDollarExclusion + this.calc1Values.taxableValue;
  }
  checkParentValue() {
    return this.calc2Values.fairMarketValueReplacement > this.calc2Values.fairMarketValue;
  }
