<div class="container my-4 contactContent" id="">\r
  <h3 class="page-title">{{'ContactAssessor.TitleBusiness'|translate}}</h3>\r
  <p style="font-style: italic"><strong>{{'ContactAssessor.Number'|translate}} </strong></p>\r
  <hr>\r
    <form [formGroup]="contactForm" (ngSubmit)="submit()">\r
      <p class="form-label">{{'ContactAssessor.Name'|translate}} <span class="color-red">*</span></p>\r
      <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px; margin-bottom: 20px;">\r
        <div class="form-group col-md-6" style="display: flex; flex-direction: column; align-items: center; width: 49%;">\r
\r
          <input type="text" formControlName="firstName" class="form-control" id="inputFirst-General" placeholder="{{'ContactAssessor.FirstName' | translate}}">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('firstName', 'required')) {\r
              {{'ContactAssessor.Required'|translate}}\r
            }\r
          </div>\r
        </div>\r
        <div class="form-group col-md-6">\r
          <input type="text" formControlName="lastName" class="form-control" id="inputLast-General" placeholder="{{'ContactAssessor.LastName' | translate}}">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('lastName', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
      <div class="form-group">\r
        <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Email' | translate}} <span class="color-red">*</span></p>\r
        <input type="email" class="form-control" formControlName="email" placeholder="{{'ContactAssessor.Email' | translate}}">\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('email', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Phone' | translate}}  <span class="color-red">*</span></p>\r
      <div class="form-row">\r
        <div class="form-group col-12">\r
          <input class="form-control"  type="text" appPhoneMask placeholder="{{'ContactAssessor.Phone' | translate}}"  formControlName="phone" id="inputPhone-General"  >\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('phone', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
      </div>\r
\r
      <p class="form-label" style="margin-top: 20px;">\r
        {{'ContactAssessor.SpecificRadio' | translate}} <span class="color-red">*</span>\r
      </p>\r
      <div class="form-group d-flex align-items-center gap-3">\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="businessDescription" value="0" name="businessDescription" type="radio" id="marineAircraft">\r
          <label class="form-check-label" for="marineAircraft">{{'ContactAssessor.MarineAndAircraft' | translate}}</label>\r
        </div>\r
\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="businessDescription" value="1" name="businessDescription" type="radio" id="mobileHome">\r
          <label class="form-check-label" for="mobileHome">{{'ContactAssessor.MobileHome' | translate}}</label>\r
        </div>\r
\r
        <div class="form-check">\r
          <input class="form-check-input" formControlName="businessDescription" value="2" name="businessDescription" type="radio" id="otherBusiness">\r
          <label class="form-check-label" for="otherBusiness">{{'ContactAssessor.OtherBusiness' | translate}}</label>\r
        </div>\r
\r
\r
\r
      </div>\r
      <div class="invalid-feedback" style="display: block">\r
        @if (hasError('businessDescription', 'required')) {\r
          {{ 'ContactAssessor.Required' | translate}}\r
        }\r
      </div>\r
\r
      <div class="form-row" style="display: flex; align-items: flex-start; flex-wrap: nowrap; gap: 10px; margin-bottom: 20px;">\r
\r
        <div class="form-group col-md-6" style="width: 49%;">\r
          <label class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.AssesmentNumberv2' | translate}}</label>\r
          <input type="text" formControlName="assessment" class="form-control" id="" >\r
\r
        </div>\r
        <div class="col-md-6">\r
          <label class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.IndexNumber' | translate}}</label>\r
          <input type="text" formControlName="index" class="form-control" id="" >\r
\r
        </div>\r
\r
      </div>\r
\r
      <p class="form-label" style="margin-top: 20px;">{{'ContactAssessor.Address'| translate}} <span class="color-red">*</span></p>\r
      <app-certificate-address\r
        [parentFormGroup]="contactForm"\r
        streetNumber="number"\r
        streetDirection="direction"\r
        streetName="street"\r
        streetType="type"\r
        unitNumber="unit"\r
        city="city"\r
        zipCode="zipCode"\r
        >\r
      </app-certificate-address>\r
\r
\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Description' | translate}}</p>\r
      <div class="form-group">\r
\r
        <textarea class="form-control" formControlName="description"  id="inputDescription-General" rows="4" placeholder="Type here"></textarea>\r
      </div>\r
      <p class="form-label" style="margin-top: 20px;">{{ 'ContactAssessor.Attachment' | translate}} (PDF or Docx)</p>\r
      <div class="form-group">\r
        <app-file-upload formControlName="file" [progress]="progress"></app-file-upload>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('file', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
          @if (hasError('file', 'requiredFileType')) {\r
            Only PDF, Docx\r
          }\r
          @if (hasError('file', 'requiredFileSize')) {\r
            Size to exceeds 10 MB\r
          }\r
        </div>\r
      </div>\r
\r
\r
      <div class="form-group" style="margin-top: 15px;">\r
        <app-captcha [form]="contactForm" captchaFieldName="recaptchaReactive"></app-captcha>\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('recaptchaReactive', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
      </div>\r
\r
      <button type="submit" class="btn btn-primary mr-4" style="margin-top: 15px;">Submit</button>@if (success) {\r
      <span>Successfully Submitted</span>\r
    }\r
\r
  </form>\r
\r
</div>\r
