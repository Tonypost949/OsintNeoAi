<tab heading="FAQ" (selectTab)="onSelect($event);">\r
  @for (item of FaqData; track item) {\r
    <div class="faq_tab">\r
      <h5 [innerHTML]="item.question"></h5>\r
      <p [innerHTML]="item.answer"></p>\r
    </div>\r
  }\r
</tab>\r
\r
<tab  heading="Forms" class="forms_tab" (selectTab)="onSelect($event)">\r
  @for (item of FormData; track item) {\r
    <div class="list-group">\r
      <a href="{{item.fileUrl}}" target="_blank">\r
        <app-pdf-url-row>\r
          <div style="display: flex; flex-direction: column">\r
            <h5>{{item.formNumber}}</h5>\r
            <p style="padding-left: 0">{{item.title}}</p>\r
          </div>\r
        </app-pdf-url-row>\r
      </a>\r
    </div>\r
  }\r
</tab>\r
