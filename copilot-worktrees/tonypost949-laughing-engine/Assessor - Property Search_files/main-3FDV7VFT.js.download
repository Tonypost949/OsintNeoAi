var WebsiteSupportComponent = class _WebsiteSupportComponent {
  // value: any;
  constructor(http, formBuilder, apiService) {
    this.http = http;
    this.formBuilder = formBuilder;
    this.apiService = apiService;
    this.progress = 0;
    this.success = false;
    this.eserviceOptions = [
      { id: "changeMailingAddress", value: "Change of Mailing Address Form e-File", label: "Change of Mailing Address Form e-File" },
      { id: "homeownerExemption", value: "Homeowners' Exemption Form e-File", label: "Homeowners' Exemption Form e-File" },
      { id: "pdcr", value: "Property Data Change Request e-File", label: "Property Data Change Request e-File" },
      { id: "alertService", value: "Homeowner Alert Service (e-Notification)", label: "Homeowner Alert Service (e-Notification)" }
    ];
    this.contactForm = this.formBuilder.group({
      firstName: ["", Validators.required],
      lastName: ["", Validators.required],
      phone: ["", Validators.required],
      ains: this.formBuilder.array([
        this.createAinControl()
        // start with one empty AIN
      ]),
      // number: '',
      // direction: '',
      // street: ['', Validators.required],
      // type: '',
      // unit: '',
      // city: ['', Validators.required],
      // zipCode: ['', Validators.required],
      topic: ["", Validators.required],
      eserviceChoices: this.formBuilder.array(this.eserviceOptions.map(() => this.formBuilder.control(false))),
      eserviceValues: this.formBuilder.array([]),
      description: "",
      email: ["", Validators.required],
      file: ["", [requiredFileType(""), requiredFileSize(1e7)]],
      // eserviceChoice: ['', Validators.required],
      recaptchaReactive: ["", Validators.required]
    });
  }
  //code to enable multiple ain inputs
  get ains() {
    return this.contactForm.get("ains");
  }
  createAinControl() {
    return this.formBuilder.control("", []);
  }
  addAin() {
    this.ains.push(this.createAinControl());
  }
  removeAin(index) {
    this.ains.removeAt(index);
  }
  //code to update eservice values
  get eserviceChoices() {
    return this.contactForm.get("eserviceChoices");
  }
  getSelectedEserviceValues() {
    const choices = this.eserviceChoices.value;
    return this.eserviceOptions.filter((_, index) => choices[index]).map((opt) => opt.value);
  }
  onCheckboxChange(index) {
    const selected = this.getSelectedEserviceValues();
    const valuesArray = this.contactForm.get("eserviceValues");
    valuesArray.clear();
    selected.forEach((v) => valuesArray.push(new FormControl(v)));
  }
  submit() {
    this.success = false;
    console.log(this.contactForm);
    if (!this.contactForm.valid) {
      markAllAsDirty(this.contactForm);
      return;
    }
    toFormData(this.contactForm.value);
    console.log(this.contactForm);
    this.apiService.sendForm(toFormData(this.contactForm.value), "websitesupport").subscribe((res) => {
      console.log(res);
      this.progress = 0;
      this.success = true;
      this.contactForm.reset();
      console.log(this.contactForm);
    });
  }
  hasError(field, error) {
    const control = this.contactForm.get(field);
    if (this.success)
      return false;
    return control.dirty && control.hasError(error);
  }
  requireAtLeastOneCheckbox() {
    return (formArray) => {
      const atLeastOneSelected = formArray.controls.some((ctrl) => ctrl.value);
      return atLeastOneSelected ? null : { required: true };
    };
  }
  ngOnInit() {
    this.contactForm.get("topic")?.valueChanges.subscribe((topicValue) => {
      const eserviceArray = this.contactForm.get("eserviceChoices");
      if (topicValue === "e-Services") {
        eserviceArray.setValidators([this.requireAtLeastOneCheckbox()]);
      } else {
        eserviceArray.clearValidators();
      }
      eserviceArray.updateValueAndValidity();
    });
  }
  static {
    this.\u0275fac = function WebsiteSupportComponent_Factory(__ngFactoryType__) {
      return new (__ngFactoryType__ || _WebsiteSupportComponent)(\u0275\u0275directiveInject(HttpClient), \u0275\u0275directiveInject(UntypedFormBuilder), \u0275\u0275directiveInject(ApiService));
    };
