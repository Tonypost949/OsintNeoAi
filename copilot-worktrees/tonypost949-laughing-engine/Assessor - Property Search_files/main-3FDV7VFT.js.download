(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(StatusComponent, [{
    type: Component,
    args: [{ selector: "app-status", standalone: false, template: `<div style="display: flex; flex-direction: column; gap: 5px; padding-top: 5px; padding-bottom: 5px">\r
  @if (isLoggedOut) {\r
    <app-banner type="error"\r
      header="Not Logged In"\r
      message="You do not appear to be logged in. Please log in to continue." />\r
    }\r
\r
    <div class="General efile-page">\r
      <h1>Online Submission Status</h1>\r
      <div class="mb-1" style="text-align: right;">\r
        @if (fileItems) {\r
          <p class="efile-header" style="color: #043c5a">Welcome {{ userInfo.lastName }}, {{ userInfo.firstName }} {{ userInfo.middleName }}</p>\r
        }\r
      </div>\r
      <br>\r
\r
        @switch (statusPageState()) {\r
          @case (StatusPageState.loading) {\r
            <div class="p-2" style="display: flex; align-items: center; justify-content: center; flex-direction: column">\r
              <app-loading-spinner></app-loading-spinner>\r
              <p style="color: black; margin-top: 10px">Retrieving your submissions...</p>\r
            </div>\r
          }\r
          @case (StatusPageState.error) {\r
            <div class="p-2" style="display: flex; align-items: center; justify-content: center; flex-direction: column; margin-bottom: 40px;">\r
              <h1 style="margin-bottom: 0">Load Failed</h1>\r
              <button class="btn btn-primary btn-assessor" (click)="onClickRetry()">Retry</button>\r
            </div>\r
          }\r
          @case (StatusPageState.loaded) {\r
            <div class="table-wrapper" >\r
              <table class="table">\r
                <thead class="header-mobile-label">\r
                  <tr>\r
                    <th scope="col">DATE</th>\r
                    <th scope="col">WORK UNIT ID</th>\r
                    <th scope="col">SUBMISSION ID</th>\r
                    <th scope="col">FORM NAME / #</th>\r
                    <th scope="col">AIN</th>\r
                    <th scope="col">STATUS</th>\r
                  </tr>\r
                </thead>\r
                <tbody>\r
                  @for (item of forms; track item) {\r
                    <tr>\r
                      <td><span class="mobile-label">DATE: </span> <p [ngbTooltip]="formatLocalDateTime(item.dateCreated)">{{ item.date }}</p></td>\r
                      <td><span class="mobile-label">WORK UNIT ID: </span> {{ getWorkUnitNumber(item) }}</td>\r
                      <td><span class="mobile-label">SUBMISSION ID: </span> {{ item.id }}</td>\r
                      <td><span class="mobile-label">FORM NAME / #: </span> {{item.fileName}} <br> {{item.description}}</td>\r
                      <td><span class="mobile-label">AIN: </span> {{item.ain}}</td>\r
                      @if (shouldShowWUStart && item.workUnitId === 0) {\r
                        <td>\r
                          <button class="btn btn-primary btn-assessor" (click)="manuallyKickOffWorkUnit(item)">{{getCompleteButtonText(item)}}</button>\r
                        </td>\r
                      } @else {\r
                        @if (item.status == 'Pending Signature') {\r
                          <td><span class="mobile-label">STATUS: </span> <a (click)="accessLink(item.id)" style="color: blue">{{item.status}}</a></td>\r
                        }\r
                        @if (item.status != 'Pending Signature') {\r
                          <td><span class="mobile-label">STATUS: </span> {{ item.status }}</td>\r
                        }\r
                      }\r
                    </tr>\r
                  }\r
\r
                </tbody>\r
              </table>\r
            </div>\r
          }\r
        }\r
\r
        <div class="status-group">\r
          @if (ampOffline()) {\r
            <ngb-alert [dismissible]="false">\r
              <strong>Notice:</strong> The statuses displayed on this page may be out of date due to scheduled maintenance. Please check back later. Last updated: {{ lastUpdatedTime() | date:'medium' }}\r
            </ngb-alert>\r
          }\r
\r
          <div class="accordion">\r
            <accordion [isAnimated]="true">\r
              <accordion-group #drop9 [isOpen]="true">\r
                <div accordion-heading>\r
                  <span class="dropdown-item clearfix">\r
                    STATUS LEGEND\r
                    <i\r
                      class="mt-1 float-end"\r
                      [ngClass]="!drop9.isOpen ? 'fas fa-plus' : 'fas fa-minus'"\r
                    ></i>\r
                  </span>\r
                </div>\r
                <div  style="border: 1px" class="w-100 legend">\r
                  @for (item of legendItems; track item) {\r
                    <p>\r
                      <span style="color: #3165b1">{{item.name}}:</span> {{item.description}}\r
                    </p>\r
                  }\r
                </div>\r
\r
              </accordion-group>\r
            </accordion>\r
          </div>\r
\r
          <div class="status-pagination-controls">\r
            <select class="form-select" style="width: auto" [(ngModel)]="pageSize" (ngModelChange)="refreshForms()">\r
              <option [ngValue]="10">10 items per page</option>\r
              <option [ngValue]="20">20 items per page</option>\r
              <option [ngValue]="50">50 items per page</option>\r
            </select>\r
\r
            <ngb-pagination [collectionSize]="collectionSize"\r
              [(page)]="page"\r
              [pageSize]="pageSize"\r
              (pageChange)="refreshForms()"\r
              [rotate]="true"\r
              [ellipses]="false"\r
              [boundaryLinks]="true"\r
              [maxSize]="3">\r
            </ngb-pagination>\r
          </div>\r
        </div>\r
\r
      </div>\r
    </div>\r
\r
`, styles: ["/* src/app/forms/status/status.component.scss */\n.status-group {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.status-pagination-controls {\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  gap: 10px;\n  margin-right: 20px;\n}\n@media (max-width: 500px) {\n  .status-pagination-controls .form-select {\n    margin-left: 25px;\n  }\n  .status-pagination-controls {\n    flex-direction: column;\n    justify-content: normal;\n    align-items: center;\n  }\n}\n.efile-page {\n  border: 2px solid lightgray;\n  background: whitesmoke;\n  padding: 15px;\n}\n::ng-deep .dropdown-item {\n  white-space: normal !important;\n}\n::ng-deep .card {\n  border: 1px solid #043c5a !important;\n}\na {\n  cursor: pointer;\n  text-decoration: none;\n}\n.legend p {\n  margin-bottom: 4px;\n}\n.search-bar {\n  padding: 0 2em;\n}\n.input-group {\n  border-radius: 0;\n  font-size: 3rem;\n}\n.input-group input {\n  border-radius: 0;\n  font-size: 1.2rem;\n  border-color: #fff;\n}\n.input-group span {\n  border-radius: 0;\n  background-color: #fff;\n  border-color: #fff;\n}\n.form-control:focus {\n  box-shadow: none;\n}\n.efile-header {\n  font-size: 1.2rem;\n  color: #3165b1;\n  text-transform: uppercase;\n  font-weight: 500;\n}\n#content,\n#sidebar {\n  padding-top: 1rem;\n}\n#content {\n  max-height: 100vh;\n  overflow: scroll;\n}\ntable {\n  width: 100%;\n  border-collapse: collapse;\n}\ntable a:hover {\n  text-decoration: underline;\n}\nth,\ntd {\n  text-align: left;\n  padding: 8px;\n}\ntr:nth-child(even) {\n  background-color: #f2f2f2;\n}\n.mobile-label {\n  display: none;\n}\n@media only screen and (max-width: 600px) {\n  tr {\n    display: block;\n    border: 1px solid #ccc;\n    border-radius: 4px;\n    margin-bottom: 10px;\n    overflow: hidden;\n  }\n  td {\n    display: inline-block;\n    width: 100%;\n    padding: 10px;\n  }\n  .mobile-label {\n    display: inline-block;\n    font-weight: bold;\n  }\n  .header-mobile-label {\n    display: none;\n  }\n}\n/*# sourceMappingURL=status.component-MEFD5MWH.css.map */\n"] }]
