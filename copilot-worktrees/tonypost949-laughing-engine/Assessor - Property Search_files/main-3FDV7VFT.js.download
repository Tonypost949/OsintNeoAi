(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(PublicRecordsComponent, [{
    type: Component,
    args: [{ selector: "app-publicRecords", standalone: false, template: `\r
<div heading="General Info" class="container my-3 p-3 contactContent General">\r
  <h3>{{'PublicRecords.SearchTitle'|translate}}</h3>\r
  <p>{{'PublicRecords.SearchDescription'|translate}}</p>\r
  <p>{{'PublicRecords.Californiastate'|translate}}</p>\r
  <div class="info-bar">\r
    <p class="">{{'PropertySearch.AdditionalInfo' | translate}}</p>\r
    <p><a target="_blank" href="https://portal.assessor.lacounty.gov">{{'PropertySearch.AssessorPortal' | translate}}:</a> {{'PropertySearch.AssessorPortalDescription' | translate}}</p>\r
    <!-- <p><a target="_blank" href="https://maps.assessor.lacounty.gov">{{'PropertySearch.PIASDescription' | translate}}:</a> {{'PropertySearch.PIAS' | translate}}</p> -->\r
    <p><a target="_blank" href="https://propertytax.lacounty.gov">{{'PropertySearch.PropertyTaxPortal' | translate}}:</a> {{'PropertySearch.PropertyTaxPortalDescription' | translate}}</p>\r
\r
  </div>\r
  <p [innerHTML]="'PublicRecords.PropertyownerhsipURL'|translate"></p>\r
  <h4>{{'PublicRecords.AssessorRecords'|translate}}</h4>\r
  <p><strong>{{'PublicRecords.Information2'|translate}}</strong></p>\r
  <ol style="margin-left: 0;">\r
    <li>{{'PublicRecords.records1'|translate}}</li>\r
    <li>{{'PublicRecords.records2'|translate}}</li>\r
    <li>{{'PublicRecords.records3'|translate}}</li>\r
    <li>{{'PublicRecords.records4'|translate}}</li>\r
    <li>{{'PublicRecords.records5'|translate}}</li>\r
    <li>{{'PublicRecords.records6'|translate}}</li>\r
  </ol>\r
  <p>{{'PublicRecords.Policy2'|translate}}</p>\r
\r
  <h4>{{'PublicRecords.PublicRecForm'|translate}}</h4>\r
  <p><i>*{{'PublicRecords.Privateuse'|translate}}</i></p>\r
\r
  <hr>\r
\r
\r
    <!-- Begin Form -->\r
    <div class="container my-4 contactContent" id="">\r
      <!-- <h3 class="page-title">{{'ContactAssessor.TitleGeneral'|translate}}</h3>\r
      <p style="font-style: italic"><strong>{{'ContactAssessor.Number'|translate}} </strong></p>\r
      <hr> -->\r
      <form [formGroup]="contactForm" (ngSubmit)="submit()">\r
        <p class="form-label">{{'ContactAssessor.Name'|translate}} <span class="color-red">*</span></p>\r
        <div style="display: flex; gap: 10px">\r
          <div class="form-group col-md-6" style="margin-bottom: 20px;">\r
            <input type="text" formControlName="firstName" class="form-control" id="inputFirst-General" placeholder="First">\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('firstName', 'required')) {\r
                {{'ContactAssessor.Required'|translate}}\r
              }\r
            </div>\r
          </div>\r
          <div class="form-group col-md-6">\r
            <input type="text" formControlName="lastName" class="form-control" id="inputLast-General" placeholder="Last">\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('lastName', 'required')) {\r
                {{ 'ContactAssessor.Required' | translate}}\r
              }\r
            </div>\r
          </div>\r
        </div>\r
        <div class="form-group" style="margin-bottom: 20px;">\r
          <p class="form-label">{{ 'ContactAssessor.Email' | translate}} <span class="color-red">*</span></p>\r
          <input type="email" class="form-control" formControlName="email" placeholder="Email">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('email', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
        <p class="form-label">{{ 'ContactAssessor.Phone' | translate}}  <span class="color-red">*</span></p>\r
        <div class="form-row">\r
          <div class="form-group col-12" style="margin-bottom: 20px;">\r
            <input class="form-control"  type="text" appPhoneMask  formControlName="phone" id="inputPhone-General"  >\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('phone', 'required')) {\r
                {{ 'ContactAssessor.Required' | translate}}\r
              }\r
            </div>\r
          </div>\r
        </div>\r
\r
        <!-- <app-findProperty [title]="'PropertySearch.FindProperty' | translate"  (ParcelItem)="getAddress($event)"></app-findProperty> -->\r
\r
        <p class="form-label">{{'PublicRecords.Typeof' | translate}}<span class="color-red">*</span></p>\r
        <div class="form-group form-row" style="margin-bottom: 20px;">\r
          <div class="form-check">\r
            <input class="form-check-input" formControlName="request" value="general" name="request" type="radio" general="true">\r
            <label class="form-check-label">General</label>\r
          </div>\r
\r
          <div class="form-check">\r
            <input class="form-check-input" formControlName="request" value="specific"  name="request"  type="radio" specific="true">\r
            <label class="form-check-label">Specific</label>\r
          </div>\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('request', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
\r
        @if (general) {\r
          <div style="margin-bottom: 20px;">\r
            <div class="form-group">\r
              <label for="" class="form-label">{{'PublicRecords.RequestType' | translate}}<span class="color-red">*</span></label>\r
              <select formControlName="requestType" name="requestType" id="reason-honor" class="form-select">\r
                <option value="">Select One</option>\r
                <option>Assessment roll</option>\r
                <option>Assessment maps</option>\r
                <option>List of all property transferred in the last two years</option>\r
                <option>Organizational exemption claims and supporting documents</option>\r
                <option>Market data</option>\r
                <option>Information maintained on property characteristics</option>\r
                <option>Other</option>\r
              </select>\r
              <div class="invalid-feedback" style="display: block">\r
                @if (hasError('requestType', 'required')) {\r
                  {{ 'ContactAssessor.Required' | translate}}\r
                }\r
              </div>\r
            </div>\r
          </div>\r
        }\r
\r
        @if (specific) {\r
          <div>\r
            <input type="hidden" formControlName="ain">\r
            <input type="hidden" formControlName="street">\r
            <input type="hidden" formControlName="zipCode">\r
            <input type="hidden" formControlName="city">\r
            <app-findProperty [color]="'#ffffff'" [title]="'ContactAssessor.District' | translate" [imgItem]="false"  (ParcelItem)="getAddress($event)"></app-findProperty>\r
            @if (parcel) {\r
              <div>\r
                <p>Address: {{parcel.SitusStreet}} {{parcel.SitusCity}} {{parcel.SitusZipCode}}</p>\r
              </div>\r
            }\r
          </div>\r
        }\r
        <div class="invalid-feedback" style="display: block">\r
          @if (hasError('ain', 'required')) {\r
            {{ 'ContactAssessor.Required' | translate}}\r
          }\r
        </div>\r
\r
        <p class="form-label">{{ 'PublicRecords.Includeany' | translate}}</p>\r
        <div class="form-group" style="margin-bottom: 20px;">\r
\r
          <textarea class="form-control" formControlName="description"  id="inputDescription-General" rows="4"></textarea>\r
        </div>\r
\r
        <p class="form-label">{{ 'ContactAssessor.Attachment' | translate}} (PDF or Docx)</p>\r
        <!-- <p>{{ 'PublicRecords.Ifrequesting' | translate}}</p> -->\r
        <div class="form-group" style="margin-bottom: 20px;">\r
          <app-file-upload formControlName="file" [progress]="progress"></app-file-upload>\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('file', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
            @if (hasError('file', 'requiredFileType')) {\r
              Only PDF, Docx\r
            }\r
            @if (hasError('file', 'requiredFileSize')) {\r
              Size to exceeds 10 MB\r
            }\r
          </div>\r
        </div>\r
\r
        <br>\r
\r
          <div class="form-group" style="margin-bottom: 15px;">\r
            <app-captcha [form]="contactForm" captchaFieldName="recaptchaReactive"></app-captcha>\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('recaptchaReactive', 'required')) {\r
                {{ 'ContactAssessor.Required' | translate}}\r
              }\r
            </div>\r
          </div>\r
\r
          <button type="submit" class="btn btn-primary mr-4">Submit</button>@if (success) {\r
          <span>Successfully Submitted</span>\r
        }\r
\r
      </form>\r
\r
    </div>\r
\r
    <!-- <p [innerHTML]="'PublicRecords.MediaInquiries'|translate"></p> -->\r
    <p>{{ "PublicRecords.MediaInquiries1" | translate }} <strong style="color:#AC2029"> {{ "PublicRecords.MediaInquiries2" | translate }}</strong>, <span [innerHTML]="'PublicRecords.MediaInquiries3'|translate"></span></p>\r
\r
    <div class="accordion">\r
      <accordion [isAnimated]="true">\r
        <accordion-group #drop>\r
          <div accordion-heading>\r
            <span class="dropdown-item clearfix">\r
              {{ "PublicRecords.Additionalinfo" | translate }}\r
              <i\r
                class="mt-1 float-end"\r
                [ngClass]="!drop.isOpen ? 'fas fa-plus' : 'fas fa-minus'"\r
              ></i>\r
            </span>\r
          </div>\r
          <p>{{ "PublicRecords.TheCaliPub" | translate }}</p>\r
          <p [innerHTML]="'PublicRecords.Thecountyof'|translate"></p>\r
          <p>{{ "PublicRecords.Requeststo" | translate }}</p>\r
          <p>{{ "PublicRecords.Ifamember" | translate }}</p>\r
          <p>{{ "PublicRecords.Recordsshall" | translate }}</p>\r
          <p>{{ "PublicRecords.Withinthe" | translate }}</p>\r
          <p>{{ "PublicRecords.Adopted" | translate }}</p>\r
\r
        </accordion-group>\r
      </accordion>\r
    </div>\r
\r
  </div>\r
\r
\r
\r
\r
  <!-- <tab heading="FAQ">FAQ</tab>\r
  <tab heading="Forms">Forms</tab> -->\r
\r
\r
\r
