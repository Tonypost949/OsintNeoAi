    type: Component,
    args: [{ selector: "app-websiteSupport", standalone: false, template: `<div class="container my-4 contactContent" id="">\r
  <h3 class="page-title">Inquiries about Website Support</h3>\r
\r
  <p style="font-style: italic">\r
    <strong>{{ "ContactAssessor.Number" | translate }} </strong>\r
  </p>\r
\r
  <hr />\r
  <form [formGroup]="contactForm" (ngSubmit)="submit()">\r
    <p class="form-label">\r
      {{ "ContactAssessor.Name" | translate }} <span class="color-red">*</span>\r
    </p>\r
    <div\r
      class="form-row"\r
      style="\r
        display: flex;\r
        align-items: flex-start;\r
        flex-wrap: nowrap;\r
        gap: 10px;\r
        margin-bottom: 20px;\r
      "\r
      >\r
      <div\r
        class="form-group col-md-6"\r
        style="\r
          display: flex;\r
          flex-direction: column;\r
          align-items: center;\r
          width: 49%;\r
        "\r
        >\r
        <input\r
          type="text"\r
          formControlName="firstName"\r
          class="form-control"\r
          id="inputFirst-General"\r
          placeholder="{{ 'ContactAssessor.FirstName' | translate }}"\r
          />\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('firstName', 'required')) {\r
              {{\r
              "ContactAssessor.Required" | translate\r
              }}\r
            }\r
          </div>\r
        </div>\r
        <div class="form-group col-md-6">\r
          <input\r
            type="text"\r
            formControlName="lastName"\r
            class="form-control"\r
            id="inputLast-General"\r
            placeholder="{{ 'ContactAssessor.LastName' | translate }}"\r
            />\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('lastName', 'required')) {\r
                {{\r
                "ContactAssessor.Required" | translate\r
                }}\r
              }\r
            </div>\r
          </div>\r
        </div>\r
        <div class="form-group" style="margin-bottom: 20px">\r
          <p class="form-label">\r
            {{ "ContactAssessor.Email" | translate }}\r
            <span class="color-red">*</span>\r
          </p>\r
          <input\r
            type="email"\r
            class="form-control"\r
            formControlName="email"\r
            placeholder="{{ 'ContactAssessor.Email' | translate }}"\r
            />\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('email', 'required')) {\r
                {{ "ContactAssessor.Required" | translate }}\r
              }\r
            </div>\r
          </div>\r
          <p class="form-label">\r
            {{ "ContactAssessor.Phone" | translate }} <span class="color-red">*</span>\r
          </p>\r
          <div class="form-row">\r
            <div class="form-group col-12" style="margin-bottom: 20px">\r
              <input\r
                class="form-control"\r
                type="text"\r
                appPhoneMask\r
                placeholder="{{ 'ContactAssessor.Phone' | translate }}"\r
                formControlName="phone"\r
                id="inputPhone-General"\r
                />\r
                <div class="invalid-feedback" style="display: block">\r
                  @if (hasError('phone', 'required')) {\r
                    {{\r
                    "ContactAssessor.Required" | translate\r
                    }}\r
                  }\r
                </div>\r
              </div>\r
            </div>\r
\r
            <div formArrayName="ains">\r
              @for (ainCtrl of ains.controls; track ainCtrl; let i = $index) {\r
                <div\r
                  class="form-group"\r
                  >\r
                  <p class="form-label">\r
                    <!-- AIN {{ i + 1 }} ({{ 'ContactAssessor.Ain' | translate}}) -->\r
                    AIN ({{ "ContactAssessor.Ain" | translate }})\r
                  </p>\r
                  <!-- [(ngModel)]="value"] -->\r
                  <input\r
                    type="text"\r
                    class="form-control"\r
                    appAinMask\r
                    [formControlName]="i"\r
                    placeholder="XXXX-XXX-XXX"\r
                    />\r
                    <!-- Remove button (only show if more than 1 AIN) -->\r
                    @if (ains.length > 1) {\r
                      <button\r
                        type="button"\r
                        class="btn btn-secondary mt-1"\r
                        (click)="removeAin(i)"\r
                        >\r
                        - Remove\r
                      </button>\r
                    }\r
                  </div>\r
                }\r
                <!-- Add another AIN button -->\r
                <!-- [disabled]="!value?.trim()" disable add button -->\r
                <button type="button" class="btn btn-secondary mt-2" (click)="addAin()">\r
                  + Add another AIN\r
                </button>\r
              </div>\r
\r
              <!-- <p class="form-label"  style="margin-top: 20px;" >{{'ContactAssessor.Address'| translate}} <span class="color-red">*</span></p>\r
              <app-certificate-address\r
                [parentFormGroup]="contactForm"\r
                streetNumber="number"\r
                streetDirection="direction"\r
                streetName="street"\r
                streetType="type"\r
                unitNumber="unit"\r
                city="city"\r
                zipCode="zipCode"\r
\r
                >\r
              </app-certificate-address> -->\r
\r
              <p class="form-label" style="margin-top: 20px">\r
                TOPIC OF REQUEST<span class="color-red">*</span>\r
              </p>\r
              <div class="form-group">\r
                <select formControlName="topic" class="form-select">\r
                  <option selected value="">Select..</option>\r
                  <option>Unable to login</option>\r
                  <option>e-Services</option>\r
                  <option>No Situs Address Available for e-Notification</option>\r
                  <option>Incorrect Parcel Information</option>\r
                  <option>\r
                    Business Personal Property Statement 571-L/ Pin Reset/ Invalid Pin\r
                  </option>\r
                  <option>Others</option>\r
                </select>\r
                <div class="invalid-feedback" style="display: block">\r
                  @if (hasError('topic', 'required')) {\r
                    {{ "ContactAssessor.Required" | translate }}\r
                  }\r
                </div>\r
              </div>\r
\r
              @if (contactForm.get('topic')?.value === 'e-Services') {\r
                <div>\r
                  <p class="form-label" style="margin-top: 20px">\r
                    PLEASE SELECT ALL THAT APPLY<span class="color-red">*</span>\r
                  </p>\r
                  <div\r
                    class="form-group d-flex align-items-center gap-3"\r
                    formArrayName="eserviceChoices"\r
                    >\r
                    @for (option of eserviceOptions; track option; let i = $index) {\r
                      <div\r
                        class="form-check"\r
                        >\r
                        <input\r
                          class="form-check-input"\r
                          type="checkbox"\r
                          [formControlName]="i"\r
                          [id]="option.id"\r
                          (change)="onCheckboxChange(i)"\r
                          />\r
                          <label class="form-check-label" [for]="option.id">\r
                            {{ option.label }}\r
                          </label>\r
                        </div>\r
                      }\r
                    </div>\r
                  </div>\r
                }\r
\r
                <p class="form-label" style="margin-top: 20px">\r
                  {{ "ContactAssessor.Description" | translate }}\r
                </p>\r
                <div class="form-group">\r
                  <textarea\r
                    class="form-control"\r
                    formControlName="description"\r
                    id="inputDescription-General"\r
                    rows="4"\r
                    placeholder="Type here"\r
                  ></textarea>\r
                </div>\r
                <p class="form-label" style="margin-top: 20px">\r
                  PLEASE INCLUDE A SCREENSHOT OF THE ISSUE OR ERROR MESSAGE (FILE FORMATS\r
                  ACCEPTED: PDF, PNG, JPEG)\r
                </p>\r
                <div class="form-group">\r
                  <app-file-upload\r
                    formControlName="file"\r
                    [progress]="progress"\r
                  ></app-file-upload>\r
                  <div class="invalid-feedback" style="display: block">\r
                    @if (hasError('file', 'required')) {\r
                      {{ "ContactAssessor.Required" | translate }}\r
                    }\r
                    @if (hasError('file', 'requiredFileType')) {\r
                      Only PDF, Docx, PNG, JPEG\r
                    }\r
                    @if (hasError('file', 'requiredFileSize')) {\r
                      Size to exceeds 10 MB\r
                    }\r
                  </div>\r
                </div>\r
\r
                <div class="form-group" style="margin-top: 15px">\r
                  <app-captcha [form]="contactForm" captchaFieldName="recaptchaReactive"></app-captcha>\r
                  <div class="invalid-feedback" style="display: block">\r
                    @if (hasError('recaptchaReactive', 'required')) {\r
                      {{\r
                      "ContactAssessor.Required" | translate\r
                      }}\r
                    }\r
                  </div>\r
                </div>\r
\r
                <button type="submit" class="btn btn-primary mr-4" style="margin-top: 15px">\r
                  Submit</button\r
                  >@if (success) {\r
                  <span>Successfully Submitted</span>\r
                }\r
              </form>\r
            </div>\r
` }]
  }], () => [{ type: HttpClient }, { type: UntypedFormBuilder }, { type: ApiService }], null);
})();
