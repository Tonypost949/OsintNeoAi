`, styles: ['/* src/app/nav/nav.component.scss */\n.nav-toolbar {\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  background-color: #C7B473;\n  height: 100%;\n  padding-left: 5px;\n  padding-right: 5px;\n}\n.nav-toolbar a {\n  color: #043C5A;\n  text-transform: uppercase;\n  text-decoration: none;\n  padding-left: 20px;\n  padding-right: 20px;\n  cursor: pointer;\n}\n.nav-toolbar a:hover {\n  text-decoration: underline;\n}\n.nav-toolbar .dropdown-toggle::after {\n  display: none;\n}\n.toolbar-options-item {\n  display: inline-flex;\n  align-items: center;\n}\n.toolbar-options {\n  display: flex;\n  flex-direction: row;\n  gap: 10px;\n}\n@media only screen and (max-width: 650px) {\n  #lacounty-link {\n    display: none;\n  }\n  #search-icon {\n    display: none;\n  }\n  #language-icon {\n    display: none;\n  }\n  #account-icon {\n    display: none;\n  }\n  #leading-nav-separator {\n    display: none;\n  }\n  .toolbar-options {\n    width: 100%;\n    justify-content: space-between;\n  }\n}\n.navbar {\n  padding: 0;\n}\n.navbar-collapse {\n  padding: 0.5rem 1rem;\n}\n.upper-nav {\n  display: flex;\n  height: 45px;\n  background-color: #C7B473;\n  color: #043C5A;\n  text-transform: uppercase;\n  font-size: 0.8em;\n  align-items: center;\n  padding: 0 15px;\n  font-weight: 600;\n}\n.upper-nav a {\n  color: #043C5A;\n}\n.upper-nav .upper-nav-right {\n  margin-left: auto;\n}\n.upper-nav .translation {\n  padding: 0;\n}\n.upper-nav a {\n  text-decoration: none;\n}\n.upper-nav a[area-expanded=true] {\n  color: #fff;\n}\n.upper-nav a p:hover {\n  text-decoration: underline;\n}\n.upper-nav a {\n  cursor: pointer;\n}\n.upper-nav p {\n  margin: 0 20px;\n}\n.nav-separator {\n  border-left: 2px solid #043C5A;\n  height: 40px;\n}\n.nav-banner {\n  position: relative;\n  background-color: #043C5A;\n  display: flex;\n  justify-content: center;\n}\n.nav-banner .nav-items {\n  display: flex;\n  justify-content: center;\n}\n.nav-banner .nav-items .nav-img {\n  height: 100%;\n}\n.nav-banner .nav-items .nav-img img {\n  max-width: 1400px;\n  height: 100%;\n  height: auto;\n}\n.nav-banner .nav-items .nav-banner-line {\n  position: absolute;\n  background-color: #C7B473;\n  height: 5px;\n  width: 100%;\n  bottom: 10px;\n}\n.nav-banner .nav-icon {\n  position: absolute;\n  transform: translate(-50%, 60%);\n  font-size: 2em;\n}\n.nav-banner .nav-collapse-button {\n  display: none;\n}\n.navbar-menu {\n  text-transform: uppercase;\n  display: flex;\n  justify-content: space-between;\n  color: #043C5A;\n  padding: 0 10%;\n  font-weight: 600;\n  transition: border-bottom 3s ease;\n}\n.navbar-menu .btn-group {\n  position: static;\n}\n.mini-menu .fas {\n  display: none;\n}\n#inner-nav {\n  position: fixed;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n}\n#inner-nav a {\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  font-size: 1rem;\n  cursor: pointer;\n}\n#inner-nav li {\n  padding: 20px 10px;\n}\n.tiny-nav {\n  background-color: #C7B473;\n  color: #043C5A;\n  text-transform: uppercase;\n}\n.tiny-nav a {\n  color: #043C5A;\n  text-decoration: none;\n  font-size: 1rem;\n}\n.tiny-nav a:hover {\n  text-decoration: underline;\n}\n.tiny-nav .navbar-brand {\n  margin-left: 1rem;\n  font-size: 1rem;\n  cursor: pointer;\n}\n.tiny-nav .tiny-nav-items {\n  display: flex;\n  padding-left: 0;\n  margin-bottom: 0;\n  list-style: none;\n}\n.tiny-nav .tiny-nav-items .nav-item {\n  flex-grow: 1;\n  text-align: center;\n  width: 33vw;\n  max-width: 200px;\n}\n.tiny-nav .tiny-nav-items .nav-item .dropdown-menu {\n  border-radius: 0;\n  width: 33vw;\n  max-width: 200px;\n}\n.tiny-nav .tiny-nav-items .nav-item .dropdown-menu i {\n  margin-left: 8px;\n  margin-right: 8px;\n}\n.tiny-nav .tiny-nav-items .nav-item .dropdown-menu .dropdown-item {\n  font-weight: 500;\n  cursor: pointer;\n}\n.tiny-nav .tiny-nav-items li:last-child {\n  border-right: 2px solid #043C5A;\n}\n#languageDropDown {\n  background-color: transparent;\n}\n.nav-dropdown {\n  margin-top: 10px;\n}\nimg {\n  width: 100%;\n  height: auto;\n}\n.mega-menu {\n  left: 5% !important;\n  width: 80%;\n  padding: 20px;\n  border-radius: 0;\n  margin: 0;\n  background-color: #3165B1;\n  color: #fff;\n}\n.mega-menu .row {\n  width: 100%;\n}\n.mega-menu p {\n  margin: 0.5em;\n}\n.mega-menu h4 {\n  font-size: 1em;\n  text-transform: uppercase;\n  font-weight: 600;\n  margin-bottom: 1rem;\n}\n.mega-menu a {\n  font-size: 1em;\n  font-weight: 400;\n  color: #fff;\n  text-transform: initial;\n  text-decoration: none;\n}\n@media (min-width: 700px) {\n  .mini-contact {\n    left: auto !important;\n    right: 0% !important;\n    width: inherit;\n  }\n  .mini-contact p {\n    text-align: left;\n  }\n  .mini-news {\n    left: auto !important;\n    right: 36% !important;\n    width: inherit;\n  }\n  .mini-news p {\n    text-align: left;\n  }\n  .mini-about {\n    left: auto !important;\n    right: 6% !important;\n    width: inherit;\n  }\n  .mini-about p {\n    text-align: left;\n  }\n  .underline {\n    color: #043C5A;\n    text-decoration: none;\n    background: transparent;\n    padding-bottom: 0.2em;\n    border: none;\n    outline: none;\n    position: relative;\n    transition: 0.3s;\n    margin: 0 0.2em;\n  }\n  .underline:before {\n    content: "";\n    border-bottom: 2px solid #043C5A;\n    padding: 0 0px;\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    margin: 0 auto;\n    width: 0;\n    transition: 0.3s;\n  }\n  .underline:hover:before {\n    width: 100%;\n  }\n  .underline p {\n    margin: 0;\n    cursor: pointer;\n  }\n}\n.navbar-collapse .fas {\n  display: none;\n}\n@media only screen and (max-width: 700px) {\n  .tiny-nav .navbar-brand {\n    display: none;\n  }\n  .navbar-collapse .fas {\n    display: block;\n  }\n  a {\n    text-decoration: none;\n  }\n  .toggle-display {\n    display: none;\n  }\n  .navbar-menu {\n    padding: 0 0;\n  }\n  .navbar-menu .fas {\n    font