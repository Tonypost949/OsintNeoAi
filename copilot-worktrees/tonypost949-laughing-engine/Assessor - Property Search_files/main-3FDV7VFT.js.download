</div>\r
\r
\r
@if (parcel) {\r
  <div>\r
    <div class="row my-4 clearfix">\r
      <h4 class="p-md-3">{{parcel.DistrictOffice}}</h4>\r
    </div>\r
    <div class="row my-4">\r
      <div class="col-md-4 pr-md-3 clearfix">\r
        <p class="float-left"><strong>District</strong></p>\r
        <div>\r
          <p>{{parcel.DistrictOffice}}</p>\r
          <p class="border-item">{{parcel.OfficeStreet}}</p>\r
          <p>{{parcel.OfficeCity}} {{parcel.OfficeZipCode}}</p>\r
        </div>\r
      </div>\r
      <div class="col-md-4 pr-md-3">\r
        <p><strong>Phone:</strong> <span class="float-end">{{parcel.OfficePhone}}</span></p>\r
        <p class="border-item"><strong>Toll Free:</strong> <span class="float-end">{{parcel.OfficeTollFree}}</span></p>\r
        <p><strong>Hours:</strong> <span class="float-end">{{parcel.OfficeHours}}</span></p>\r
      </div>\r
      <div class="col-md-4 pr-md-3">\r
        <p><strong>Region:</strong> <span class="float-end">{{parcel.Region}}</span></p>\r
        <p class="border-item"><strong>Cluster:</strong> <span class="float-end">{{parcel.Cluster}}</span></p>\r
      </div>\r
    </div>\r
  </div>\r
}\r
