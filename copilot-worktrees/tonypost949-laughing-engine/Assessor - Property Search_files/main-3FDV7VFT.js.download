  <div #container class="segmented-control">\r
    <div class="indicator" [ngStyle]="indicatorStyle"></div>\r
    @for (option of options; track option; let i = $index) {\r
      <div\r
        class="segment"\r
        [class.selected]="selectedOption === option.label"\r
        (click)="onClickSegment(option.label)">\r
        <i [class]="option.icon" class="icon"></i>\r
        <p style="margin-bottom: 0; text-wrap: nowrap">{{ option.label }}</p>\r
      </div>\r
    }\r
  </div>\r
\r
  <div style="display: flex; flex-direction: row; gap: 10px; flex-grow: 1">\r
    @if (selectedOption === 'Address') {\r
      <input [(ngModel)]="search"\r
        typeaheadOptionField="SitusStreet"\r
        [typeahead]="parcels"\r
        [typeaheadAsync]="true"\r
        [typeaheadOptionsLimit]="5"\r
        [optionsListTemplate]="customListTemplate"\r
        (typeaheadOnSelect)="handleTypeheadOnSelect($event)"\r
        class="form-control custom-menu"\r
        placeholder="123 Main Street, Los Angeles CA, 90019">\r
    }\r
    @if (selectedOption === 'AIN') {\r
      <input class="form-control custom-menu" placeholder="001-002-003" [formControl]="ainFormControl" appNumericSplitter [splitterType]="SplitterType.AIN">\r
    }\r
\r
    <button class="btn btn-primary btn-assessor" style="white-space: nowrap" (click)="onClickAdd()" [disabled]="reachedParcelLimit">Add</button>\r
  </div>\r
</div>\r
\r
<ng-template #customListTemplate let-matches="matches" let-query="query" let-typeaheadTemplateMethods>\r
  <ul class="custom-list-group">\r
    @for (match of matches; track match) {\r
      <li\r
        class="custom-list-group-item"\r
        [class.active]="typeaheadTemplateMethods.isActive(match)"\r
        (click)="typeaheadTemplateMethods.selectMatch(match, $event)"\r
        (mouseenter)="typeaheadTemplateMethods.selectActive(match)"\r
        >\r
        {{ match.item.SitusStreet + ', ' +  match.item.SitusCity + ', ' +  match.item.SitusZipCode }}\r
      </li>\r
    }\r
  </ul>\r
</ng-template>\r
