        </ul>\r
      </div>\r
\r
\r
      <p>*<i>{{'NonProfit.TheseExemptions'|translate}}</i></p>\r
\r
      <p>{{'NonProfit.Pleasesee'|translate}}.</p>\r
\r
\r
      <p [innerHTML]="'NonProfit.Formorev2'|translate"></p>\r
      <!-- Major Exemptions<br>\r
      Phone: <b>(213) 974-3481</b><br>\r
      Email: <a href="mailto:exempt@assessor.lacounty.gov" target="_blank">exempt@assessor.lacounty.gov</a> -->\r
\r
\r
\r
\r
    </div>\r
