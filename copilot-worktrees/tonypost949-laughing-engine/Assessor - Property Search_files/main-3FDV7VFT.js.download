var Careers = {
  SearchTitle: "Career Opportunities",
  SearchDescription: "The Los Angeles County Assessor\u2019s Office is seeking talented and motivated individuals to fill a variety of positions across the department. We are proud to deliver award-winning public service while fostering career growth, professional development, and lifelong success. Join the nation\u2019s largest property assessment agency and make a difference in public service today.",
  TheLosAngeles: "<p>The Los Angeles County Assessor\u2019s Office is seeking talented and motivated individuals to fill a variety of positions across the department. We are proud to deliver award-winning public service while fostering career growth, professional development, and lifelong success. Join the nation\u2019s largest property assessment agency and make a difference in public service today. Below, you can:</p><ul><li>Explore current career opportunities</li><li>Sign up for the Assessor\u2019s Job Distribution List to be among the first notified of new openings</li><li>Learn how to create and prepare your online application profile through the County\u2019s system</li></ul><p>Stay connected and informed about upcoming opportunities, join our mailing list today to receive the latest updates about employment with the Assessor\u2019s Office.</p>",
  JobList: "Job Distribution List",
  OnlineJobAppSystem: "Online Job Application System",
  AppSystemDesc: "<p>Start preparing for your career with the Los Angeles County Assessor\u2019s Office today. Create your personalized online profile, which includes your contact information, education, and work history, so you\u2019re ready to apply as soon as the right opportunity becomes available.</p> <p>For guidance on how to build a strong profile and navigate the County\u2019s hiring system, visit the Los Angeles County Department of Human Resources website for helpful tips and application resources.</p>",
  AvailableOpportunities: "Available Opportunities",
  Browse: "Browse current job openings with the Los Angeles County Assessor\u2019s Office below. We encourage you to check back regularly, as new opportunities are posted as they become available."
};
