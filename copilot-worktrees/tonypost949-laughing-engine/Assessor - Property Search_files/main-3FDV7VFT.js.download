      </li>\r
\r
      @for (item of CategoryItems; track item) {\r
        <div>\r
          <li>\r
            <a (click)="currentCategory = item.categoryId" (click)="status=!status" [ngClass]="currentCategory === (item.categoryId) ? 'active-tab' : ''" >{{item.categoryName}}</a>\r
          </li>\r
        </div>\r
      }\r
\r
\r
    </ul>\r
\r
  </nav>\r
\r
\r
  <div id="content" style="display: flex; flex-direction: column; overflow-x: hidden;">\r
    @switch (statusPageState()) {\r
      @case (FormsListState.loading) {\r
        <app-loading-spinner/>\r
      }\r
      @case (FormsListState.loaded) {\r
        @for (item of forms | Categoryfilter: currentCategory | FormFilter: searchText; track item.fileId) {\r
          <app-form-list-row [formEntry]="item"></app-form-list-row>\r
        }\r
      }\r
      @case (FormsListState.error) {\r
        <div class="p-2" style="display: flex; align-items: center; justify-content: center; flex-direction: column; margin-bottom: 40px;">\r
          <h4 style="margin-bottom: 10px">Load Failed</h4>\r
          <button class="btn btn-primary btn-assessor" (click)="onClickRetry()">Retry</button>\r
        </div>\r
      }\r
    }\r
  </div>\r
</div>\r
\r
\r
\r
