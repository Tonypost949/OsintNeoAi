(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(LeveltwoComponent, [{
    type: Component,
    args: [{ selector: "app-leveltwo", standalone: false, template: `<div>\r
\r
  <tabset #staticTabs [ngClass]="{'d-none': !enable}">\r
    <tab id="GeneralInfo" (selectTab)="onTabClicked($event)" heading="{{'LV2Tabs.GeneralInfo'|translate}}">\r
      <ng-content select=".General"></ng-content>\r
    </tab>\r
\r
    @if (fact) {\r
      <tab id="FactSheet" (selectTab)="onTabClicked($event)" heading="{{'LV2Tabs.FactSheets'|translate}}" class="fact_tab">\r
        @if (loadingFactSheets) {\r
          <app-loading-spinner></app-loading-spinner>\r
        }\r
        @for (item of factSheets; track item) {\r
          <div class="list-group">\r
            <a href="{{item.fileUrl}}" target="_blank">\r
              <app-pdf-url-row>\r
                <h5 style="color: black">{{ item.title }}</h5>\r
              </app-pdf-url-row>\r
            </a>\r
          </div>\r
        }\r
      </tab>\r
    }\r
\r
    @if (faq) {\r
      <tab id="Faq" (selectTab)="onTabClicked($event)" heading="{{'LV2Tabs.FAQ'|translate}}">\r
        @if (loadingFaq) {\r
          <app-loading-spinner></app-loading-spinner>\r
        }\r
        @for (item of FaqData; track item) {\r
          <div class="faq_tab">\r
            <h5 [innerHTML]="item.question | safeHtml"></h5>\r
            <p [innerHTML]="item.answer | safeHtml"></p>\r
          </div>\r
        }\r
      </tab>\r
    }\r
\r
    @if (forms) {\r
      <tab id="Forms" (selectTab)="onTabClicked($event)" heading="{{'LV2Tabs.Forms'|translate}}" class="forms_tab">\r
        @if (loadingForms) {\r
          <app-loading-spinner></app-loading-spinner>\r
        }\r
        <app-form-list [forms]="formDetails"></app-form-list>\r
      </tab>\r
    }\r
\r
    @if (calculators) {\r
      <tab id="Calculators" (selectTab)="onTabClicked($event)" heading="{{'LV2Tabs.Calculator'|translate}}">\r
        <ng-content select=".Calculator"></ng-content>\r
      </tab>\r
    }\r
\r
    @if (videos) {\r
      <tab id="Videos" (selectTab)="onTabClicked($event)" heading="Videos">\r
        <ng-content select=".Videos"></ng-content>\r
      </tab>\r
    }\r
\r
    <!-- Unique to Disaster Relief Page --------------------------------->\r
    @if (notices) {\r
      <tab heading="Notices to property owners" >\r
        <ng-content select=".Notices"></ng-content>\r
      </tab>\r
    }\r
    <!-- ----------------------------------------------------------------- -->\r
\r
    @if (pastEvents) {\r
      <tab id="PastEvents" (selectTab)="onTabClicked($event)" heading="Past Events">\r
        <ng-content select=".past"></ng-content>\r
      </tab>\r
    }\r
\r
    @if (news) {\r
      <tab id="News" (selectTab)="onTabClicked($event)" heading="News">\r
        <ng-content select=".news"></ng-content>\r
      </tab>\r
    }\r
  </tabset>\r
\r
  @if (!enable) {\r
    <div style="width: 100%; position: relative; height: 50vh; z-index: 0; background-color: transparent;"\r
      class="inner-text">\r
      <ngx-spinner [fullScreen]="false" color="#fff" bdColor="transparent"\r
        type="ball-spin-fade-rotating" size="large">\r
      </ngx-spinner>\r
    </div>\r
  }\r
</div>\r
`, styles: ["/* src/app/leveltwo/leveltwo.component.scss */\n.faq_tab {\n  line-height: 1.4;\n}\n.faq_tab ul {\n  margin-left: 30px;\n}\n.faq_tab p {\n  line-height: 1.4;\n}\n.faq_tab p ul {\n  margin-left: 30px;\n}\n.faq_tab p table,\n.faq_tab p th,\n.faq_tab p td {\n  border: 1px solid black;\n}\n.button-download {\n  text-transform: uppercase;\n  background-color: #043C5A;\n  background-color: -webkit- #043C5A;\n}\n.forms_tab a,\n.fact_tab a {\n  text-decoration: none;\n}\n/*# sourceMappingURL=leveltwo.component-H6JR3ETE.css.map */\n"] }]
