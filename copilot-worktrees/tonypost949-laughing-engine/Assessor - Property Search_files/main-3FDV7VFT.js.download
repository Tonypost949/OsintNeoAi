  <app-banner type="warning"\r
    [header]="'Browser Disclaimer'"\r
  [message]="'This site is best viewed using the current browser version of Chrome, Microsoft Edge, or Firefox. Please avoid incognito mode.'"></app-banner>\r
  @if (formDetail && !userInfo) {\r
    <app-banner type="error"\r
      header="Not Logged In"\r
      message="You do not appear to be logged in. Please log in to continue." />\r
    }\r
  </div>\r
\r
  <!-- Initial loading indicator -->\r
  @if (formLoadState === FormLoadState.loading) {\r
    <div class="p-2" style="display: flex; align-items: center; justify-content: center; flex-direction: column">\r
      <app-loading-spinner/>\r
      <p style="color: black; margin-top: 10px">Loading the form...</p>\r
    </div>\r
  }\r
\r
  <!-- Main Form Info -->\r
  @if (formDetail && (formDetail.hasEFile || devMode)) {\r
    <div id="formTop">\r
      <app-progress-bar [progress]="formProgress"/>\r
\r
      <div style="display: flex; gap: 5px; padding-top: 5px; padding-bottom: 5px">\r
        <!-- Sidebar -->\r
        <div class="sidebar-container">\r
          <app-form-outline [outlineItems]="outlineItems" [outlineItemIndex]="outlineItemIndex"/>\r
        </div>\r
        <!-- Pages -->\r
        <div class="form-container">\r
          @for (formPage of formPages; track formPage.title) {\r
            <div class="efile-page"\r
              [hidden]="pageIndex !== $index"\r
              [@slideInOutAnimation]="pageIndex === $index ? 'in' : (pageIndex > $index ? 'outLeft' : 'outRight')">\r
\r
              <!-- Toolbar -->\r
              <div style="display: flex; justify-content: space-between">\r
                <app-assessor-button title="Return to Forms"\r
                  leadingIcon="fas fa-arrow-left"\r
                  tooltip="Clicking this option will return you to the list of forms."\r
                  (clickEvent)="handleReturnToFormsClicked(confirmReturnToForms)"/>\r
\r
                  <div style="display: flex; gap: 10px">\r
                    <app-assessor-button title="E-File Instructions"\r
                      leadingIcon="fa-brands fa-readme"\r
                      (clickEvent)="handleEFileInstructionsClicked()"/>\r
                      <app-assessor-button title="Open Preview"\r
                        leadingIcon="fa-regular fa-file-pdf"\r
                        (clickEvent)="handlePreviewClicked(pdfPreviewPopUp)"/>\r
                      </div>\r
                    </div>\r
                    <hr/>\r
\r
                    @if ($index === 0) {\r
                      @if (userInfo) {\r
                        <h2 style="color: #043c5a">Welcome {{ userInfo.lastName }}, {{ userInfo.firstName }} {{ userInfo.middleName }}</h2>\r
                      } @else {\r
                        <h2 style="color: #043c5a">Welcome</h2>\r
                      }\r
                      <p style="color: black">You are about to fill-out an online web-form.</p>\r
                      <hr>\r
                      }\r
\r
                      <h1 style="color: black">{{ formPage.title }}</h1>\r
\r
                      @for (control of formPage.controls; track control.element.id) {\r
                        @switch (control.element.type) {\r
                          @case ('template') {\r
                            <app-form-template-array [formGroup]="formPage.formGroup"\r
                              [control]="control"\r
                              [templates]="templates"\r
                              [controls]="controls"\r
                              [viewModel]="viewModel"/>\r
                            }\r
                            @case ('form_summary') {\r
                              <p style="color: black">Please review each form entry for correctness. If you need to make changes,\r
                              click the "Modify" button to return to that page in the form.</p>\r
                              @for (formPageSummary of formSummaries; track formPageSummary.title) {\r
                                <app-form-page-summary [pageSummary]="formPageSummary"\r
                                  (modifyButtonClicked)="handleModifyClicked($event)"/>\r
                                }\r
                              }\r
                              @case ('form_preview') {\r
                                <p style="color: black">Please review the form preview for correctness. After this point you will not be\r
                                  able to make changes. If you require changes after this point, you will need to start a new\r
                                submission.</p>\r
                                <app-form-preview [pdfFillJson]="previewJson()"/>\r
                              }\r
                              @case ('form_loading') {\r
                                <div style="display: flex; align-items: center; justify-content: center; flex-direction: column">\r
                                  <app-loading-spinner/>\r
                                  <p style="color: black; margin-top: 10px">We're generating the form now</p>\r
                                </div>\r
                              }\r
                              @case ('form_error') {\r
                                <p style="color: black; margin-top: 10px; margin-bottom: 0">Something went wrong generating the form.\r
                                Please click resubmit or make corrections and try again.</p>\r
                                <p style="color: red; margin-top: 0"><b>{{ eFileSubmissionError }}</b></p>\r
                                <div style="display: flex; align-items: center; justify-content: center; flex-direction: column">\r
                                  <div style="display: flex; flex-direction: column; gap: 10px">\r
                                    <app-assessor-button title="Resubmit Form"\r
                                      (clickEvent)="handleResubmitClicked()"/>\r
                                      <app-assessor-button title="Review Form"\r
                                        (clickEvent)="handleConfirmationClicked()"/>\r
                                      </div>\r
                                    </div>\r
                                  }\r
                                  @case ('signix_signature') {\r
                                    @if (!isSignixFrameLoading) {\r
                                      <p style="color: black">If you are unable to see the signature page below,\r
                                        click to <a id="fallbackSignixUrl" (click)="handleSignixTimeoutLinkClicked()">sign the document</a>.\r
                                        You can also sign the document from the <a href="/efile/status" target="_blank">Online Submission\r
                                      Status Page</a>.</p>\r
                                    }\r
                                    <!-- Show alert if mobile -->\r
                                    @if (formHelper.isMobileDevice()) {\r
                                      <alert type="info">\r
                                        <p class="m-3">If the pop up is blocked, please click to <a href="{{this.documentResponse?.url}}">sign\r
                                        the document</a></p>\r
                                      </alert>\r
                                    }\r
                                    <!-- Otherwise, show the desktop content -->\r
                                    @if (!formHelper.isMobileDevice() && !formHelper.isSafari()) {\r
                                      <div>\r
                                        @if (isSignixFrameLoading) {\r
                                          <div\r
                                            style="display: flex; align-items: center; justify-content: center; flex-direction: column">\r
                                            <app-loading-spinner/>\r
                                            <p style="color: black">Generating the signature page</p>\r
                                          </div>\r
                                        }\r
                                        <iframe [style.width]="isSignixFrameLoading ? '0%' : '100%'"\r
                                          style="overflow:hidden; height:100vh; border: none"\r
                                        [src]="this.documentResponse?.url | SafeUrl" (load)="onSignixFrameLoad()"></iframe>\r
                                      </div>\r
                                    }\r
                                  }\r
                                  @default {\r
                                    <app-dynamic-control [formGroup]="formPage.formGroup"\r
                                      [control]="control"\r
                                      [viewModel]="viewModel"\r
                                    [controlCache]="controls"></app-dynamic-control>\r
                                  }\r
                                }\r
                              }\r
\r
                              @if ($index === 0) {\r
                                <div class="mt-5" style="display: flex; justify-content: flex-end; align-items: center; gap: 10px">\r
                                  <app-assessor-button title="View the Form"\r
                                    (clickEvent)="handleDownloadFormClicked()"/>\r
                                    <p style="color: black; margin-bottom: 0">OR</p>\r
                                    <app-assessor-button title="Start Online Submission"\r
                                      trailingIcon="fas fa-arrow-right"\r
                                      [isDisabled]="eFileDisabled || !userInfo"\r
                                      [tooltip]="eFileDisabledToolTip"\r
                                      (clickEvent)="handleNextClicked()"/>\r
                                    </div>\r
                                  }\r
\r
                                  <!-- Navigation pages -->\r
                                  @if ($index > 0 && formPage.hasNavButtons) {\r
                                    <div class="mt-5" style="display: flex; flex-direction: column;">\r
                                      <hr/>\r
                                      <div style="display: flex; flex-direction: column; gap: 10px">\r
                                        <!-- Nav buttons -->\r
                                        <div style="display: flex; align-items: center; justify-content: center; gap: 10px">\r
                                          <app-assessor-button title="Previous"\r
                                            leadingIcon="fa-solid fa-chevron-left"\r
                                            [isDisabled]="doesNotHavePrevious()"\r
                                            (clickEvent)="handlePreviousClicked()"/>\r
                                            <p style="margin-bottom: 0; color: black">Page {{ outlineItemIndex + 1 }}\r
                                            of {{ outlineItems.length }}</p>\r
                                            <!-- Conditionally style next button based on the current page -->\r
                                            @if (formPage.type === 'form_preview') {\r
                                              <app-assessor-button buttonType="submit"\r
                                                title="Submit Form"\r
                                                trailingIcon="fa-regular fa-paper-plane"\r
                                                [isDisabled]="eFileDisabled"\r
                                                [tooltip]="eFileDisabledToolTip"\r
                                                (clickEvent)="handleConfirmSubmissionClicked(finalConfirmationPopUp)"/>\r
                                              } @else {\r
                                                <app-assessor-button title="Next"\r
                                                  trailingIcon="fa-solid fa-chevron-right"\r
                                                  [isDisabled]="eFileDisabled || !userInfo"\r
                                                  [tooltip]="eFileDisabledToolTip"\r
                                                  (clickEvent)="handleNextClicked()"/>\r
                                                }\r
                                              </div>\r
                                              @if (hasReturnToConfirmation) {\r
                                                <div style="display: flex; align-items: center; justify-content: center;">\r
                                                  <app-assessor-button title="Return to Confirmation"\r
                                                    leadingIcon="fa-regular fa-rectangle-list"\r
                                                    (clickEvent)="handleReturnBack()"/>\r
                                                  </div>\r
                                                }\r
                                              </div>\r
                                            </div>\r
                                          }\r
\r
                                          @if (pageHasFormHints()) {\r
                                            <ng-container class="mt-5">\r
                                              <hr>\r
                                                <app-form-faq [formPage]="formPages[pageIndex]"></app-form-faq>\r
                                              </ng-container>\r
                                            }\r
                                          </div>\r
                                        }\r
                                      </div>\r
                                    </div>\r
                                  </div>\r
                                }\r
\r
                                <ng-template #genericAlert>\r
                                  @if (viewModel.modalAlertMessage) {\r
                                    <div\r
                                      style="display: flex; flex-direction: column; padding: 10px; gap: 5px; background: ghostwhite">\r
                                      <h1 class="modalHeaderText">{{ viewModel.modalAlertMessage.title }}</h1>\r
                                      <div style="color: black; text-align: center" [innerHTML]="viewModel.modalAlertMessage.message"></div>\r
                                      <app-assessor-button title="Close" (clickEvent)="modalRef.hide()"/>\r
                                    </div>\r
                                  }\r
                                </ng-template>\r
                                <ng-template #confirmReturnToForms>\r
                                  <div\r
                                    style="display: flex; flex-direction: column; align-items: center; padding: 10px; gap: 5px; background: ghostwhite">\r
                                    <h1 class="modalHeaderText">Return to Forms</h1>\r
                                    <p style="color: black">If you click "Confirm Return to Forms" you will lose any unsaved form progress.</p>\r
                                    <div style="display: flex; flex-direction: column; gap: 5px">\r
                                      <app-assessor-button buttonType="cancel"\r
                                        title="Confirm Return to Forms"\r
                                        (clickEvent)="handleConfirmReturnToFormsClicked()"\r
                                        style="width: 100%"/>\r
                                        <app-assessor-button title="Stay on e-File"\r
                                          (clickEvent)="modalRef.hide()"\r
                                          style="width: 100%"/>\r
                                        </div>\r
                                      </div>\r
                                    </ng-template>\r
                                    <ng-template #pdfPreviewPopUp>\r
                                      <div style="display: flex; flex-direction: column; padding: 10px; gap: 5px; background: ghostwhite">\r
                                        <app-form-preview [pdfFillJson]="previewJson()"/>\r
                                        <app-assessor-button title="Close Preview"\r
                                          (clickEvent)="modalRef.hide()"/>\r
                                        </div>\r
                                      </ng-template>\r
                                      <ng-template #finalConfirmationPopUp>\r
                                        <div style="padding: 20px; display: flex; flex-direction: column; gap: 5px; background: ghostwhite">\r
                                          <h2 style="color: black; text-align: center">Confirm Submission</h2>\r
                                          <p style="color: black">You are about to submit a form. After clicking Submit Form, you will be unable to make\r
                                          changes. If you need to make changes after this point, you will need to start a new submission.</p>\r
\r
                                          <div style="display: flex; flex-direction: column; align-items: center; gap: 5px">\r
                                            <app-assessor-button buttonType="submit"\r
                                              title="Submit Form"\r
                                              (clickEvent)="handleSubmissionConfirmedClicked()"\r
                                              style="width: 50%"/>\r
                                              <app-assessor-button title="Return to Form Review"\r
                                                (clickEvent)="modalRef.hide()"\r
                                                style="width: 50%"/>\r
                                              </div>\r
                                            </div>\r
                                          </ng-template>\r
