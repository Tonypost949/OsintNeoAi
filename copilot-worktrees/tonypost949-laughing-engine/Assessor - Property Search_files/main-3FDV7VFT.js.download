  PublicMaintenance: "Important Notice: Website Maintenance",
  Dueto: "Due to the COVID-19 Pandemic, all County Buildings remain closed to the public until further notice.",
  AllAssessorV2: 'All Assessor services remain available to the public via our contact form or by phone at <strong>(213) 974-3211</strong>. These safer options continue to provide the highest level of Assessor services during this public health challenge. Questions about tax payments or bills are directed to the Treasurer and Tax Collector at <a href="https://ttc.lacounty.gov" target="_blank">ttc.lacounty.gov</a> . Thank you for your cooperation and patience.',
  EffectiveV2: "All Assessor Offices are open to the public from 8:00am \u2013 5:00pm for limited in-person services.",
  EffectiveV3: "Assessor Offices will be open to the public from 8:00am - 5:00pm for limited in-person services, except for the West District which remains closed until further notice.",
  EffectiveV6: "Assessor Offices will be open to the public from 8:00am - 5:00pm for limited in-person services, except for the West District which remains closed until further notice. Public services for the West District are temporarily moved to the Hall of Administration, Room 225. <i>Room 183-19 (mailing address)</i>",
  EffectiveV7: "Assessor Offices will be open to the public from 8:00am - 5:00pm, except for the West District which remains closed until further notice. Public services for the West District are temporarily moved to the Hall of Administration, Room 225. <i>Room 183-19 (mailing address)</i>",
  Taxes: '<strong>Property tax payments will NOT be accepted at any Assessor location.</strong> Questions about tax payments or bills are directed to the Treasurer and Tax Collector at <a href="https://ttc.lacounty.gov" target="_blank">ttc.lacounty.gov</a>',
  Theofficeofv4: 'Online services remain available to the public via our <a href="https://assessor.lacounty.gov/contact/assessor" target="_blank">contact form</a> or by phone at <strong>(213) 974-3211</strong>.',
  Propertytaxpayments2: '<strong>Property tax payments will NOT be accepted at any Assessor location. For tax payments please visit the Treasurer and Tax Collector at <a href="https://ttc.lacounty.gov/" target="_blank">ttc.lacounty.gov</a>.</strong>',
  Prop5818_title2: "The Assessor's Office is currently experiencing significant delays on Prop. 58 and Prop. 19 claims.",
  Prop5819_body: 'We are committed to the fair and equitable treatment for all taxpayers and are proactively contacting applicants before any determinative deadline approaches. Prop. 19 and the corresponding implementation deadlines provided significant operational and administrative challenges leading to processing delays. We apologize for the inconvenience many homeowners are facing. As we work to streamline Prop. 19 claims, many questions can be answered <a href="https://assessor.lacounty.gov/exclusions/prop19" target="_blank">here</a> or by <a href="mailto:prop19inquiry@assessor.lacounty.gov" target="_blank">email</a>.',
  "Maintenance7/18/24": '<Strong>Please be advised that from 5:00pm PST Friday, July 19th through 8:00am PST Monday, August 5th, our Constituent Registration Services for e-File and e-Notification will be temporarily unavailable.</strong> During this period, our website will undergo essential maintenance to enhance and improve our services for the benefit of all property owners. All other website functions including access to the <a href="https://portal.assessor.lacounty.gov/" target="_blank">Assessor Portal</a> will be unaffected.<br><br>We apologize for any inconvenience this may cause and greatly appreciate your patience and understanding. We are committed to providing you with the best possible service and look forward to resuming regular website operations with improved features.<br><br>Assessor Offices will be open to the public from 8:00am to 5:00pm, except for the West District which remains closed until further notice. Public services for the West District are temporarily moved to the Hall of Administration, Room 225. Room 183-19 (mailing address)<br><br>Online services remain available to the public via our <a href="https://assessor.lacounty.gov/contact/assessor">contact form</a> or by phone at <strong>(213) 974-3211</strong>.',
  Wearepleased: "<strong>We are pleased to announce the opening of the Los Angeles County Assessor's new West Regional Office.</strong> Starting Monday, September 16, 2024, the office will be open to the public Monday through Friday from 8:00am to 5:00pm (except County holidays) at the following location:",
  Ournewoffice: "Our new office is dedicated to serving the community with all property assessment needs. We look forward to welcoming you to our new location, where our team will be available to assist you with any inquiries or services related to property assessments.",
  Viewalloffice: 'View all <a href="/contact/officelocations">office locations</a> and <a href="/contact/district-office">find your assigned district office.</a>',
  LargeCrowds: '<strong>Due to anticipated large crowds and traffic disruptions related to the World Series Parade, the Kenneth Hahn Hall of Administration will be closed to the public on Friday, November 1st.</strong> Property owners needing assistance may visit one of our <a href="/contact/officelocations">district or regional offices</a> or access services through our website.',
  WeApologize: "We apologize for any inconvenience and thank you for your understanding.",
  UpdatesProp19: "Updates on Proposition 19",
  ImportantNoticeDVX: "Important Notice for Property Owners: Disabled Veterans' Exemption Update",
  DVXNoticeBody: `The Los Angeles County Assessor\u2019s Office is aware of an internal computer system issue that may affect property tax bills for property owners who qualified for and received the <a href="https://assessor.lacounty.gov/exemptions/disabled-veterans" target="_blank">Disabled Veterans' Exemption</a>. Due to this issue, the exemption may not appear on the\xA0current\xA0property tax bill for some accounts.<br><br>Please fill out a <a href="https://ttc.lacounty.gov/penalty-cancellation-request-2/" target="_blank">penalty cancellation request form</a> on the Treasurer and Tax Collector\u2019s website\xA0if you have not received the corrected bill before the 1st\xA0installment due date.\xA0 Indicate \u201CDisabled Veteran Exemption Pending\u201D on the claim.<br><br>We sincerely apologize for any inconvenience or concern this may cause. Please be assured that our team is actively working to resolve the issue and reapplying\xA0the exemption to all affected properties as quickly as possible.`,
  "NorthDistrict1/8/25": "The Assessor\u2019s North District Office located at 13800 Balboa Boulevard in Sylmar will be closed Wednesday, January 8, 2025, through Friday, January 10, 2025, due to hazardous wind conditions.",
  "AllOffices1/8/25": "All Assessor\u2019s Office locations will be closed on Thursday, January 9, 2025, in observance of Los Angeles County\u2019s Day of Mourning honoring President James Earl Carter Jr.  Services will resume on Friday, January 10, 2025.",
  ImportantNoticeOfficeClosures: "Important Notice: Office Closures",
  Toensure: "To ensure the safety of our employees and the public, effective immediately, all in-person operations at Assessor offices will cease through Friday, January 10th. All in-person operations will resume on Monday, January 13th.",
  "Misfortune&Calamityv4": `<p>The Los Angeles County Assessor's Office is actively assisting property owners impacted by the 2025 wildfires. If your property was damaged or destroyed, you may qualify for immediate property tax relief. Visit the <a href="https://assessor.lacounty.gov/tax-relief/disaster-relief" target="_blank">Disaster Relief</a> page for additional information.</p><p>Property owners unable to make timely property tax payments due to wildfire impacts may submit a <strong>Request for Penalty Cancellation</strong> with the Treasurer and Tax Collector (TTC). Visit the <a href="https://ttc.lacounty.gov/deadline-for-fire-impacted-property-owners-to-make-payments-is-april-30/" target="_blank">TTC website</a> for additional information.</p>`,
  PowerOutageNorthDistrict: "<p><strong>Due to a power outage, the Assessor\u2019s North District Office located at 13800 Balboa Boulevard Sylmar, CA 91342 will be closed for the remainder of the day, Friday, November 21, and no in-person services will be available. Services are expected to resume on Monday, November 24.</strong></p>",
  OfficeDodgerCloser: '<p>Due to the Los Angeles Dodgers victory parade and the related road closures in downtown Los Angeles, our downtown Headquarters located at the <strong>Kenneth Hahn Hall of Administration</strong> will be closed on <strong>Monday, November 3rd</strong>. We will resume normal business operations on Tuesday, November 4th. Property owners are encouraged to visit their assigned regional office to receive in-person service. Find all office locations <a href="https://assessor.lacounty.gov/contact/officelocations" target="_blank">here</a>.</p>',
  Relieffor: "Relief for Properties Impacted By A Disaster",
  TheSEIU: "The Service Employees International Union (SEIU), Los Angeles County\u2019s largest union, has announced a planned three-day strike beginning at 7:00 p.m. on Monday, April 28, 2025, and concluding at 6:59 p.m. on Wednesday, April 30, 2025.",
  WhiletheLACAssessor: "While the Los Angeles County Assessor\u2019s Office cannot predict the full extent of potential service disruptions, members of the public may experience longer wait times at the Hall of Administration (HOA) and delays in phone response times during the strike period.",
  OneStop: "The One-Stop Shop public service counter on the first floor of the HOA will remain open.",
  Allother: "All other HOA public service counters will be closed on Tuesday, April 29, and Wednesday, April 30.",
  District: 'District, Regional, and Satellite offices will remain open but may also experience service delays, including longer counter wait times and slower phone response times. We encourage the public to use our online resources and create an <a href="https://assessorsso.assessor.lacounty.gov/csr?backUrl=https%3A%2F%2Fassessor.lacounty.gov%2Flogin" target="_blank">e-Service Account</a>.',
  ImportantNoticeOperations: "Important Notice: Assessor's Office Operations",
  TemporaryClosureJune92025v2: "Temporary Closure of In-Person Services",
  ClosuresLanguagejun62025: '<p>The Los Angeles County Assessor\u2019s Office will temporarily suspend in-person services on <strong>Monday, June 9 and Tuesday, June 10</strong> in response to reports of large-scale demonstrations expected in Grand Park and the Downtown Los Angeles area. This step is being taken out of an abundance of caution to ensure the safety of the public and our staff.</p><p><strong>In-person services are expected to resume on Wednesday, June 11.</strong></p><p>Property owners who need assistance may continue to access services online:<ul><li>Submit an inquiry via our <strong>Contact Form</strong>: <a href="https://assessor.lacounty.gov/contact/assessor" target="_blank">https://assessor.lacounty.gov/contact/assessor</a></li><li>Reach out directly using our <strong>Office Directory</strong>: <a href="https://assessor.lacounty.gov/contact/directory" target="_blank">https://assessor.lacounty.gov/contact/directory</a></li></ul></p><p>We appreciate your understanding and look forward to continuing to serve you.</p>',
  ClosuresLanguagejun112025: `<p>The Los Angeles County Assessor's Office will only have the One-Stop open (Wed/Thurs 8am-2pm and Fri 8am-12pm). All other Assessor public counters will remain closed for the rest of the week.</p><p>Property owners who need assistance may continue to access services online:<ul><li>Submit an inquiry via our <strong>Contact Form</strong>: <a href="https://assessor.lacounty.gov/contact/assessor" target="_blank">https://assessor.lacounty.gov/contact/assessor</a></li><li>Reach out directly using our <strong>Office Directory</strong>: <a href="https://assessor.lacounty.gov/contact/directory" target="_blank">https://assessor.lacounty.gov/contact/directory</a></li></ul></p><p>We appreciate your understanding and look forward to continuing to serve you.</p>`,
  NoticeOfLimited: "Notice of Limited Operations at Hall of Administration",
  ClosureLanguage: `<p>The Los Angeles County Assessor's Office public counters at the <strong>Hall of Administration</strong>, including the One-Stop location, will operate on the following modified schedule through Friday, June 20th:<ul><li><strong>8:00 a.m. \u2013 2:00 p.m.</strong></li></ul></p><p><strong>Please note</strong>: All <strong>District and Regional Offices remain open</strong> and are operating as usual.</p><p>Property owners seeking assistance may continue to access our services online:<ul><li>Submit an inquiry via our <strong>Contact Form</strong>: <a href="https://assessor.lacounty.gov/contact/assessor" target="_blank">https://assessor.lacounty.gov/contact/assessor</a></li><li>Reach out directly using our <strong>Office Directory</strong>: <a href="https://assessor.lacounty.gov/contact/directory" target="_blank">https://assessor.lacounty.gov/contact/directory</a></li></ul></p><p>We appreciate your understanding and remain committed to serving you.</p>`,
  "AMPMaintenance6-26-2025": "<p>Please be advised that due to scheduled maintenance and final production of the 2025 Assessment Roll, <strong>Assessor e-Service account access will be unavailable from Thursday, June 26, 2025, through Tuesday, July 8, 2025.</strong></p><p>During this time:<ul><li>Existing users will not be able to log in to their accounts.</li><li>New users will not be able to register or create new accounts.</li></ul>We apologize for any inconvenience and appreciate your patience as we complete this important annual process.</p><p><strong>Full access will resume after the maintenance period.</strong></p>",
  TemporarySuspensionofEservice: "Assessor e-Services Temporarily Unavailable Due to Scheduled Maintenance",
  TemporarySuspensionofEserviceDesc: "<b>Please be advised that due to scheduled maintenance, our Assessor e-Services will be temporarily unavailable starting today, Friday, September 12, 2025, 5 PM through Sunday, September 14, 2025, 12 PM for essential system maintenance aimed at improving and enhancing our services for all property owners.</b><br><br>During this time:<ul><li>Existing users will not be able to log in to their accounts.</li><li>New users will not be able to register or create new accounts.</li></ul>We apologize for any inconvenience and appreciate your patience as we work to serve you better.",
  TemporaryClosureEast: "Temporary Closure Notice \u2013 East District Office",
  EastClosureMessage: '<p>Due to unforeseen facilities issues, the <strong>East District Office located at 1190 Durfee Avenue, South El Monte, CA 91733</strong> will be <strong>temporarily closed until Monday, July 14, 2025</strong>, to allow for necessary repairs.</p><p>We apologize for the inconvenience and appreciate your patience during this time.</p><p><strong>Need immediate assistance?</strong><ul><li>Submit a <a href="https://assessor.lacounty.gov/contact/assessor" target="_blank">Contact Form</a></li><li>Or <a href="https://assessor.lacounty.gov/contact/appointment" target="_blank">Schedule an Appointment</a></li></ul></p><p>Thank you for your understanding.</p>',
  WestClosureMessagev3: "<p><strong>Due to an unexpected emergency facility issue, in-person services at the Los Angeles County Assessor\u2019s West Regional Office will be unavailable.</strong></p><p>We apologize for any inconvenience this may cause and encourage property owners to use our online services or contact our office by phone at (310) 665-5300 for assistance during this time.</p><p>Normal in-person operations at the West Regional Office are expected to resume on Monday, October 6.</p><p>Thank you for your understanding and patience.</p>",
  Thanksgiving: "Observance of Thanksgiving Holiday",
  ThanksgivingHoliday: "All Los Angeles County Assessor offices will be <strong>closed on Thursday, November 27, and Friday, November 28</strong> in observance of the Thanksgiving holiday. <strong>Regular operations will resume on Monday, December 1.</strong><br><br>Thank you for your understanding, and we wish you a safe and happy holiday.",
  NoticeofModifiedHours122225v2: "Notice of Office Closures",
  ModifiedHours122225v2: "<p>Due to storm reports and anticipated flooding conditions, all Assessor Office locations will be closed beginning today Tuesday, December 23rd through Thursday, December 24.</p><p>These adjustments are being made out of an abundance of caution to help ensure the safety of the public and County employees.</p><p>We appreciate the public\u2019s understanding and encourage property owners to utilize online services during this time. Regular operations are expected to resume on Friday, December 26.</p>",
  NewYear2025: "<p>Due to the New Year's Eve Celebration in Grand Park, Assessor's Office public counters at the Kenneth Hahn Hall of Administration, located at 500 W. Temple Street, will close at 3:00 pm on Wednesday, December 31.\xA0 The One-Stop public service counter on the 1st floor will remain open until 5:00 pm.\xA0 The Assessor's Office's District and Regional Office locations will maintain regular public service hours.</p><p>All Assessor's Office locations will be closed on Thursday, January 1. \xA0Regular operations are expected to resume on Friday, January 2.</p><p>We appreciate the public's understanding and encourage property owners to utilize our online services during this time.</p>",
  OfficeClosure021626: "<p><strong>All Assessor offices closed Monday, Feb 16 (Presidents Day)</strong></p><ul><li><strong>Scheduled Maintenance: Assessor Homeowner Alert Service unavailable Feb 13, 5 p.m. \u2013 Feb 16, 7 a.m.</strong></li><li><strong>e-File Online Service unavailable Feb 13, 5 p.m. \u2013 Feb 14, 1 p.m.</strong></li><li><strong>Exemptions: e-File before or after maintenance or mail by Feb 15 (postmarked).</strong></li></ul>",
  "TemporaryRelocation:": "Temporary Relocation Notice - North District Public Services",
  EffectiveMar262026: "<strong>Effective March 26, 2026, our North District office has temporarily relocated.</strong><br>You can continue to access services in the way that's easiest for you:",
  Weapologize: "We apologize for any inconvenience and appreciate your patience. Our team is ready to assist you quickly and efficiently at the temporary location, by phone, or online.",
  Important: '<p><strong>Important:</strong><br>Please contact the North District office <strong>only if your inquiry involves a property located within the North District.</strong></p><p>To ensure you receive the fastest and most accurate assistance:<br><ul><li>Find your assigned district office here:<br><a href="https://assessor.lacounty.gov/contact/district-office" target="_blank">https://assessor.lacounty.gov/contact/district-office</a></li><li>Submit an inquiry to the appropriate division here:<br><a href="https://assessor.lacounty.gov/contact/assessor" target="_blank">https://assessor.lacounty.gov/contact/assessor</a></li></ul></p>',
  EffectiveMarch262026: '<p><strong>Effective March 26, 2026, our North District - Sylmar office has closed.</strong></p><p>North District Public Services and Operations have temporarily moved to our Headquarters location in Downtown Los Angeles. Our team is ready to assist you quickly and efficiently at the temporary location, by phone, or online.</p><p><strong>Visit the Contact Us resource pages below for more information:</strong><br><a href="https://assessor.lacounty.gov/contact/officelocations" target="_blank">Office Locations</a> | <a href="https://assessor.lacounty.gov/contact/assessor" target="_blank">Submit an Inquiry Online</a> | <a href="https://assessor.lacounty.gov/contact/appointment" target="_blank">Schedule an Appointment</a></p><p>We apologize for any inconvenience and appreciate your patience while we work to bring in-person services back to the North region.</p>',
  SuspensionofAlertv2: "<p>Please be advised that due to scheduled system maintenance and final production of the 2026 Assessment Roll, the Assessor's <strong>Homeowner Alert e-Notification Program</strong> will be temporarily unavailable from <strong>June 24 through July 6, 2026</strong>.</p><p>During this time:<ul><li>Homeowner Alert subscribers may experience delays in receiving property transaction notifications.</li><li>New users will not be able to enroll in the Homeowner Alert Program.</li></ul></p><strong>Assessor e-File services will remain available during the maintenance period.</strong><p>We anticipate restoring Homeowner Alert functionality by July 6; however, services may resume earlier if maintenance activities are completed ahead of schedule.</p>",
  SuspensionofAlertNotice: "Temporary Suspension of Homeowner Alert Notifications"
};
