                        <input class="mr-3" formControlName="divormandc" value="Yes" name="divormandc" type="radio">\r
                        <label class="form-check-label">Yes</label>\r
                      </div>\r
\r
                      <div class="col-auto">\r
                        <input class="mx-3" formControlName="divormandc" value="No"  name="divormandc"  type="radio">\r
