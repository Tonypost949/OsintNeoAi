            <li>{{'ADU.generalJadu6'|translate}}</li>\r
          </ul>\r
        </div>\r
      </div>\r
\r
      <div class="accordion">\r
        <accordion [isAnimated]="true" >\r
        <accordion-group #drop [isOpen]="false">\r
          <div accordion-heading >\r
            <span class="dropdown-item clearfix">\r
              {{'ADU.Updates'|translate}} <i class="mt-1 float-end" [ngClass]="!drop.isOpen ? 'fas fa-plus' : 'fas fa-minus'"></i>\r
            </span>\r
          </div>\r
\r
            <strong>SB 9 (2021)</strong><br>\r
            {{'ADU.MultipleUnits'|translate}}<br>\r
            <ul>\r
              <li>{{'ADU.Without'|translate}}</li>\r
              <li>{{'ADU.With'|translate}}</li>\r
