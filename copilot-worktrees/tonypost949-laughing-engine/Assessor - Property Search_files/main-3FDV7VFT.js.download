  <nav id="toolbar" class="nav-toolbar">\r
    <a id="lacounty-link" href="https://lacounty.gov">lacounty.gov</a>\r
    <div id="toolbar-options" class="toolbar-options">\r
      <div id="leading-nav-separator" class="nav-separator"></div>\r
      <div id="language-selector" class="toolbar-options-item" ngbDropdown #myDrop="ngbDropdown">\r
        <a ngbDropdownToggle aria-expanded="false">\r
          Language\r
          <i id="language-icon" class="fa-solid fa-language"></i>\r
        </a>\r
        <div class="dropdown-menu" ngbDropdownMenu>\r
          @for (item of languages; track item) {\r
            <div>\r
              <a ngbDropdownItem class="dropdown-item" style="margin-left: 10px" (click)="changeLang(item.code, myDrop); myDrop.close()"> {{item.name}}</a>\r
              <div class="dropdown-divider"></div>\r
            </div>\r
          }\r
        </div>\r
      </div>\r
      <div class="nav-separator"></div>\r
      <div id="search" class="toolbar-options-item">\r
        <a aria-label="Search" routerLink="/search">{{"NavMenu.Search" | translate}} <i id="search-icon"class="fas fa-search"></i></a>\r
      </div>\r
      <div class="nav-separator"></div>\r
      <div id="account-dropdown" class="toolbar-options-item" ngbDropdown #myDrop="ngbDropdown">\r
        @if (siteConfigService.isProfilePageDisabled()) {\r
          <a role="button"\r
            class="nav-link dropdown-toggle disabled-link"\r
            data-toggle="dropdown"\r
            aria-expanded="false"\r
            [ngbPopover]="siteConfigService.getProfileMaintenanceMessage()">\r
            My Account <i class="fas fa-user-circle"></i>\r
          </a>\r
        } @else {\r
          <a ngbDropdownToggle role="button" data-toggle="dropdown" aria-expanded="false">\r
            My Account <i id="account-icon"class="fas fa-user-circle"></i>\r
          </a>\r
        }\r
\r
        <div class="dropdown-menu" ngbDropdownMenu>\r
          @if (!loggedIn) {\r
            <div >\r
              <a ngbDropdownItem class="dropdown-item" [href]="envService.loginUrl"><i class="fa-sharp fa-solid fa-user"></i> REGISTER</a>\r
              <div class="dropdown-divider"></div>\r
              <a ngbDropdownItem class="dropdown-item" (click)="login()"><i class="fas fa-sign-in"></i> SIGN IN</a>\r
            </div>\r
          }\r
          @if (loggedIn) {\r
            <div>\r
              <a ngbDropdownItem class="dropdown-item" [href]="envService.profileUrl" target="_blank"><i class="fa-sharp fa-solid fa-user"></i> Profile</a>\r
              <div class="dropdown-divider"></div>\r
              <a ngbDropdownItem class="dropdown-item" aria-label="eFile status" routerLink="efile/status"><i class="fa-solid fa-clipboard-list"></i> Status</a>\r
              <div class="dropdown-divider"></div>\r
<!--              <a ngbDropdownItem class="dropdown-item" routerLink="efile/enotification"><i class="fa-solid fa-bell"></i> eNotification</a>-->\r
<!--              <div class="dropdown-divider"></div>-->\r
              <a ngbDropdownItem class="dropdown-item" [href]="envService.logoutUrl"><i class="fa-sharp fa-solid fa-right-from-bracket"></i> SIGN OUT</a>\r
            </div>\r
          }\r
        </div>\r
      </div>\r
    </div>\r
  </nav>\r
\r
  <div class="nav-banner">\r
    <div #toggleButton class="nav-collapse-button" [ngClass]="{'menu-icon': isCollapsed, 'close-icon': !isCollapsed}"  data-toggle="collapse" (click)="clicked()" [attr.aria-expanded]="!isCollapsed" data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-label="Toggle navigation">\r
      <!-- <i  *ngIf="isCollapsed" class="fas fa-bars text-blue nav-icon"></i>\r
      <i  *ngIf="!isCollapsed" class="fas fa-times text-blue nav-icon"></i> -->\r
    </div>\r
    <div class="nav-items w-100">\r
      <div class="nav-img">\r
        <img style="" src="https://res.cloudinary.com/los-angeles-county-assessor/image/upload/v1624312500/News/header.webp" alt="">\r
