<form #form="ngForm" autocomplete="off" (ngSubmit)="submit()" class="search-bar" style="padding-top: 20px; padding-bottom: 20px">\r
  <div class="input-group">\r
    <span class="input-group-text">\r
      <i class="fas fa-search"></i>\r
    </span>\r
    <input [(ngModel)]="searchText" autocomplete="off" (ngModelChange)="searchEvent($event)" name="search" type="text" class="form-control" placeholder="Search Website" aria-label="Search Col" aria-describedby="addon-wrapping">\r
    <span (click)="searchText = ''" class="input-group-text" id="basic-addon2">\r
      <i class="fas fa-times"></i>\r
    </span>\r
  </div>\r
</form>\r
\r
@if (searchText) {\r
  <div id="" class="row m-3">\r
    <p>{{'Search.Results' | translate}} {{searchText}}</p>\r
    <hr>\r
    </div>\r
  }\r
\r
  <div class="row searchBox px-4">\r
    @for (item of queries; track item) {\r
      <div class="col-12 searchBox--item">\r
        <a routerLink="{{item.url}}">\r
          <h3 class="searchBox--header">{{item.title + '.SearchTitle' | translate}}</h3>\r
          <p class="searchBox--link">https://assessor.lacounty.gov{{item.url}}</p>\r
          <p class="searchBox--text">{{item.title + '.SearchDescription' | translate}}</p>\r
        </a>\r
        <hr>\r
        </div>\r
      }\r
\r
    </div>\r
