        <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'NavMenu.PropSearchTool'|translate}}" routerLink="property-search">{{'NavMenu.PropSearchTool'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'DataSales.SearchTitle'|translate}}"   routerLink="data-sales">{{'DataSales.SearchTitle'|translate}}</a>\r
      </li>\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'NavMenu.DisasterRelief'|translate}}" routerLink="disaster-relief">{{'NavMenu.DisasterRelief'|translate}}</a>\r
      </li>\r
      <!-- <li>\r
      <a routerLinkActive="active-tab" (click)="status=!status" routerLink="supplemental-tax-estimator">{{'NavMenu.SupplementalEstimator'|translate}}</a>\r
    </li> -->\r
    <li>\r
      <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'NavMenu.ChangeMailingAdd'|translate}}" routerLink="change-of-mailing-address">{{'NavMenu.ChangeMailingAdd'|translate}}</a>\r
    </li>\r
    <li>\r
