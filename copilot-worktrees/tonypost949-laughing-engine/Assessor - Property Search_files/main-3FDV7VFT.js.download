// src/app/site-map/RouteLinkExtractor.ts
function extractRouteLinks(routes2, parentPath = "") {
  const links = [];
  for (const route of routes2) {
    let rawPath;
    if (route.redirectTo) {
      rawPath = route.redirectTo.toString().startsWith("/") ? route.redirectTo.toString().slice(1) : route.redirectTo.toString();
    } else {
      rawPath = route.path ?? "";
    }
    if (rawPath === "**" || rawPath === "") {
      continue;
    }
    const normalised = rawPath.split("/").map((seg) => seg.startsWith(":") ? `{${seg.slice(1)}}` : seg).join("/");
    const fullPath = parentPath ? `${parentPath}/${normalised}` : `/${normalised}`;
    if (!links.includes(fullPath)) {
      links.push(fullPath);
    }
    if (!route.redirectTo && route.children?.length) {
      const childLinks = extractRouteLinks(route.children, fullPath);
      for (const cl of childLinks) {
        if (!links.includes(cl)) {
          links.push(cl);
        }
      }
    }
  }
  return links;
}

