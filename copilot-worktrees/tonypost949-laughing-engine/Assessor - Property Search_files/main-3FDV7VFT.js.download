sel__link[_ngcontent-%COMP%] {\n  font-size: 1.7em;\n  text-transform: uppercase;\n  color: #E4B100;\n}\n.programs[_ngcontent-%COMP%]   .card[_ngcontent-%COMP%] {\n  position: relative;\n  border-radius: 0;\n  color: #000;\n  background-color: rgb(70, 70, 70);\n  margin: 10px 0;\n  width: 100%;\n  height: 140px;\n  background-size: cover;\n}\n.programs[_ngcontent-%COMP%]   .card[_ngcontent-%COMP%]   .card-title[_ngcontent-%COMP%] {\n  color: #fff;\n  text-transform: uppercase;\n}\n.programs[_ngcontent-%COMP%]   .card[_ngcontent-%COMP%]   .card-title[_ngcontent-%COMP%]:after {\n  content: "";\n  display: block;\n  margin: 0 auto;\n  width: 3em;\n  padding-top: 10px;\n  border-bottom: 2px solid #E4B100;\n  position: absolute;\n  left: 12;\n}\n.programs[_ngcontent-%COMP%]   .card[_ngcontent-%COMP%]   img[_ngcontent-%COMP%] {\n  position: absolute;\n  z-index: 0;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: auto;\n}\n.programs[_ngcontent-%COMP%]   a[_ngcontent-%COMP%] {\n  text-decoration: none;\n}\n@media only screen and (max-width: 1700px) {\n  .carousel-caption[_ngcontent-%COMP%]   .carousel__title[_ngcontent-%COMP%] {\n    font-size: 1.2rem;\n  }\n  .carousel-caption[_ngcontent-%COMP%]   .carousel__description[_ngcontent-%COMP%] {\n    font-size: 1rem;\n  }\n  .carousel-caption[_ngcontent-%COMP%]   .carousel__link[_ngcontent-%COMP%] {\n    font-size: 1em;\n  }\n}\n@media only screen and (max-width: 600px) {\n  [_nghost-%COMP%]     .item img {\n    height: 100%;\n    width: auto;\n  }\n  .carousel-caption[_ngcontent-%COMP%] {\n    font-size: 10px;\n    right: 0;\n    left: 0;\n    clip-path: polygon(100% 0, 100% 75%, 75% 100%, 0 100%, 0 0);\n    letter-spacing: 0.01rem;\n  }\n  .carousel-caption[_ngcontent-%COMP%]   .carousel__title[_ngcontent-%COMP%] {\n    font-size: 1.1rem;\n    margin-bottom: 1em;\n    text-transform: uppercase;\n    font-weight: 700;\n    letter-spacing: 0.01rem;\n  }\n  .carousel-caption[_ngcontent-%COMP%]   .carousel__description[_ngcontent-%COMP%] {\n    margin-bottom: 1em;\n    font-size: 0.8rem;\n  }\n  .carousel-caption[_ngcontent-%COMP%]   .carousel__link[_ngcontent-%COMP%] {\n    font-size: 1rem;\n    text-transform: uppercase;\n    color: #E4B100;\n  }\n}\n.grow[_ngcontent-%COMP%] {\n  transition: all 0.2s ease-in-out;\n}\n.grow[_ngcontent-%COMP%]:hover {\n  transform: scale(1.1);\n}\n/*# sourceMappingURL=home.component-RM6G3QP6.css.map */'] });
