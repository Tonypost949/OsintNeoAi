\r
\r
            <strong>AB 3182 (2020)</strong><br>\r
            <ul>\r
              <li>{{'ADU.Provides1'|translate}}</li>\r
              <li>{{'ADU.Provides2'|translate}}</li>\r
            </ul>\r
\r
            <strong>AB 68, AB 881, and SB 13 (2019)</strong><br>\r
            <ul>\r
              <li>{{'ADU.Eliminates'|translate}}</li>\r
              <li>{{'ADU.Prohibits'|translate}}</li>\r
