(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(CertificateAddressComponent, [{
    type: Component,
    args: [{ selector: "app-certificate-address", imports: [
      FormsModule,
      ReactiveFormsModule,
      TranslatePipe
    ], template: `<div [formGroup]="parentFormGroup()">\r
  <div class="gy-4" style="display: flex; flex-direction: column; gap: 10px">\r
    <!-- Street Number & Direction, e.g.: 500 West -->\r
    <div class="row gx-2">\r
      <div class="col-8">\r
        <input [formControlName]="streetNumber()"\r
               class="form-control"\r
               type="number"\r
               placeholder="{{'ContactAssessor.AddNumber' | translate}}">\r
      </div>\r
      <div class="col-4">\r
        <select [formControlName]="streetDirection()"\r
                class="form-select">\r
          <option selected value="">{{ 'ContactAssessor.AddDirection' | translate }}..</option>\r
          <option>North</option>\r
          <option>West</option>\r
          <option>South</option>\r
          <option>East</option>\r
        </select>\r
      </div>\r
    </div>\r
    <!-- Street Name & Type, e.g. Temple St. -->\r
    <div class="row gx-2">\r
      <div class="col-6">\r
        <input [formControlName]="streetName()"\r
               class="form-control"\r
               type="text"\r
               placeholder="{{'ContactAssessor.AddStreet' | translate}}">\r
      </div>\r
      <!-- Unit Number -->\r
      <div class="col-2">\r
        <input [formControlName]="unitNumber()"\r
               class="form-control col-12 col-md-6"\r
               type="text"\r
               placeholder="{{'ContactAssessor.AddUnit' | translate}}">\r
      </div>\r
      <div class="col-4">\r
        <select [formControlName]="streetType()"\r
                class="form-select">\r
          <option selected value="">Type..</option>\r
          <option>Dr</option>\r
          <option>St</option>\r
          <option>Ave</option>\r
        </select>\r
      </div>\r
    </div>\r
    <!-- City & Zip -->\r
    <div class="row gx-2">\r
      <div class="col-6">\r
        <input [formControlName]="city()"\r
               type="text"\r
               class="form-control"\r
               placeholder="{{'ContactAssessor.AddCity' | translate}}">\r
      </div>\r
      <div class="col-6">\r
        <input [formControlName]="zipCode()"\r
               type="text"\r
               class="form-control"\r
               placeholder="{{'ContactAssessor.AddZip' | translate}}">\r
      </div>\r
    </div>\r
  </div>\r
