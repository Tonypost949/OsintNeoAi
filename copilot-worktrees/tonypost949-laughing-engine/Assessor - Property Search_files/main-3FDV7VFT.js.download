    </div>\r
    <div class="drag-and-drop-area" [class.highlight-border]="isDraggedOver" (dragover)="onDragOver($event)" (dragleave)="onDragLeave($event)" (drop)="onDrop($event)"\r
      style="display: flex; align-items: center; flex-direction: column; ">\r
      <h5 style="color: #666666;">{{ 'FileUploadComponent.DragAndDropFiles' | translate }}</h5>\r
