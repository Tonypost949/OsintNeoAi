  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(RealEstateToolkitComponent, [{
    type: Component,
    args: [{ selector: "app-RealEstateToolkit", standalone: false, template: `<div class="wrapper w-100">\r
  <!-- Sidebar -->\r
\r
  <nav id="sidebar" [ngClass]="status ? 'active' : ''">\r
    <div class="close-button" type="button" id="sidebarCollapse" (click)="status=!status">\r
      @if (status) {\r
        <span><i class="fas fa-angle-right"></i></span>\r
      }\r
\r
      @if (!status) {\r
        <span><i class="fas fa-angle-left"></i></span>\r
      }\r
    </div>\r
    <div class="sidebar-header">\r
      <h3>{{'NavMenu.RealEstateToolkit'|translate}}</h3>\r
    </div>\r
\r
    <ul class="list-unstyled components">\r
\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'Newsroom.SearchTitle'|translate}}" routerLink="newsroom">{{'Newsroom.SearchTitle'|translate}}</a>\r
      </li>\r
\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'Prop13.SearchTitle'|translate}}" routerLink="proposition-13">{{'Prop13.SearchTitle'|translate}}</a>\r
