        <li><p>{{'ADU.accessoryitem5'|translate}}</p></li>\r
        <li><p>{{'ADU.accessoryitem6'|translate}}</p></li>\r
      </ul>\r
      <h4>{{'ADU.junioradu'|translate}}</h4>\r
      <p>{{'ADU.junioradutext1v2'|translate}}<b> {{'ADU.lessthan500v2'|translate}}</b>{{'ADU.junioradutext2'|translate}}</p>\r
\r
      <h4>{{'ADU.requirementsv2'|translate}}</h4>\r
      <p><b>{{'ADU.note'|translate}} </b>{{'ADU.notetext'|translate}}</p>\r
\r
\r
\r
\r
\r
      <div class="row">\r
        <div class="col-md">\r
          <h5>{{'ADU.generalAduv2'|translate}}</h5>\r
\r
          <ul>\r
            <li>{{'ADU.generalAdu1v2'|translate}}</li>\r
            <li>{{'ADU.generalAdu2v2'|translate}}</li>\r
            <li>{{'ADU.generalAdu3'|translate}}</li>\r
            <li>{{'ADU.generalAdu4'|translate}}</li>\r
