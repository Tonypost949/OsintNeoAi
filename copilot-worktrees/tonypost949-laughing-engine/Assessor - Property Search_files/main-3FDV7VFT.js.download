    type: Component,
    args: [{ selector: "app-chatbot", standalone: false, template: `\r
@if (chatService.toggle) {\r
  <div  class="toggler text-center" [ngClass]="{'increase': chatService.toggle, 'decrease': !chatService.toggle}">\r
    <div class="chat-menu container-fluid" [ngClass]="{'fadeOut': !chatService.toggle, 'fadeIn': chatService.toggle, 'block': !toggleDisplay}">\r
      <div class="top text-center" style="display: flex; justify-content: space-between;">\r
        <h4 style="margin-left: 33% ;">Assessor Chatbot</h4>\r
        <div (click)='chatService.openChatBot(); toggleDisplay = false;  ' class="exit float-end">\r
          <i class="fas fa-times"></i>\r
        </div>\r
      </div>\r
      <div id="chat" class="chat">\r
        <div id="chatBoxWrapper" class="chat__wrapper">\r
          <!-- <div (click)="addMessageManual('Proposition 19')" class="chat__message curser  clearfix" [ngClass]="{'chat__message-own': true}">\r
          <div class="inner-text">{{'ChatBot.Prop19' | translate}}</div>\r
        </div>\r
        <div (click)="addMessageManual('Homeowners Exemptions')" class="chat__message curser  clearfix" [ngClass]="{'chat__message-own': true}">\r
          <div class="inner-text">{{'ChatBot.Homeowners' | translate}}</div>\r
        </div>\r
        <div (click)="addMessageManual('New Construction')" class="chat__message curser  clearfix" [ngClass]="{'chat__message-own': true}">\r
          <div class="inner-text">{{'ChatBot.Construction' | translate}}</div>\r
        </div> -->\r
        @for (item of messages; track item) {\r
          <div class="chat__message clearfix" [ngClass]="{'chat__message-own': !item.isUser}">\r
            @if (item.isUser) {\r
              <img src="../../../assets/imgs/seal.png" alt="Avatar">\r
            }\r
            <div class="inner-text" id="{{item.id}}" [innerHTML]="item.message"></div>\r
          </div>\r
        }\r
        @if (toggleSpinner) {\r
          <div style="width: 100%" class="chat__message  clear-fix">\r
            <img src="../../../assets/imgs/seal.png" alt="Avatar" class="">\r
            <div style="width: 100%; position: relative; height: 100px" class="inner-text">\r
              <ngx-spinner [fullScreen]="false" color="#fff" bdColor="#e6e7ec"\r
                type="ball-spin-fade-rotating" size="medium">\r
              </ngx-spinner>\r
            </div>\r
          </div>\r
        }\r
      </div>\r
    </div>\r
    <div class="chat__form">\r
      <form autocomplete="off" #chatForm="ngForm" (ngSubmit)="addMessage(chatForm); chatForm.resetForm()" id="chat__form">\r
        <input autocomplete="off" id="text-message" [(ngModel)]="setMessage" name="msg" type="text" placeholder="Type your message here ...">\r
        <button type="submit">Send</button>\r
      </form>\r
    </div>\r
    <div id="result"></div>\r
  </div>\r
</div>\r
}\r
