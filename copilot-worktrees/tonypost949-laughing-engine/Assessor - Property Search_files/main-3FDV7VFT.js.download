(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(ContactSpeakerComponent, [{
    type: Component,
    args: [{ selector: "app-contactSpeaker", standalone: false, template: `<div class="container my-3 p-3 contactContent General" id="">\r
  <h3 class="page-title">{{'ContactSpeaker.PageTitle' | translate}}</h3>\r
  <p [innerHTML]= "'ContactSpeaker.PageDescription2' | translate"></p>\r
  <p [innerHTML]="'ContactSpeaker.Assistance' | translate"></p>\r
  <br>\r
    <h5>{{'ContactSpeaker.ContactInformation' | translate}}</h5>\r
    <hr>\r
      <form [formGroup]="contactForm" (ngSubmit)="submit()">\r
        <p class="form-label">{{'ContactAssessor.Name'|translate}}<span class="color-red">*</span></p>\r
        <div class="form-row" style="display: flex; gap: 10px; margin-bottom: 20px;">\r
          <div class="form-group" style="flex: 1;">\r
            <input type="text" formControlName="firstName" class="form-control" id="inputFirst-Speaker" placeholder="First">\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('firstName', 'required')) {\r
                {{'ContactAssessor.Required'|translate}}\r
              }\r
            </div>\r
          </div>\r
          <div class="form-group" style="flex: 1;">\r
            <input type="text" formControlName="lastName" class="form-control" id="inputLast-Speaker" placeholder="Last">\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('lastName', 'required')) {\r
                {{ 'ContactAssessor.Required' | translate}}\r
              }\r
            </div>\r
          </div>\r
        </div>\r
\r
        <div class="form-group" style="margin-bottom: 20px;">\r
          <p class="form-label">{{ 'ContactAssessor.Email' | translate}} <span class="color-red">*</span></p>\r
          <input type="email" class="form-control" formControlName="email" placeholder="Email">\r
          <div class="invalid-feedback" style="display: block">\r
            @if (hasError('email', 'required')) {\r
              {{ 'ContactAssessor.Required' | translate}}\r
            }\r
          </div>\r
        </div>\r
        <p class="form-label">{{ 'ContactAssessor.Phone' | translate}}  <span class="color-red">*</span></p>\r
        <div class="form-row" style="margin-bottom: 20px;">\r
          <div class="form-group col-12">\r
            <input class="form-control"  type="text" appPhoneMask  formControlName="phone" placeholder="(XXX) XXX-XXXX" id="inputPhone-Speaker"  >\r
            <div class="invalid-feedback" style="display: block">\r
              @if (hasError('phone', 'required')) {\r
                {{ 'ContactAssessor.Required' | translate}}\r
              }\r
            </div>\r
          </div>\r
        </div>\r
\r
        <div class="form-row" style="display: flex; gap: 10px; margin-bottom: 20px;">\r
          <div class="form-group" style="flex: 1;">\r
            <label class="form-label">{{ 'ContactSpeaker.Organization' | translate}}</label>\r
            <input type="text" formControlName="organization" class="form-control" id="" >\r
\r
          </div>\r
          <div style="flex: 1;">\r
            <label class="form-label">{{ 'ContactSpeaker.Title' | translate}}</label>\r
            <input type="text" formControlName="title" class="form-control" id="" >\r
\r
          </div>\r
\r
        </div>\r
        <p class="form-label">{{'ContactAssessor.Address'| translate}}</p>\r
        <app-certificate-address\r
          [parentFormGroup]="contactForm"\r
          streetNumber="number"\r
          streetDirection="direction"\r
          streetName="street"\r
          streetType="type"\r
          unitNumber="unit"\r
          city="city"\r
          zipCode="zipCode"\r
\r
          >\r
        </app-certificate-address>\r
\r
        <br>\r
          <h5>{{'ContactSpeaker.Event' | translate}}</h5>\r
          <hr>\r
            <div class="form-row date-from" style="display: flex; gap: 10px; margin-bottom: 20px;">\r
              <div class="form-group" style="flex: 1;">\r
                <label class="form-label date">{{ 'ContactSpeaker.Date' | translate}}</label>\r
                <input type="text" formControlName="date" placeholder="Select A Date" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
              </div>\r
              <div class="col-sm-6 col-md-3 form-group">\r
                <label  class="form-label date">{{ 'ContactSpeaker.Day' | translate}}</label>\r
                <select formControlName="day" class="form-select" placeholder="Select Day">\r
                  <option selected value="">Type..</option>\r
                  <option>Monday</option>\r
                  <option>Tuesday</option>\r
                  <option>Wednesday</option>\xDF\r
                  <option>Thursday</option>\r
                  <option>Friday</option>\r
                </select>\r
              </div>\r
              <div class="col-sm-6 col-md-3 form-group time">\r
                <label  class="form-label ">{{ 'ContactSpeaker.Time' | translate}}</label>\r
                <timepicker id="timepicker" [showSpinners]="false" formControlName="time"></timepicker>\r
              </div>\r
            </div>\r
            <p class="form-label">{{'ContactSpeaker.Location'| translate}}</p>\r
            <app-certificate-address\r
              [parentFormGroup]="contactForm"\r
              streetNumber="locationNumber"\r
              streetDirection="locationDirection"\r
              streetName="locationStreet"\r
              streetType="locationType"\r
              unitNumber="locationUnit"\r
              city="locationCity"\r
              zipCode="locationZipCode"\r
\r
              >\r
            </app-certificate-address>\r
\r
            <div class="form-group" style="margin-bottom: 20px; margin-top: 20px;">\r
              <p class="form-label">{{ 'ContactSpeaker.CrossStreet' | translate}}</p>\r
              <input type="text" class="form-control" formControlName="crossStreet" placeholder="">\r
            </div>\r
            <div class="form-group" style="margin-bottom: 20px;">\r
              <p class="form-label">{{ 'ContactSpeaker.Purpose' | translate}}</p>\r
              <input type="text" class="form-control" formControlName="purpose" placeholder="">\r
            </div>\r
            <div class="form-group" style="margin-bottom: 20px;">\r
              <p class="form-label">{{ 'ContactSpeaker.Topic' | translate}}</p>\r
              <input formControlName="topic" type="text" class="form-control">\r
            </div>\r
            <div class="form-row">\r
\r
              <div  class="form-row align-items-center" style="display: flex; gap: 10px; margin-bottom: 20px;">\r
                <div class="form-group" style="flex: 1;">\r
                  <label class="form-label">{{ 'ContactSpeaker.NumberAttendees' | translate}}</label>\r
                  <input type="text" formControlName="attendees" class="form-control" id="" >\r
\r
                </div>\r
                <div class="col-md-4">\r
                  <label class="form-label">{{ 'ContactSpeaker.SpeechTime' | translate}}</label>\r
                  <input type="text" formControlName="speech" class="form-control" id="" >\r
\r
                </div>\r
                <div class="col-md-4">\r
                  <label class="form-label">{{ 'ContactSpeaker.Materials' | translate}}</label>\r
                  <input type="text" formControlName="materials" class="form-control" id="" >\r
                </div>\r
              </div>\r
            </div>\r
\r
            <p class="form-label">\r
              {{'ContactSpeaker.CertificateRadio' | translate}} <span class="color-red">*</span>\r
            </p>\r
            <div class="form-group d-flex align-items-center gap-3">\r
              <div class="form-check">\r
                <input class="form-check-input" formControlName="certificateRadio" value="Yes" name="certificateRadio" type="radio" id="radioYes">\r
                <label class="form-check-label" for="radioYes">Yes</label>\r
              </div>\r
\r
              <div class="form-check">\r
                <input class="form-check-input" formControlName="certificateRadio" value="No" name="certificateRadio" type="radio" id="radioNo">\r
                <label class="form-check-label" for="radioNo">No</label>\r
              </div>\r
            </div>\r
\r
\r
            <br>\r
              <h5>{{'ContactSpeaker.EventFormat' | translate}}</h5>\r
              <hr>\r
\r
                <div class="form-row" style="display: flex; gap: 10px; margin-bottom: 20px;">\r
\r
                  <div class="form-group"  style="flex: 1;">\r
                    <label class="form-label">{{ 'ContactSpeaker.Introduction' | translate}}</label>\r
                    <input type="text" formControlName="introductionBy" class="form-control" id="" >\r
                  </div>\r
                  <div class="form-group col-md-4">\r
                    <label class="form-label">{{ 'ContactSpeaker.GuestSpeakers' | translate}}</label>\r
                    <input type="text" formControlName="speakers" class="form-control" id="" >\r
                  </div>\r
                  <div class="form-group col-md-4">\r
                    <label class="form-label">{{ 'ContactSpeaker.Attire' | translate}}</label>\r
                    <input type="text" formControlName="attire" class="form-control" id="" >\r
                  </div>\r
\r
                </div>\r
                <div class="form-row" style="display: flex; gap: 10px; margin-bottom: 20px;">\r
                  <div class="form-group" style="flex: 1;">\r
                    <label class="form-label">{{ 'ContactSpeaker.DateContacted' | translate}}</label>\r
                    <input type="text" formControlName="dateContacted" placeholder="Select A Date" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
                  </div>\r
                  <div class="form-group col-md-6">\r
                    <label class="form-label">{{ 'ContactSpeaker.DateConfirmed' | translate}}</label>\r
                    <input type="text" formControlName="dateConfirmed" placeholder="Select A Date" class="form-control" bsDatepicker [bsConfig]="bsConfig">\r
                  </div>\r
                </div>\r
                <label class="form-label">{{ 'ContactSpeaker.Comments' | translate}}</label>\r
                <div class="form-group">\r
\r
                  <textarea class="form-control" formArrayName="description" id="" rows="5"></textarea>\r
                </div>\r
                <div class="form-group" style="margin-top: 15px;">\r
                  <app-captcha [form]="contactForm" captchaFieldName="recaptchaReactive"></app-captcha>\r
                  <div class="invalid-feedback" style="display: block">\r
                    @if (hasError('recaptchaReactive', 'required')) {\r
                      {{ 'ContactAssessor.Required' | translate}}\r
                    }\r
                  </div>\r
                </div>\r
                <button type="submit" class="btn btn-primary mr-4" style="margin-top: 10px;">Submit</button>@if (success) {\r
                <span>Successfully Submitted</span>\r
              }\r
            </form>\r
          </div>\r
