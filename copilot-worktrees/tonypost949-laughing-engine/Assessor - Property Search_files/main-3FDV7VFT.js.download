\r
  <div heading="Notices" class="Notices">\r
    <h3 style="line-height: 130%;">{{'DisasterRelief.Notices'|translate}}</h3>\r
    <p [innerHTML]="'DisasterRelief.TheOffice'|translate"></p>\r
    <div class="accordion">\r
      <accordion [isAnimated]="true" >\r
        <accordion-group #drop [isOpen]="true">\r
          <div accordion-heading >\r
            <span class="dropdown-item clearfix">\r
              {{'DisasterRelief.Examples'|translate}} <i class="mt-1 float-end" [ngClass]="!drop.isOpen ? 'fas fa-plus' : 'fas fa-minus'"></i>\r
