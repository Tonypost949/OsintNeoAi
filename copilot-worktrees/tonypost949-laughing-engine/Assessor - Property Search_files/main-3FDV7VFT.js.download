var DisasterRelief = {
  SearchTitle: "Disaster Relief",
  SearchDescription: "You may be eligible for tax relief if your property is damaged or destroyed by a calamity, such as fire or flooding.",
  PageTitle: "Disaster Relief",
  Misfortune: "Misfortune and Calamity Tax Relief",
  youmayv4: 'You may be eligible for tax relief if your property is damaged or destroyed by a calamity, such as fire or flooding. To qualify, you must file an Application for Reassessment: Property Damaged or Destroyed by Misfortune or Calamity (M&C) Form <a href="https://assessor.lacounty.gov/contact/assessor/4" target="_blank"><strong>ADS-820</strong></a> with the Assessor\u2019s Office within 12 months from the date the property was damaged or destroyed. The loss must exceed $10,000 of current market value. <a href="https://res.cloudinary.com/los-angeles-county-assessor/image/upload/v1736540235/Factsheet/Relief_for_Properties_Impacted_By_A_Disaster.pdf" target="_blank">Relief for Properties Impacted By A Disaster</a>',
  ForQuestions: 'For questions or to submit an M&C claim, please email <a href="mailto:relief@assessor.lacounty.gov">relief@assessor.lacounty.gov</a> or call <strong>(213) 974-8658</strong>.',
  Prop19: "Proposition 19 Disaster Relief Transfer of Base Value ",
  inaddition: "In addition, if your property was substantially damaged or destroyed by a Governor-declared disaster, Prop.19 provides for your property's tax base to be transferred to a comparable property within the same county or another county in California. Please visit our ",
  Prop19link: "Prop. 19",
  page: "page",
  formorev2: 'For more information or additional help, please use our <a href="/contact/assessor/5">Contact Form</a>.',
  foradditional: "For additional resources you may also visit the ",
  boelink: "Board of Equalization\u2019s Disaster Relief",
  website: " website.",
  application: "Application for Reassessmnet: Property Damaged or Destroyed by Misforturne or Calamity",
  prop50button: "Claim for Intracounty Transfer of Tax Base (Prop. 50) Form",
  prop171button: "Claim for Intercounty Transfer of Tax Base (Prop. 171) Form",
  IfyouhavereceivedHeader: "If You Have Received a Mailed Notice of Assessed Value Change from the Assessor",
  IfyouhavereceivedText: "If you have recently received a <strong>Notice of Assessed Value Change</strong> from the Assessor, please click on the <strong>\u201CNOTICES TO PROPERTY OWNERS\u201D</strong> tab above for an explanation of your mailed notice.",
  Notices: "DISASTER RELIEF: NOTICES OF ASSESSED VALUE CHANGE FROM THE ASSESSOR",
  TheOffice: "The Assessor's Office has begun enrolling assessed value reductions to reflect fire damage to improvements and land that occurred as a result of the Palisades and Eaton fires.<br><br>These Misfortune or Calamity enrollments will automatically generate mailed <strong>Notices of Assessed Value Change</strong> for wildfire affected property owners. Each impacted property may receive multiple notices, depending on the complexity of the assessment.",
  Examples: "Examples of Notices and Explanation",
  NoticeofAssessed: "Notice of Assessed Value Change and Explanation",
  Duetothedetailed: "Due to the detailed and technical nature of the assessment process, we anticipate that some property owners may require additional clarification about their assessments. For questions or concerns you may have, please contact your Assessor district office below.",
  Pleasenote: "<strong>Please note:</strong><ul><li>The initial relief is prorated for the second half of the current fiscal year.</li><li>Full disaster relief will be reflected in the next fiscal year's assessment.</li><li>Some enrollments will also generate adjusted tax bills and, in some cases, refunds downstream.</li></ul>",
  Tosupport: "To support transparency and improve constituent\u2019s access to information, major improvements to our website are underway. Soon, property owners will be able to check the status of their disaster relief claim through the Assessor\u2019s Property Search tool. We will communicate when these updates go live and provide any necessary instructions to help our constituents utilize these online tools.",
  ClickonVideos: 'Click on the <strong>"VIDEOS"</strong> tab to view a presentation explaining the value reductions in your notice.'
};
