var LanguageAccess = {
  SearchTitle: "Language Access Services",
  SearchDescription: "The Los Angeles County Assessor\u2019s Office is committed to providing fair, equitable, and accessible service to all members of the public\u2014regardless of the language they speak or their communication needs.",
  TheLosAngeles: "The Los Angeles County Assessor\u2019s Office is committed to providing fair, equitable, and accessible service to all members of the public\u2014regardless of the language they speak or their communication needs.",
  DLAP: "Departmental Language Access Plan (DLAP)",
  DLAPText: '<p>In alignment with the County\u2019s efforts to promote language equity, the Assessor\u2019s Office has developed a comprehensive Departmental Language Access Plan (DLAP) to ensure that individuals who speak Languages Other Than English (LOTE) or who have other communication challenges receive meaningful access to our services.</p> <p>The Department currently offers translated materials and services in multiple languages including Spanish, Chinese (Traditional and Simplified), Tagalog, Korean, Armenian, Farsi, Hindi, Japanese, Khmer, Thai, Burmese, Gujarati, Indonesian, Telugu, German, and Vietnamese.</p><p>For more information or to request language assistance, email us at <a href="mailto:DLAP@assessor.lacounty.gov" target="_blank">DLAP@assessor.lacounty.gov</a>.</p>',
  LanguageAccessComplaintForm: "Language Access Complaint Form",
  Wearecommitted: 'We are committed to continually improving our language access services. If you believe that you were not provided appropriate language assistance, such as interpretation or translation, you may file a complaint using our <strong><a href="https://forms.office.com/g/tTf1yiXmbj" target="_blank">Language Access Complaint Form.</a></strong>',
  Oncesubmitted: "Once submitted, our office will review your complaint and follow up within 10 business days.",
