  <!-- Sidebar -->\r
\r
  <nav id="sidebar" [ngClass]="status ? 'active' : ''">\r
    <div class="close-button" type="button" id="sidebarCollapse" (click)="status=!status">\r
      @if (status) {\r
        <span><i class="fas fa-angle-right"></i></span>\r
      }\r
\r
      @if (!status) {\r
        <span><i class="fas fa-angle-left"></i></span>\r
      }\r
    </div>\r
    <div class="sidebar-header">\r
      <h3>{{'NavMenu.Aboutus'|translate}}</h3>\r
    </div>\r
\r
    <ul class="list-unstyled components">\r
\r
      <li>\r
        <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'NavMenu.Meetthe'|translate}}" routerLink="meet-the-assessor">{{'NavMenu.Meetthe'|translate}}</a>\r
      </li>\r
      <!--<li>\r
      <a routerLinkActive="active-tab" (click)="status=!status" routerLink="disabled-veterans">{{'NavMenu.AssessorOffice'|translate}}</a>\r
    </li>-->\r
    <li>\r
      <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'NavMenu.MeettheStaff'|translate}}" routerLink="meet-the-staff">{{'NavMenu.MeettheStaff'|translate}}</a>\r
    </li>\r
    <li>\r
      <a routerLinkActive="active-tab" (click)="status=!status" aria-label="{{'NavMenu.Proptax'|translate}}" routerLink="property-tax-system">{{'NavMenu.Proptax'|translate}}</a>\r
    </li>\r
\r
\r
\r
\r
  </ul>\r
\r
</nav>\r
<div id="content">\r
\r
  <!-- <button type="button" id="sidebarCollapse" (click)="status=!status" class="btn btn-info">\r
