          <p [innerHTML]="'DisasterRelief.ClickonVideos'|translate"></p>\r
        </accordion-group>\r
      </accordion>\r
    </div>\r
\r
    <p>{{'DisasterRelief.Duetothedetailed'|translate}}</p>\r
\r
    <p>\r
      <strong>West District Office (Palisades Fire)</strong><br>\r
      6167 Bristol Parkway, Suite 100<br>\r
      Culver City, CA 90230<br>\r
      <strong>(310) 665-5300</strong><br>\r
    </p>\r
    <p>\r
      <strong>East District Office (Eaton Fire)</strong><br>\r
      1190 Durfee Avenue<br>\r
      South El Monte, CA 91733<br>\r
      <strong>(626) 258-6001</strong><br>\r
    </p>\r
\r
    <p [innerHTML]="'DisasterRelief.Pleasenote'|translate"></p>\r
    <p>{{'DisasterRelief.Tosupport'|translate}}</p>\r
\r
\r
  </div>\r
\r
