            <div class="view-toggle-group">
                <button class="toggle-btn active" id="btnVsde" onclick="switchView('vsde')"><i class="fa-solid fa-gift"></i> VSDE Benefits Matrix</button>
                <button class="toggle-btn" id="btnForensic" onclick="switchView('forensic')"><i class="fa-solid fa-scale-balanced"></i> Anaheim / Stadium Matrix</button>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-label">Enterprise License</span>
                <span class="stat-val" style="color: var(--emerald);">$9,995 / yr</span>
                <span style="font-size:0.75rem; color:#94a3b8;">Order W753756 • 0-Watermark Active</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Indexed Entities</span>
                <span class="stat-val" style="color: var(--accent);">17,488 Nodes</span>
                <span style="font-size:0.75rem; color:#94a3b8;">Cross-domain BigQuery & GraphDB</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Azure Student Benefit</span>
                <span class="stat-val" style="color: var(--purple);">$100 / mo</span>
                <span style="font-size:0.75rem; color:#94a3b8;">Live App: osintneoai-app-949</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Total Forensic Exposure</span>
                <span class="stat-val" style="color: var(--rose);">$320,000,000</span>
                <span style="font-size:0.75rem; color:#94a3b8;">Anaheim Stadium & HCD SLA Audit</span>
            </div>
        </div>

        <div class="panel-container">
            <div class="panel-header">
                <div class="panel-title">
                    <i class="fa-solid fa-table-cells" style="color: var(--accent);"></i>
                    <span id="gridTitle">VSDE “Steroids” Benefits & Software Matrix</span>
                </div>
                <div style="font-size:0.8rem; color:#94a3b8;">
                    <i class="fa-solid fa-filter"></i> Search & Filter enabled across all columns
                </div>
            </div>
            <div id="MainGrid"></div>
        </div>

        <div class="charts-row">
            <div class="panel-container">
                <div class="panel-title">
                    <i class="fa-solid fa-chart-column" style="color: var(--accent);"></i>
                    Exposure & Recovery Ceiling ($M USD)
                </div>
                <div id="ValuationChart" style="height: 320px;"></div>
            </div>
            <div class="panel-container">
                <div class="panel-title">
                    <i class="fa-solid fa-chart-line" style="color: var(--emerald);"></i>
                    Forensic Velocity Timeline
                </div>
                <div id="TimelineChart" style="height: 320px;"></div>
            </div>
        </div>
    </main>

