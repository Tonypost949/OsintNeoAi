        function initSyncfusionApp() {
            try {
                gridInstance = new ej.grids.Grid({
                    dataSource: vsdeData,
                    allowPaging: true,
                    pageSettings: { pageSize: 10, pageSizes: [5, 10, 20, 50] },
                    allowSorting: true,
                    allowFiltering: true,
                    filterSettings: { type: 'Menu' },
                    allowGrouping: true,
                    allowResizing: true,
                    allowPdfExport: true,
                    allowExcelExport: true,
                    toolbar: ['Search', 'ExcelExport', 'PdfExport', 'Print'],
                    columns: getVsdeColumns()
                });
                gridInstance.appendTo('#MainGrid');

                // Charts
                initCharts();
            } catch (err) {
                console.error("Syncfusion Grid Init Error:", err);
            }
        }

        function getVsdeColumns() {
            return [
                { field: 'benefit_name', headerText: 'Benefit / Asset Name', width: 220, textAlign: 'Left' },
                { field: 'category', headerText: 'Category', width: 160, textAlign: 'Left' },
                { field: 'value_usd', headerText: 'Market Value', width: 140, textAlign: 'Right' },
                { 
                    field: 'status', 
                    headerText: 'Status', 
                    width: 160, 
                    textAlign: 'Center',
                    template: function(data) {
                        const cls = data.status.includes('CLAIMED') ? 'status-claimed' : (data.status.includes('VERIFIED') ? 'status-verified' : 'status-violation');
                        return `<span class="status-badge ${cls}"><i class="fa-solid fa-check"></i> ${data.status}</span>`;
                    }
                },
                { field: 'license_key', headerText: 'Key / Subscription Reference', width: 240, textAlign: 'Left' },
                { field: 'description', headerText: 'Included Capabilities & Impact', width: 340, textAlign: 'Left' }
            ];
        }

        function getForensicColumns() {
            return [
                { field: 'fact_id', headerText: 'Fact ID', width: 100, textAlign: 'Center' },
                { field: 'statutory_target', headerText: 'Target Matter', width: 220, textAlign: 'Left' },
                { field: 'verified_exposure', headerText: 'Exposure ($)', width: 140, textAlign: 'Right' },
                { 
                    field: 'verification_badge', 
                    headerText: 'Verification Status', 
                    width: 190, 
                    textAlign: 'Center',
                    template: function(data) {
                        let cls = 'status-verified';
                        if (data.verification_level === 'CRIMINAL_GUILTY_PLEA') cls = 'status-plea';
                        else if (data.verification_level.includes('EXPOSURE')) cls = 'status-violation';
                        return `<span class="status-badge ${cls}">${data.verification_badge}</span>`;
                    }
                },
                { field: 'statutory_hook', headerText: 'Governing Statute', width: 220, textAlign: 'Left' },
                { field: 'audit_finding', headerText: 'Audited Forensic Finding', width: 320, textAlign: 'Left' }
            ];
        }

        function switchView(view) {
            currentMode = view;
            const btnVsde = document.getElementById('btnVsde');
            const btnForensic = document.getElementById('btnForensic');
            const gridTitle = document.getElementById('gridTitle');

            if (view === 'vsde') {
                btnVsde.classList.add('active');
                btnForensic.classList.remove('active');
                gridTitle.innerText = 'VSDE “Steroids” Benefits & Software Matrix';
                gridInstance.columns = getVsdeColumns();
                gridInstance.dataSource = vsdeData;
            } else {
                btnForensic.classList.add('active');
                btnVsde.classList.remove('active');
                gridTitle.innerText = 'Anaheim / Stadium Forensic Ledger & Fraud Matrix';
                gridInstance.columns = getForensicColumns();
                gridInstance.dataSource = forensicData;
            }
            gridInstance.refresh();
        }

        function initCharts() {
            new ej.charts.Chart({
                primaryXAxis: { valueType: 'Category', majorGridLines: { width: 0 } },
                primaryYAxis: { title: '$ Millions USD', lineStyle: { width: 0 } },
                series: [{
                    type: 'Column',
                    dataSource: [
                        { pillar: 'Stadium Land Deal', val: 320, color: '#f43f5e' },
                        { pillar: 'Phantom Credits', val: 170, color: '#fb7185' },
                        { pillar: 'Cash Discounted', val: 150, color: '#f59e0b' },
                        { pillar: 'HCD SLA Penalty', val: 96, color: '#e11d48' },
                        { pillar: 'Qui Tam Relator Bounty', val: 96, color: '#38bdf8' },
                        { pillar: 'Total Recovery Ceiling', val: 196.3, color: '#10b981' }
                    ],
                    xName: 'pillar', yName: 'val',
                    fill: '#38bdf8',
                    cornerRadius: { topLeft: 6, topRight: 6 },
                    pointColorMapping: 'color'
                }],
                tooltip: { enable: true },
                legendSettings: { visible: false }
            }).appendTo('#ValuationChart');

            new ej.charts.Chart({
                primaryXAxis: { valueType: 'Category', majorGridLines: { width: 0 } },
                primaryYAxis: { title: 'Impact Velocity (1-100)', minimum: 0, maximum: 100 },
                series: [{
                    type: 'SplineArea',
                    dataSource: [
                        { step: 'May 16 (FBI Pause)', score: 40 },
                        { step: 'May 20 (Grand Jury)', score: 65 },
                        { step: 'May 23 (Sidhu Resigns)', score: 80 },
                        { step: 'May 23 10:16 PM (Whistleblower)', score: 98 },
                        { step: 'May 24 (7-0 Unanimous Kill)', score: 100 }
                    ],
                    xName: 'step', yName: 'score',
                    fill: 'rgba(16, 185, 129, 0.25)',
                    border: { width: 3, color: '#10b981' },
                    marker: { visible: true, width: 8, height: 8, fill: '#10b981' }
                }],
                tooltip: { enable: true },
                legendSettings: { visible: false }
            }).appendTo('#TimelineChart');
        }

        function exportGridPDF() {
            if (gridInstance) {
                gridInstance.pdfExport({
                    fileName: "OSINTNeoAi_Syncfusion_Matrix.pdf",
                    pageOrientation: 'Landscape'
                });
            }
        }

        function exportGridExcel() {
            if (gridInstance) {
                gridInstance.excelExport({
                    fileName: "OSINTNeoAi_Syncfusion_Matrix.xlsx"
                });
            }
        }

        document.addEventListener('DOMContentLoaded', initSyncfusionApp);
    </script>
</body>
</html>
